<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <!--If you are willing to use platform-specific APIs, use conditional compilation.
        See https://docs.avaloniaui.net/docs/guides/platforms/platform-specific-code/dotnet for more details.-->
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
        <LangVersion>latest</LangVersion>
        <!-- A publish for a runtime downloads no ASP.NET Core or Windows Desktop runtime pack, which the SDK fetches in
             case a reference needs them; the app uses neither framework. -->
        <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
        <!-- A publish for a runtime ships precompiled code: the Gallery starts in about half the time, since it JIT
             compiles little at startup. Its fonts need the stand-ins of SafeEmbeddedFontCollection: WithSafeInterFont in
             Program and WithNotoFonts (NotoFontProvider). -->
        <PublishReadyToRun Condition="'$(RuntimeIdentifier)' != ''">true</PublishReadyToRun>
    </PropertyGroup>

    <PropertyGroup>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>..\Flowery.NET.Gallery\Assets\app_icon.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Flowery.NET.Gallery\Flowery.NET.Gallery.csproj"/>
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    </ItemGroup>
</Project>
