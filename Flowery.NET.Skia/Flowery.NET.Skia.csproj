<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <PackageId>Flowery.NET.Skia</PackageId>
    <Authors>tobitege</Authors>
    <Description>SkiaSharp effects for Flowery.NET: live backdrop blur with liquid-glass optics and animated shader backgrounds for the DaisyGlass controls.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tobitege/Flowery.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tobitege/Flowery.NET</RepositoryUrl>
    <PackageTags>avalonia;flowery;daisyui;glass;skia;shader</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flowery.NET\Flowery.NET.csproj" />
  </ItemGroup>

</Project>
