    <ItemGroup>
        <ProjectReference Include="..\Flowery.NET.Gallery\Flowery.NET.Gallery.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Browser" Version="12.0.2" />
    </ItemGroup>
</Project>
