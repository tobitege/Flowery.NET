<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Flowery.NET.Kiosk"
        x:Class="Flowery.NET.Kiosk.MainWindow"
        Title="Flowery.NET Kiosk"
        Icon="avares://Flowery.NET.Kiosk/Assets/app_icon.ico"
        Width="1280" Height="800" MinWidth="640" MinHeight="400"
        MaxWidth="1920" MaxHeight="1080"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource DaisyBase100Brush}">
  <local:KioskMainPage x:Name="MainPage" />
</Window>
