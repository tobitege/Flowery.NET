<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>..\Flowery.NET.Photos\app_icon.ico</ApplicationIcon>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- A publish for a runtime downloads only the .NET runtime pack, not the ASP.NET Core and Windows Desktop packs
         the SDK fetches in case a reference needs them; the app uses neither. -->
    <DisableTransitiveFrameworkReferenceDownloads>true</DisableTransitiveFrameworkReferenceDownloads>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Flowery.NET.Photos\Flowery.NET.Photos.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <PackageReference Include="Chrome.DevTools.Avalonia" Version="0.1.0" PrivateAssets="all" />
    <!-- CDP's SQLite dependency must not select the vulnerable 2.1.11 native library. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" PrivateAssets="all" />
  </ItemGroup>
</Project>
