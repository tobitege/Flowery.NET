<Project Sdk="Microsoft.NET.Sdk">

  <!-- An app that references Flowery.NET, Flowery.NET.Skia and Flowery.NET.Kanban as NuGet packages, not as projects,
       to test the packages before and after a release; scripts/test_packages.ps1 runs it. It is not part of
       Flowery.NET.sln, because nuget.org has the packages of the version in Directory.Build.props only after their
       release. -->
  <PropertyGroup>
    <!-- A console app: on Windows, dotnet run passes neither the output nor the exit code of a WinExe on. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>

    <!-- The version of the three packages, by default the version this checkout releases. -->
    <FloweryPackageVersion Condition="'$(FloweryPackageVersion)' == ''">$(Version)</FloweryPackageVersion>
    <!-- A folder with packed packages, searched next to nuget.org. -->
    <RestoreAdditionalProjectSources>$(FloweryPackageSource)</RestoreAdditionalProjectSources>
    <!-- A package of the same ID and version can come from such a folder or from nuget.org, and NuGet never replaces a
         package it extracted once. So the app keeps its packages out of the global package folder, in one folder per
         source. -->
    <RestorePackagesPath Condition="'$(FloweryPackageSource)' == ''">$(BaseIntermediateOutputPath)packages\nuget.org\</RestorePackagesPath>
    <RestorePackagesPath Condition="'$(FloweryPackageSource)' != ''">$(BaseIntermediateOutputPath)packages\local\</RestorePackagesPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Flowery.NET" Version="[$(FloweryPackageVersion)]" />
    <PackageReference Include="Flowery.NET.Skia" Version="[$(FloweryPackageVersion)]" />
    <PackageReference Include="Flowery.NET.Kanban" Version="[$(FloweryPackageVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <!-- The in-memory state storage of the headless tests, so the Kanban leaves the state of the Gallery alone. -->
    <Compile Include="..\Flowery.NET.Tests\InMemoryStateStorage.cs" Link="InMemoryStateStorage.cs" />
  </ItemGroup>

  <PropertyGroup>
    <!-- The Avalonia version of Flowery.NET, read from its project, so an update there reaches the Avalonia packages of
         this app too; Avalonia packages of different versions do not work together. -->
    <FloweryProject>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\Flowery.NET\Flowery.NET.csproj'))</FloweryProject>
    <FloweryAvaloniaVersion>$([System.Text.RegularExpressions.Regex]::Match($(FloweryProject), '(?&lt;=Include="Avalonia" Version=")[^"]+'))</FloweryAvaloniaVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="[$(FloweryAvaloniaVersion)]" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="[$(FloweryAvaloniaVersion)]" />
    <PackageReference Include="Avalonia.Headless" Version="[$(FloweryAvaloniaVersion)]" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="[$(FloweryAvaloniaVersion)]" />
  </ItemGroup>

</Project>
