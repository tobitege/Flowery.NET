<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows10.0.19041.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Flowery.NET.Photos\Flowery.NET.Photos.csproj" />
    <!-- ProTest.Avalonia.Headless pins Avalonia to its own release; the direct reference lets the tests run on the
         Avalonia version of the app until ProTest catches up. -->
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="ProTest.Avalonia.Headless.XUnit.v4" Version="12.1.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Media\*" Exclude="Media\*.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
