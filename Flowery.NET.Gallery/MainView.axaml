<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
    xmlns:custom="clr-namespace:Flowery.Controls.Custom;assembly=Flowery.NET"
    xmlns:examples="clr-namespace:Flowery.NET.Gallery.Examples"
    mc:Ignorable="d"
    d:DesignWidth="1100"
    d:DesignHeight="800"
    x:Class="Flowery.NET.Gallery.MainView"
    Background="{DynamicResource DaisyBase100Brush}">

    <Grid x:Name="LayoutRoot" ColumnDefinitions="*">
        <!-- The backdrop of the theme behind everything, which glass on the pages shows. -->
        <controls:DaisyBackdrop x:Name="AppBackdrop" />
        <SplitView x:Name="MainSplitView"
            IsPaneOpen="False"
            DisplayMode="Overlay"
            OpenPaneLength="220">
            <SplitView.Pane>
                <!-- Left Sidebar -->
                <controls:FloweryComponentSidebar x:Name="ComponentSidebar"
                    SidebarWidth="220"
                    ItemSelected="ComponentSidebar_ItemSelected" />
            </SplitView.Pane>
            <SplitView.Content>
                <!-- Main Content -->
                <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
                    <!-- Header: a glass card over glows in the colors of the theme -->
                    <Border x:Name="HeaderBorder" Grid.Row="0" ClipToBounds="True"
                        Background="{DynamicResource DaisyBase200Brush}">
                        <Grid>
                            <!-- Glows behind the glass (hidden on mobile compact mode). A Canvas takes no room,
                                 so the glass card alone sets the height of the header. -->
                            <Canvas IsHitTestVisible="False">
                                <Ellipse x:Name="HeaderOrbRight" Width="420" Height="260" Opacity="0.55"
                                    Canvas.Right="60" Canvas.Top="-110">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Offset="0" Color="{DynamicResource DaisyPrimaryColor}" />
                                            <GradientStop Offset="1" Color="Transparent" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse x:Name="HeaderOrbLeft" Width="360" Height="220" Opacity="0.45"
                                    Canvas.Left="80" Canvas.Bottom="-120">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Offset="0" Color="{DynamicResource DaisySecondaryColor}" />
                                            <GradientStop Offset="1" Color="Transparent" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                            </Canvas>

                            <StackPanel x:Name="HeaderPanel">
                                <!-- Tinted with the base color of the theme, so its text stays readable in light and dark themes. -->
                                <controls:DaisyGlass x:Name="HeaderCard" Padding="0"
                                    Margin="8,8,8,6" CornerRadius="14"
                                    EnableBackdropBlur="True" BlurMode="SkiaSharp" GlassBlur="30"
                                    GlassTint="{DynamicResource DaisyBase100Color}" GlassTintOpacity="0.55">
                                    <!-- Header content -->
                                    <Grid x:Name="HeaderContentGrid" Margin="12,16,16,8"
                                        ColumnDefinitions="Auto,*">
                                        <controls:DaisyButton x:Name="HamburgerButton" Size="Small"
                                            Variant="Ghost" IsVisible="False"
                                            Click="HamburgerButton_Click"
                                            Margin="0,0,8,0" VerticalAlignment="Center">
                                            <PathIcon Width="18" Height="18"
                                                Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
                                        </controls:DaisyButton>

                                        <StackPanel Grid.Column="1" Spacing="4">
                                            <!-- A phone wraps "Components Gallery" to a second line. -->
                                            <TextBlock x:Name="HeaderTitle" FontSize="28"
                                                FontWeight="Bold" TextWrapping="Wrap"
                                                Foreground="{DynamicResource DaisyBaseContentBrush}">
                                                <Run Text="Flowery.NET" />
                                                <Run x:Name="HeaderSubtitleRun"
                                                    Text=" Components Gallery" FontWeight="Normal"
                                                    Foreground="{DynamicResource DaisyBaseContentMutedBrush}" />
                                            </TextBlock>
                                            <Grid x:Name="SubtitleRow" ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="Created by" FontSize="13"
                                                        Foreground="{DynamicResource DaisyBaseContentMutedBrush}"
                                                        VerticalAlignment="Center" />
                                                    <Button Classes="link" Padding="0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Cursor="Hand" Click="OpenGitHub_Click">
                                                        <TextBlock Text="tobitege" FontSize="13"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource DaisyPrimaryForegroundBrush}" />
                                                    </Button>
                                                    <TextBlock Text="· 2025, 2026 · MIT licensed"
                                                        FontSize="13"
                                                        Foreground="{DynamicResource DaisyBaseContentMutedBrush}"
                                                        VerticalAlignment="Center" />
                                                </StackPanel>
                                                <controls:DaisyButton x:Name="ScreenshotButton"
                                                    Grid.Column="1"
                                                    Content="📸" Variant="Ghost" Size="Small"
                                                    ToolTip.Tip="Capture All Screenshots"
                                                    Click="CaptureAllScreenshots_Click" />
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </controls:DaisyGlass>

                                <!-- Bottom accent bar in the colors of the theme -->
                                <Border x:Name="HeaderAccentBar" Height="3">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                            <GradientStop Offset="0" Color="{DynamicResource DaisyPrimaryColor}" />
                                            <GradientStop Offset="0.5" Color="{DynamicResource DaisySecondaryColor}" />
                                            <GradientStop Offset="1" Color="{DynamicResource DaisyAccentColor}" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Category Title Bar (hidden on Home) -->
                    <Border x:Name="CategoryTitleBar" Grid.Row="1"
                        Background="{DynamicResource DaisyBase200Brush}"
                        BorderBrush="{DynamicResource DaisyBase300Brush}" BorderThickness="0,0,0,1"
                        Padding="24,4,24,20" IsVisible="False" Tapped="CategoryTitleBar_Tapped">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <!-- Takes the place of the hamburger button while the header is hidden for a collapsible intro. -->
                            <controls:DaisyButton x:Name="CategoryMenuButton" Size="Small"
                                Variant="Ghost" IsVisible="False"
                                Click="HamburgerButton_Click"
                                Margin="0,0,8,0" VerticalAlignment="Center">
                                <PathIcon Width="18" Height="18"
                                    Data="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
                            </controls:DaisyButton>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                <!-- Futuristic painted chevrons -->
                                <Viewbox x:Name="CategoryChevrons" Width="24" Height="14"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Spacing="-6">
                                        <Path Data="M0,0 L6,0 L12,7 L6,14 L0,14 L6,7 Z"
                                            Fill="{DynamicResource DaisyPrimaryBrush}" Opacity="0.4" />
                                        <Path Data="M0,0 L6,0 L12,7 L6,14 L0,14 L6,7 Z"
                                            Fill="{DynamicResource DaisyPrimaryBrush}" Opacity="0.7" />
                                        <Path Data="M0,0 L6,0 L12,7 L6,14 L0,14 L6,7 Z"
                                            Fill="{DynamicResource DaisyPrimaryBrush}" Opacity="1.0" />
                                    </StackPanel>
                                </Viewbox>

                                <TextBlock x:Name="CategoryTitle" Text="" FontSize="22"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource DaisyBaseContentBrush}" />
                            </StackPanel>
                            <!-- Shows whether the intro of the page is folded; the whole bar toggles it. -->
                            <PathIcon x:Name="CategoryIntroToggle" Grid.Column="2" IsVisible="False"
                                Width="12" Height="6" VerticalAlignment="Center"
                                Data="M7 10l5 5 5-5z"
                                Foreground="{DynamicResource DaisyBaseContentBrush}" />
                        </Grid>
                    </Border>

                    <!-- Content fills remaining space -->
                    <Grid x:Name="MainContentHost" Grid.Row="2" />
                </Grid>
            </SplitView.Content>
        </SplitView>

        <!-- Modal overlay at window level -->
        <controls:DaisyModal x:Name="DemoModal" Grid.ColumnSpan="2" IsOpen="False">
            <StackPanel Spacing="12" MaxWidth="400">
                <TextBlock x:Name="ModalTitle" Text="Hello!" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua." TextWrapping="Wrap" Opacity="0.8"/>
                <TextBlock Text="Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat." TextWrapping="Wrap" Opacity="0.7" FontSize="13"/>
                <controls:DaisyButton Content="Close" Variant="Primary" Click="CloseModalBtn_Click" HorizontalAlignment="Right" Margin="0,8,0,0"/>
            </StackPanel>
        </controls:DaisyModal>
    </Grid>
</UserControl>
