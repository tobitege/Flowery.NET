// Adapted from a Codrops article by Robin Delaporte
// https://tympanus.net/Development/DistortionHoverEffect

// SkSL: the sampler is a child shader, read through a helper as getFromColor reads from.
uniform shader displacementMap;

vec4 texture2D_displacementMap(vec2 uv) {
  return unpremul(displacementMap.eval(vec2(uv.x, 1.0 - uv.y)));
}

uniform float strength; // = 0.5

vec4 transition (vec2 uv) {
  float displacement = texture2D_displacementMap(uv).r * strength;

  vec2 uvFrom = vec2(uv.x + progress * displacement, uv.y);
  vec2 uvTo = vec2(uv.x - (1.0 - progress) * displacement, uv.y);

  return mix(
    getFromColor(uvFrom),
    getToColor(uvTo),
    progress
  );
}
