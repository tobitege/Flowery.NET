<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
    xmlns:skia="clr-namespace:Flowery.Skia;assembly=Flowery.NET.Skia"
    xmlns:services="clr-namespace:Flowery.Services;assembly=Flowery.NET"
    xmlns:local="clr-namespace:Flowery.NET.Gallery.Examples"
    x:Class="Flowery.NET.Gallery.Examples.GlassExamples"
    x:CompileBindings="False">

    <UserControl.Styles>
        <!-- Each glass demo panel has a row of six stars: two stay left of the panel,
             four run half behind its lower edge, so sharp and covered stars sit side by side. -->
        <Style Selector="Grid.glassStars">
            <Setter Property="Margin" Value="-80,0,0,-18" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>
        <Style Selector="Grid.glassStars > TextBlock">
            <Setter Property="Text" Value="★" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="Foreground" Value="Yellow" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.glassStars.gold > TextBlock">
            <Setter Property="Foreground" Value="#FFD700" />
        </Style>
        <!-- Glass Interface: dark glass over the dark backdrop; the class light switches to light glass. -->
        <Style Selector=".glassScene PathIcon">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector=".glassScene.light PathIcon">
            <Setter Property="Foreground" Value="#0B1533" />
        </Style>
        <Style Selector=".glassScene controls|DaisyGlassSegmented">
            <Setter Property="GlassTint" Value="#0B1B5E" />
            <Setter Property="GlassTintOpacity" Value="0.3" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector=".glassScene.light controls|DaisyGlassSegmented">
            <Setter Property="GlassTint" Value="White" />
            <Setter Property="GlassTintOpacity" Value="0.45" />
            <Setter Property="Foreground" Value="#0B1533" />
            <Setter Property="IndicatorBrush" Value="#260B1533" />
        </Style>
        <Style Selector=".glassScene controls|DaisyGlassButton">
            <Setter Property="GlassTint" Value="#0B1B5E" />
            <Setter Property="GlassTintOpacity" Value="0.3" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector=".glassScene.light controls|DaisyGlassButton">
            <Setter Property="GlassTint" Value="White" />
            <Setter Property="GlassTintOpacity" Value="0.45" />
            <Setter Property="Foreground" Value="#0B1533" />
            <Setter Property="GlassTextShadowOpacity" Value="0" />
        </Style>
        <Style Selector=".glassScene controls|DaisyGlassInput">
            <Setter Property="GlassTint" Value="#0B1B5E" />
            <Setter Property="GlassTintOpacity" Value="0.3" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector=".glassScene.light controls|DaisyGlassInput">
            <Setter Property="GlassTint" Value="White" />
            <Setter Property="GlassTintOpacity" Value="0.45" />
            <Setter Property="Foreground" Value="#0B1533" />
        </Style>
        <Style Selector="controls|DaisyGlassMenu.glassScene">
            <Setter Property="GlassTint" Value="#0B1B5E" />
            <Setter Property="GlassTintOpacity" Value="0.45" />
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="controls|DaisyGlassMenu.glassScene.light">
            <Setter Property="GlassTint" Value="White" />
            <Setter Property="GlassTintOpacity" Value="0.65" />
            <Setter Property="Foreground" Value="#0B1533" />
        </Style>
        <!-- The scene keeps its own blue, whatever the primary color of the app theme. -->
        <Style Selector=".glassScene controls|DaisyGlassRange">
            <Setter Property="ProgressBrush" Value="#0A84FF" />
        </Style>
        <Style Selector=".glassScene ListBoxItem.menu-destructive PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource DaisyErrorBrush}" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="MainScrollViewer" HorizontalScrollBarVisibility="Disabled"
        services:FloweryResponsive.IsEnabled="True"
        services:FloweryResponsive.BaseMaxWidth="430">
        <StackPanel Spacing="24" Margin="24,0,24,32">

            <!-- Glass Button -->
            <StackPanel Spacing="12">
                <local:SectionHeader SectionId="glass-button" Title="Glass Button" />
                <TextBlock
                    Text="DaisyGlassButton blurs whatever lies behind it, live on every frame with BlurMode=SkiaSharp. Variants tint the glass; styles, sizes, shapes and icons work as on DaisyButton."
                    Opacity="0.7" TextWrapping="Wrap" controls:FlowerySizeManager.ResponsiveFont="Primary" />
                <controls:DaisyToggle x:Name="GlassButtonMotionToggle" Content="Move the backdrop" IsChecked="True" />
                <Border CornerRadius="16" ClipToBounds="True" MinHeight="300">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#0ea5e9" Offset="0" />
                            <GradientStop Color="#7c3aed" Offset="0.5" />
                            <GradientStop Color="#f43f5e" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- Backdrop: text and a moving disc, so the blur of each button is visible. -->
                        <StackPanel Margin="20" Spacing="6" IsHitTestVisible="False">
                            <TextBlock Text="BEHIND THE GLASS" FontSize="34" FontWeight="Black" Foreground="White" Opacity="0.9" />
                            <TextBlock Text="★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★" FontSize="28" Foreground="Yellow" />
                            <TextBlock Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
                                       FontSize="16" Foreground="White" Opacity="0.85" TextWrapping="Wrap" />
                            <TextBlock Text="▲ ● ■ ◆ ▲ ● ■ ◆ ▲ ● ■ ◆ ▲ ● ■ ◆" FontSize="30" Foreground="#22d3ee" />
                        </StackPanel>
                        <!-- Bounces off the four walls like a pool ball; the code-behind moves it on every frame. -->
                        <Border x:Name="GlassDemoBall" Width="110" Height="110" CornerRadius="55" Background="#ef4444"
                                HorizontalAlignment="Left" VerticalAlignment="Top"
                                IsHitTestVisible="False"
                                IsVisible="{Binding #GlassButtonMotionToggle.IsChecked}">
                            <Border.RenderTransform>
                                <TranslateTransform />
                            </Border.RenderTransform>
                        </Border>

                        <StackPanel Margin="20,24" Spacing="14" VerticalAlignment="Center">
                            <WrapPanel HorizontalAlignment="Center">
                                <controls:DaisyGlassButton Content="Glass" Margin="6" />
                                <controls:DaisyGlassButton Variant="Neutral" Content="Neutral" Margin="6" />
                                <controls:DaisyGlassButton Variant="Primary" Content="Primary" Margin="6" />
                                <controls:DaisyGlassButton Variant="Secondary" Content="Secondary" Margin="6" />
                                <controls:DaisyGlassButton Variant="Accent" Content="Accent" Margin="6" />
                                <controls:DaisyGlassButton Variant="Info" Content="Info" Margin="6" />
                                <controls:DaisyGlassButton Variant="Success" Content="Success" Margin="6" />
                                <controls:DaisyGlassButton Variant="Warning" Content="Warning" Margin="6" />
                                <controls:DaisyGlassButton Variant="Error" Content="Error" Margin="6" />
                            </WrapPanel>
                            <WrapPanel HorizontalAlignment="Center">
                                <controls:DaisyGlassButton ButtonStyle="Outline" Variant="Primary" Content="Outline" Margin="6" />
                                <controls:DaisyGlassButton ButtonStyle="Dash" Variant="Accent" Content="Dash" Margin="6" />
                                <controls:DaisyGlassButton ButtonStyle="Soft" Variant="Success" Content="Soft" Margin="6" />
                                <controls:DaisyGlassButton Variant="Ghost" Content="Ghost" Margin="6" />
                                <controls:DaisyGlassButton Variant="Primary" IconSymbol="Favorite" Content="Icon" Margin="6" />
                                <controls:DaisyGlassButton Shape="Circle" IconSymbol="Add" Margin="6" />
                                <controls:DaisyGlassButton Content="Disabled" IsEnabled="False" Margin="6" />
                            </WrapPanel>
                            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:DaisyGlassButton Size="ExtraSmall" Content="Extra Small" Margin="6" VerticalAlignment="Center" />
                                <controls:DaisyGlassButton Size="Small" Content="Small" Margin="6" VerticalAlignment="Center" />
                                <controls:DaisyGlassButton Size="Medium" Content="Medium" Margin="6" VerticalAlignment="Center" />
                                <controls:DaisyGlassButton Size="Large" Content="Large" Margin="6" VerticalAlignment="Center" />
                                <controls:DaisyGlassButton Size="ExtraLarge" Content="Extra Large" Margin="6" VerticalAlignment="Center" />
                            </WrapPanel>
                            <WrapPanel HorizontalAlignment="Center">
                                <controls:DaisyGlassButton Content="Heavy blur" GlassBlur="60" Margin="6" />
                                <controls:DaisyGlassButton Content="Dark glass" GlassTint="#111827" GlassTintOpacity="0.45" Foreground="White" Margin="6" />
                                <controls:DaisyGlassButton Content="Liquid lens" GlassDepth="0.9" GlassCurvature="0.85" GlassBend="0.7" GlassDispersion="0.35" GlassReflectOpacity="0.3" Margin="6" />
                                <controls:DaisyGlassButton Content="Bitmap capture" BlurMode="BitmapCapture" Margin="6" />
                                <controls:DaisyGlassButton Content="Simulated" EnableBackdropBlur="False" Margin="6" />
                            </WrapPanel>
                            <!-- Gradient presets over the blur -->
                            <WrapPanel HorizontalAlignment="Center">
                                <controls:DaisyGlassButton Content="Aurora" GlassGradient="Aurora" Foreground="White" Margin="6" />
                                <controls:DaisyGlassButton Content="Sunset" GlassGradient="Sunset" Foreground="White" Margin="6" />
                                <controls:DaisyGlassButton Content="Ocean" GlassGradient="Ocean" Foreground="White" Margin="6" />
                                <controls:DaisyGlassButton Content="Mint" GlassGradient="Mint" Foreground="#064E3B" GlassTextShadowOpacity="0" Margin="6" />
                                <controls:DaisyGlassButton Content="Holo" GlassGradient="Holo" GlassFillOpacity="0.65" Foreground="#1E1B4B" GlassTextShadowOpacity="0.2" Margin="6" />
                                <controls:DaisyGlassButton Content="Frost" GlassGradient="Frost" GlassFillOpacity="0.7" Foreground="#0F172A" GlassTextShadowOpacity="0" Margin="6" />
                            </WrapPanel>
                            <!-- Patterns over the blur -->
                            <WrapPanel HorizontalAlignment="Center">
                                <controls:DaisyGlassButton Content="Dots" GlassPattern="Dots" GlassPatternOpacity="0.7" Foreground="White" Margin="6" />
                                <controls:DaisyGlassButton Content="Stripes" GlassPattern="Stripes" GlassPatternOpacity="0.35" Foreground="White" Margin="6" />
                                <controls:DaisyGlassButton Content="Honeycomb" GlassPattern="Honeycomb" GlassPatternOpacity="0.5" Foreground="White" Margin="6" />
                                <controls:DaisyGlassButton Content="Carbon" GlassPattern="CarbonFiber" GlassTint="#111827" GlassTintOpacity="0.45" GlassPatternOpacity="0.45" Foreground="White" Margin="6" />
                                <controls:DaisyGlassButton Content="Circuit" GlassPattern="Circuit" GlassPatternColor="#67E8F9" GlassPatternOpacity="0.8" Foreground="White" Margin="6" />
                                <controls:DaisyGlassButton Content="Frosted grain" GlassPattern="Noise" GlassPatternOpacity="0.6" Foreground="White" Margin="6" />
                            </WrapPanel>
                            <!-- Gradients, patterns and a custom fill combined -->
                            <WrapPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <controls:DaisyGlassButton Content="Holo scales" GlassGradient="Holo" GlassFillOpacity="0.55" GlassPattern="Scales" GlassPatternOpacity="0.4"
                                                           Foreground="#1E1B4B" GlassTextShadowOpacity="0.2" Margin="6" />
                                <controls:DaisyGlassButton Content="Sunset stripes" GlassGradient="Sunset" GlassPattern="Stripes" GlassPatternOpacity="0.3" Foreground="White" Margin="6" />
                                <controls:DaisyGlassButton Content="Custom fill" Foreground="White" GlassFillOpacity="0.7" Margin="6">
                                    <controls:DaisyGlassButton.GlassFill>
                                        <RadialGradientBrush Center="50%,0%" GradientOrigin="50%,0%" RadiusX="120%" RadiusY="120%">
                                            <GradientStop Color="#F0ABFC" Offset="0" />
                                            <GradientStop Color="#6D28D9" Offset="0.6" />
                                            <GradientStop Color="#1E1B4B" Offset="1" />
                                        </RadialGradientBrush>
                                    </controls:DaisyGlassButton.GlassFill>
                                </controls:DaisyGlassButton>
                                <controls:DaisyGlassButton Content="Get started" Size="ExtraLarge" Shape="Wide" GlassGradient="Aurora" GlassPattern="Noise" GlassPatternOpacity="0.4"
                                                           GlassDepth="0.9" GlassCurvature="0.8" GlassReflectOpacity="0.3" Foreground="White" Margin="6" />
                            </WrapPanel>
                            <!-- Animated backgrounds, one effect per row: moving gradients from Flowery.NET, shaders from Flowery.NET.Skia -->
                            <Grid HorizontalAlignment="Center" ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto">
                                <TextBlock Text="Gradients" HorizontalAlignment="Center" Foreground="White" FontWeight="SemiBold" Margin="6,6,6,0" />
                                <TextBlock Text="Shaders" Grid.Column="1" HorizontalAlignment="Center" Foreground="White" FontWeight="SemiBold" Margin="6,6,6,0" />
                                <controls:DaisyGlassButton Content="Plasma" Grid.Row="1" Grid.Column="0" Size="Large" Shape="Wide" HorizontalAlignment="Stretch" Foreground="White" Margin="6">
                                    <controls:DaisyGlassButton.GlassBackground>
                                        <controls:DaisyGlassGradientBackground Effect="Plasma" />
                                    </controls:DaisyGlassButton.GlassBackground>
                                </controls:DaisyGlassButton>
                                <controls:DaisyGlassButton Content="Plasma" Grid.Row="1" Grid.Column="1" Size="Large" Shape="Wide" HorizontalAlignment="Stretch" Foreground="White" Margin="6">
                                    <controls:DaisyGlassButton.GlassBackground>
                                        <skia:DaisyGlassShaderBackground Effect="Plasma" />
                                    </controls:DaisyGlassButton.GlassBackground>
                                </controls:DaisyGlassButton>
                                <controls:DaisyGlassButton Content="Aurora" Grid.Row="2" Grid.Column="0" Size="Large" Shape="Wide" HorizontalAlignment="Stretch" Foreground="White" GlassBackgroundOpacity="0.8" Margin="6">
                                    <controls:DaisyGlassButton.GlassBackground>
                                        <controls:DaisyGlassGradientBackground Effect="Aurora" />
                                    </controls:DaisyGlassButton.GlassBackground>
                                </controls:DaisyGlassButton>
                                <controls:DaisyGlassButton Content="Aurora" Grid.Row="2" Grid.Column="1" Size="Large" Shape="Wide" HorizontalAlignment="Stretch" Foreground="White" GlassBackgroundOpacity="0.8" Margin="6">
                                    <controls:DaisyGlassButton.GlassBackground>
                                        <skia:DaisyGlassShaderBackground Effect="Aurora" />
                                    </controls:DaisyGlassButton.GlassBackground>
                                </controls:DaisyGlassButton>
                                <controls:DaisyGlassButton Content="Liquid gold" Grid.Row="3" Grid.Column="0" Size="Large" Shape="Wide" HorizontalAlignment="Stretch" Foreground="#3B2600" GlassTextShadowOpacity="0" GlassBackgroundOpacity="0.85" Margin="6">
                                    <controls:DaisyGlassButton.GlassBackground>
                                        <controls:DaisyGlassGradientBackground Effect="LiquidGold" />
                                    </controls:DaisyGlassButton.GlassBackground>
                                </controls:DaisyGlassButton>
                                <controls:DaisyGlassButton Content="Liquid gold" Grid.Row="3" Grid.Column="1" Size="Large" Shape="Wide" HorizontalAlignment="Stretch" Foreground="#3B2600" GlassTextShadowOpacity="0" GlassBackgroundOpacity="0.85" Margin="6">
                                    <controls:DaisyGlassButton.GlassBackground>
                                        <skia:DaisyGlassShaderBackground Effect="LiquidGold" />
                                    </controls:DaisyGlassButton.GlassBackground>
                                </controls:DaisyGlassButton>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <controls:DaisyDivider />

            <!-- Glass Button Designer -->
            <StackPanel Spacing="12">
                <local:SectionHeader SectionId="glass-designer" Title="Glass Button Designer" />
                <TextBlock
                    Text="DaisyGlassButtonDesigner shapes a glass button visually: presets, variant and shape, the glass, gradients, patterns and animated backgrounds. It writes the result as XAML, C# or JSON, or applies it to a button. Embed it in a page, or open it over the app."
                    Opacity="0.7" TextWrapping="Wrap" controls:FlowerySizeManager.ResponsiveFont="Primary" />
                <controls:DaisyButton x:Name="OpenGlassDesignerButton" Content="Open over the app" ButtonStyle="Soft" HorizontalAlignment="Left" />
                <controls:DaisyGlassButtonDesigner x:Name="GlassDesigner" />
            </StackPanel>

            <controls:DaisyDivider />

            <!-- Glass Controls -->
            <StackPanel Spacing="12">
                <local:SectionHeader SectionId="glass-controls" Title="Glass Controls" />
                <TextBlock
                    Text="DaisyGlassNavbar, DaisyGlassInput, DaisyGlassBadge and DaisyGlassModal blur what lies behind them, like DaisyGlassButton. Scroll the backdrop under the bar, and open the dialog to see the page blurred behind it."
                    Opacity="0.7" TextWrapping="Wrap" controls:FlowerySizeManager.ResponsiveFont="Primary" />
                <Border CornerRadius="16" ClipToBounds="True" Height="520">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#1e1b4b" Offset="0" />
                            <GradientStop Color="#7e22ce" Offset="0.5" />
                            <GradientStop Color="#db2777" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- Scrolling backdrop: colorful blocks and text pass under the glass bar and card. -->
                        <!-- The bottom margin lets even the last row scroll up under the bar. -->
                        <ScrollViewer x:Name="GlassShowcaseScroller" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="24,88,24,440" Spacing="16">
                                <TextBlock Text="SCROLL ME" FontSize="56" FontWeight="Black" Foreground="White" Opacity="0.9" />
                                <WrapPanel>
                                    <Border Width="140" Height="90" CornerRadius="18" Margin="0,0,16,16" Background="#facc15" />
                                    <Border Width="90" Height="90" CornerRadius="45" Margin="0,0,16,16" Background="#22d3ee" />
                                    <Border Width="180" Height="90" CornerRadius="18" Margin="0,0,16,16" Background="#34d399" />
                                    <Border Width="90" Height="90" CornerRadius="45" Margin="0,0,16,16" Background="#fb7185" />
                                    <Border Width="140" Height="90" CornerRadius="18" Margin="0,0,16,16" Background="#a78bfa" />
                                </WrapPanel>
                                <TextBlock Text="★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★" FontSize="32" Foreground="Yellow" />
                                <TextBlock Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris."
                                           FontSize="18" Foreground="White" TextWrapping="Wrap" />
                                <WrapPanel>
                                    <Border Width="90" Height="90" CornerRadius="45" Margin="0,0,16,16" Background="#f97316" />
                                    <Border Width="200" Height="90" CornerRadius="18" Margin="0,0,16,16" Background="#38bdf8" />
                                    <Border Width="90" Height="90" CornerRadius="45" Margin="0,0,16,16" Background="#facc15" />
                                    <Border Width="160" Height="90" CornerRadius="18" Margin="0,0,16,16" Background="#4ade80" />
                                </WrapPanel>
                                <TextBlock Text="▲ ● ■ ◆ ▲ ● ■ ◆ ▲ ● ■ ◆ ▲ ● ■ ◆ ▲ ● ■ ◆" FontSize="34" Foreground="#67e8f9" />
                                <TextBlock Text="KEEP SCROLLING" FontSize="56" FontWeight="Black" Foreground="#fde68a" />
                                <WrapPanel>
                                    <Border Width="180" Height="120" CornerRadius="24" Margin="0,0,16,16" Background="#e879f9" />
                                    <Border Width="120" Height="120" CornerRadius="60" Margin="0,0,16,16" Background="#2dd4bf" />
                                    <Border Width="220" Height="120" CornerRadius="24" Margin="0,0,16,16" Background="#fbbf24" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>

                        <controls:DaisyGlassNavbar VerticalAlignment="Top" Margin="12" Foreground="White">
                            <controls:DaisyGlassNavbar.NavbarStart>
                                <TextBlock Text="Flowery" FontSize="20" FontWeight="Bold" Foreground="White" />
                            </controls:DaisyGlassNavbar.NavbarStart>
                            <controls:DaisyGlassNavbar.NavbarCenter>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:DaisyGlassBadge Content="Docs" Foreground="White" />
                                    <controls:DaisyGlassBadge Content="Beta" Variant="Primary" />
                                    <controls:DaisyGlassBadge Content="12" Variant="Error" Size="Small" />
                                </StackPanel>
                            </controls:DaisyGlassNavbar.NavbarCenter>
                            <controls:DaisyGlassNavbar.NavbarEnd>
                                <controls:DaisyGlassButton Content="Open dialog" Size="Small" GlassGradient="Aurora" Foreground="White"
                                                           Click="OpenGlassModal_Click" />
                            </controls:DaisyGlassNavbar.NavbarEnd>
                        </controls:DaisyGlassNavbar>

                        <!-- A sign-in card: glass inputs and badges inside a glass panel. -->
                        <controls:DaisyGlass Width="340" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="24"
                                             Padding="24" CornerRadius="20"
                                             EnableBackdropBlur="True" BlurMode="SkiaSharp" GlassBlur="40"
                                             GlassTint="#0F172A" GlassTintOpacity="0.35">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Sign in" FontSize="22" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                    <controls:DaisyGlassBadge Content="Secure" Variant="Success" Size="Small" VerticalAlignment="Center" />
                                </StackPanel>
                                <controls:DaisyGlassInput PlaceholderText="Email" Foreground="White" />
                                <controls:DaisyGlassInput PlaceholderText="Password" PasswordChar="●" Foreground="White" />
                                <controls:DaisyGlassInput Label="Workspace" LabelPosition="Floating" Text="flowery" Foreground="White" />
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                    <controls:DaisyGlassButton Content="Cancel" Foreground="White" />
                                    <controls:DaisyGlassButton Content="Sign in" GlassGradient="Sunset" Foreground="White" />
                                </StackPanel>
                            </StackPanel>
                        </controls:DaisyGlass>

                        <controls:DaisyGlassModal x:Name="GlassShowcaseModal" DialogMaxWidth="360">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Glass dialog" FontSize="22" FontWeight="Bold" Foreground="White" />
                                <TextBlock Text="The dialog blurs the dimmed page behind it. Its glass takes gradients and patterns like every glass control."
                                           TextWrapping="Wrap" Foreground="White" Opacity="0.9" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <controls:DaisyGlassBadge Content="Live blur" Foreground="White" />
                                    <controls:DaisyGlassBadge Content="SkiaSharp" Variant="Info" />
                                </StackPanel>
                                <controls:DaisyGlassButton Content="Close" HorizontalAlignment="Right" GlassGradient="Holo" GlassFillOpacity="0.6"
                                                           Foreground="#1E1B4B" GlassTextShadowOpacity="0.2" Click="CloseGlassModal_Click" />
                            </StackPanel>
                        </controls:DaisyGlassModal>
                    </Grid>
                </Border>
            </StackPanel>

            <controls:DaisyDivider />

            <!-- Glass Interface -->
            <StackPanel Spacing="12">
                <local:SectionHeader SectionId="glass-interface" Title="Glass Interface" />
                <TextBlock
                    Text="DaisyGlassSegmented, DaisyGlassRange, DaisyGlassToggle and DaisyGlassMenu with glass buttons and a glass search field over a calm wave backdrop. Press the slider thumb to turn it into a lens, open the menu with the dots button, and flip the switch at the top right between dark and light glass. The Glassy theme tints every glass control navy."
                    Opacity="0.7" TextWrapping="Wrap" controls:FlowerySizeManager.ResponsiveFont="Primary" />
                <Border x:Name="GlassInterfaceStage" Classes="glassScene" CornerRadius="16" ClipToBounds="True" Height="540">
                    <Grid>
                        <!-- Dark backdrop: violet into deep blue, with a bright sweep from the lower left to the upper right. -->
                        <Viewbox x:Name="GlassInterfaceDarkSky" Stretch="UniformToFill" IsHitTestVisible="False">
                            <Viewbox.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.45" />
                                </Transitions>
                            </Viewbox.Transitions>
                            <Canvas Width="1600" Height="900" ClipToBounds="True">
                                <Rectangle Width="1600" Height="900">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Offset="0" Color="#4A2BD6" />
                                            <GradientStop Offset="0.45" Color="#2A36CC" />
                                            <GradientStop Offset="0.7" Color="#0C2DAA" />
                                            <GradientStop Offset="1" Color="#061A78" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Ellipse Canvas.Left="-260" Canvas.Top="120" Width="900" Height="700" Opacity="0.55">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Offset="0" Color="#9A7BFF" />
                                            <GradientStop Offset="1" Color="#009A7BFF" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Path Data="M0,900 C380,700 720,300 1020,150 C1260,30 1460,0 1640,-30 L1640,900 Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Offset="0" Color="#5C86F2" />
                                            <GradientStop Offset="0.5" Color="#2148D0" />
                                            <GradientStop Offset="1" Color="#0A228E" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                    <Path.Effect>
                                        <BlurEffect Radius="6" />
                                    </Path.Effect>
                                </Path>
                                <Path Data="M0,900 C380,700 720,300 1020,150 C1260,30 1460,0 1640,-30"
                                      Stroke="#C4D4FF" StrokeThickness="5" Opacity="0.85">
                                    <Path.Effect>
                                        <BlurEffect Radius="3" />
                                    </Path.Effect>
                                </Path>
                                <Ellipse Canvas.Left="820" Canvas.Top="260" Width="760" Height="520" Opacity="0.5">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Offset="0" Color="#8FB0FF" />
                                            <GradientStop Offset="1" Color="#008FB0FF" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Path Data="M0,900 C360,780 700,660 1050,640 C1300,628 1460,580 1640,500 L1640,900 Z" Opacity="0.85">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Offset="0" Color="#0A1F86" />
                                            <GradientStop Offset="1" Color="#1C49D6" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                    <Path.Effect>
                                        <BlurEffect Radius="40" />
                                    </Path.Effect>
                                </Path>
                            </Canvas>
                        </Viewbox>

                        <!-- Light backdrop: warm sand into sky blue, with the same sweep. -->
                        <Viewbox x:Name="GlassInterfaceLightSky" Stretch="UniformToFill" IsHitTestVisible="False" Opacity="0">
                            <Viewbox.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.45" />
                                </Transitions>
                            </Viewbox.Transitions>
                            <Canvas Width="1600" Height="900" ClipToBounds="True">
                                <Rectangle Width="1600" Height="900">
                                    <Rectangle.Fill>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Offset="0" Color="#EFE6C8" />
                                            <GradientStop Offset="0.45" Color="#C9D8EE" />
                                            <GradientStop Offset="0.7" Color="#7FB0F0" />
                                            <GradientStop Offset="1" Color="#2563EB" />
                                        </LinearGradientBrush>
                                    </Rectangle.Fill>
                                </Rectangle>
                                <Ellipse Canvas.Left="-260" Canvas.Top="60" Width="900" Height="700" Opacity="0.6">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Offset="0" Color="#FFF4C7" />
                                            <GradientStop Offset="1" Color="#00FFF4C7" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Path Data="M0,900 C380,700 720,300 1020,150 C1260,30 1460,0 1640,-30 L1640,900 Z">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Offset="0" Color="#B4CEFA" />
                                            <GradientStop Offset="0.5" Color="#4A8AF5" />
                                            <GradientStop Offset="1" Color="#1D4ED8" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                    <Path.Effect>
                                        <BlurEffect Radius="6" />
                                    </Path.Effect>
                                </Path>
                                <Path Data="M0,900 C380,700 720,300 1020,150 C1260,30 1460,0 1640,-30"
                                      Stroke="#FFFFFF" StrokeThickness="5" Opacity="0.9">
                                    <Path.Effect>
                                        <BlurEffect Radius="3" />
                                    </Path.Effect>
                                </Path>
                                <Ellipse Canvas.Left="820" Canvas.Top="260" Width="760" Height="520" Opacity="0.55">
                                    <Ellipse.Fill>
                                        <RadialGradientBrush>
                                            <GradientStop Offset="0" Color="#D6E6FF" />
                                            <GradientStop Offset="1" Color="#00D6E6FF" />
                                        </RadialGradientBrush>
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Path Data="M0,900 C360,780 700,660 1050,640 C1300,628 1460,580 1640,500 L1640,900 Z" Opacity="0.85">
                                    <Path.Fill>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                            <GradientStop Offset="0" Color="#1E40AF" />
                                            <GradientStop Offset="1" Color="#60A5FA" />
                                        </LinearGradientBrush>
                                    </Path.Fill>
                                    <Path.Effect>
                                        <BlurEffect Radius="40" />
                                    </Path.Effect>
                                </Path>
                            </Canvas>
                        </Viewbox>

                        <!-- Dark and light glass -->
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="20"
                                    HorizontalAlignment="Right" VerticalAlignment="Top">
                            <PathIcon Data="{StaticResource DaisyIconSun}" Width="16" Height="16" VerticalAlignment="Center" />
                            <controls:DaisyGlassToggle x:Name="GlassInterfaceDarkToggle" IsChecked="True" VerticalAlignment="Center"
                                                       AutomationProperties.Name="Dark glass" />
                            <PathIcon Data="{StaticResource DaisyIconMoon}" Width="16" Height="16" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Width="360" Spacing="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <controls:DaisyGlassSegmented HorizontalAlignment="Center">
                                <ListBoxItem Content="Day" />
                                <ListBoxItem Content="Week" />
                                <ListBoxItem Content="Month" />
                            </controls:DaisyGlassSegmented>
                            <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
                                <controls:DaisyGlassButton Shape="Circle" Size="Large" IconSymbol="Share" AutomationProperties.Name="Share" />
                                <controls:DaisyGlassButton Content="Continue" Size="Large" CornerRadius="9999" Padding="22,0" />
                                <controls:DaisyGlassButton x:Name="GlassInterfaceMoreButton" Shape="Circle" Size="Large" AutomationProperties.Name="More"
                                                           Click="OpenGlassInterfaceMenu_Click">
                                    <PathIcon Width="18" Height="18"
                                              Data="M6,10A2,2,0,1,1,6,14A2,2,0,1,1,6,10M12,10A2,2,0,1,1,12,14A2,2,0,1,1,12,10M18,10A2,2,0,1,1,18,14A2,2,0,1,1,18,10Z" />
                                </controls:DaisyGlassButton>
                            </StackPanel>
                            <controls:DaisyGlassRange Value="35" Maximum="100" AutomationProperties.Name="Volume" />
                            <controls:DaisyGlassInput PlaceholderText="Search" StartIcon="{StaticResource DaisyIconSearch}" CornerRadius="9999" />
                        </StackPanel>

                        <!-- In the overlay layer of the window, so the glass of the menu sees the backdrop. -->
                        <Popup x:Name="GlassInterfaceMenuPopup"
                               PlacementTarget="{Binding #GlassInterfaceMoreButton}"
                               Placement="Bottom"
                               VerticalOffset="8"
                               ShouldUseOverlayLayer="True"
                               IsLightDismissEnabled="True">
                            <controls:DaisyGlassMenu x:Name="GlassInterfaceMenu" Classes="glassScene" Width="230"
                                                     SelectionChanged="GlassInterfaceMenu_SelectionChanged">
                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <PathIcon Width="16" Height="16" Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" />
                                        <TextBlock Text="Pin" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <PathIcon Width="16" Height="16" Data="{StaticResource DaisyIconEdit}" />
                                        <TextBlock Text="Rename" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <PathIcon Width="16" Height="16" Data="{StaticResource DaisyIconCopy}" />
                                        <TextBlock Text="Duplicate" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ListBoxItem>
                                <ListBoxItem Classes="menu-separator" />
                                <ListBoxItem Classes="menu-destructive">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <PathIcon Width="16" Height="16" Data="{StaticResource DaisyIconDelete}" />
                                        <TextBlock Text="Delete" VerticalAlignment="Center" />
                                    </StackPanel>
                                </ListBoxItem>
                            </controls:DaisyGlassMenu>
                        </Popup>
                    </Grid>
                </Border>
            </StackPanel>

            <controls:DaisyDivider />

            <!-- Glass Card -->
            <StackPanel Spacing="12">
                <local:SectionHeader SectionId="glass-card" Title="Glass Card (Real Blur)" />
                <TextBlock
                    Text="Using DaisyGlass with SkiaSharp blur for real frosted glass effect. Requires Desktop/Skia platform."
                    Opacity="0.7" controls:FlowerySizeManager.ResponsiveFont="Primary" />
                <Border CornerRadius="16" MinHeight="320" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#667eea" Offset="0" />
                            <GradientStop Color="#764ba2" Offset="0.5" />
                            <GradientStop Color="#f093fb" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <!-- Background content to demonstrate glass blur effect -->
                        <StackPanel Margin="20">
                            <TextBlock Text="BACKGROUND TEXT" FontSize="32" FontWeight="Black"
                                Foreground="White" Opacity="0.9" />
                            <TextBlock Text="This text is being blurred through the glass panels"
                                FontSize="16" Foreground="White" Opacity="0.8" Margin="0,8,0,0" />
                            <TextBlock
                                Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco."
                                FontSize="14" Foreground="White" Opacity="0.7" Margin="0,56,0,0"
                                TextWrapping="Wrap" Width="500" />
                        </StackPanel>
                        <TextBlock Text="BLUR" FontSize="72" FontWeight="Black"
                            Foreground="#40FFFFFF"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" />
                        <TextBlock Text="●●●" FontSize="48" Foreground="White" Opacity="0.5"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,8" />

                        <!-- Glass panels with real blur on top; each left margin leaves room for the panel's free stars. -->
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="32">
                            <Grid Margin="90,10,10,24">
                                <Grid Classes="glassStars" ColumnDefinitions="40,40,*,*,*,*">
                                    <TextBlock />
                                    <TextBlock Grid.Column="1" />
                                    <TextBlock Grid.Column="2" />
                                    <TextBlock Grid.Column="3" />
                                    <TextBlock Grid.Column="4" />
                                    <TextBlock Grid.Column="5" />
                                </Grid>
                                <controls:DaisyGlass Padding="20" CornerRadius="16"
                                    Width="240"
                                    EnableBackdropBlur="True" BlurMode="SkiaSharp" GlassBlur="15"
                                    GlassTint="#FFFFFF" GlassTintOpacity="0.15"
                                    GlassBorderOpacity="0.3">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Glass Panel" FontWeight="Bold" FontSize="18" />
                                        <TextBlock Text="Real SkiaSharp blur at GlassBlur=15"
                                            TextWrapping="Wrap" />
                                        <controls:DaisyButton Content="Action" Size="Small"
                                            HorizontalAlignment="Right" Margin="0,8,0,0" />
                                    </StackPanel>
                                </controls:DaisyGlass>
                            </Grid>

                            <Grid Margin="90,10,10,24">
                                <Grid Classes="glassStars" ColumnDefinitions="40,40,*,*,*,*">
                                    <TextBlock />
                                    <TextBlock Grid.Column="1" />
                                    <TextBlock Grid.Column="2" />
                                    <TextBlock Grid.Column="3" />
                                    <TextBlock Grid.Column="4" />
                                    <TextBlock Grid.Column="5" />
                                </Grid>
                                <controls:DaisyGlass Padding="20" CornerRadius="16"
                                    Width="240"
                                    EnableBackdropBlur="True" BlurMode="SkiaSharp" GlassBlur="25"
                                    GlassTint="#1a1a2e" GlassTintOpacity="0.5"
                                    GlassBorderOpacity="0.2">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Dark Glass" FontWeight="Bold" FontSize="18"
                                            Foreground="White" />
                                        <TextBlock Text="Darker tint with GlassBlur=25"
                                            TextWrapping="Wrap" Foreground="White" Opacity="0.9" />
                                    </StackPanel>
                                </controls:DaisyGlass>
                            </Grid>
                        </WrapPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <controls:DaisyDivider />

            <!-- DaisyGlass Control - Liquid Glass -->
            <StackPanel Spacing="12">
                <local:SectionHeader SectionId="daisyglass-liquid"
                    Title="DaisyGlass (Liquid Glass)" />
                <TextBlock
                    Text="SkiaSharp mode with depth, curvature, bend, and dispersion controls."
                    Opacity="0.7" controls:FlowerySizeManager.ResponsiveFont="Primary" />
                <Border CornerRadius="16" MinHeight="340" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#0ea5e9" Offset="0" />
                            <GradientStop Color="#7c3aed" Offset="0.45" />
                            <GradientStop Color="#fb7185" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Margin="24" Spacing="10">
                            <TextBlock Text="LIQUID REFRACTION" FontSize="32"
                                FontWeight="Black" Foreground="White" Opacity="0.9" />
                            <TextBlock Text="Depth  Curvature  Bend  Dispersion"
                                FontSize="16" Foreground="White" Opacity="0.8" />
                            <WrapPanel Orientation="Horizontal">
                                <Border Width="92" Height="44" CornerRadius="10"
                                    Background="#80FFFFFF" Margin="0,0,10,10">
                                    <TextBlock Text="D0.85" FontWeight="Bold"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="92" Height="44" CornerRadius="10"
                                    Background="#80A7F3D0" Margin="0,0,10,10">
                                    <TextBlock Text="C0.80" FontWeight="Bold"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="92" Height="44" CornerRadius="10"
                                    Background="#80FDE68A" Margin="0,0,10,10">
                                    <TextBlock Text="B0.65" FontWeight="Bold"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Border Width="92" Height="44" CornerRadius="10"
                                    Background="#80FBCFE8" Margin="0,0,10,10">
                                    <TextBlock Text="RGB" FontWeight="Bold"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <TextBlock Text="LIQUID" FontSize="76" FontWeight="Black"
                            Foreground="#30FFFFFF"
                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20" />

                        <!-- Each left margin leaves room for the panel's free stars; the covered stars show the rim bend. -->
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            VerticalAlignment="Center" Margin="32">
                            <Grid Margin="90,10,10,24">
                                <Grid Classes="glassStars" ColumnDefinitions="40,40,*,*,*,*">
                                    <TextBlock />
                                    <TextBlock Grid.Column="1" />
                                    <TextBlock Grid.Column="2" />
                                    <TextBlock Grid.Column="3" />
                                    <TextBlock Grid.Column="4" />
                                    <TextBlock Grid.Column="5" />
                                </Grid>
                                <controls:DaisyGlass Padding="22" CornerRadius="22"
                                    Width="260"
                                    EnableBackdropBlur="True" BlurMode="SkiaSharp"
                                    GlassBlur="28" GlassSaturation="1.15"
                                    GlassTint="#FFFFFF" GlassTintOpacity="0.12"
                                    GlassReflectDegree="35" GlassReflectOpacity="0.28"
                                    GlassDepth="0.85" GlassCurvature="0.8"
                                    GlassBend="0.65" GlassDispersion="0.28">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Convex Lens" FontWeight="Bold"
                                            FontSize="18" />
                                        <TextBlock Text="Strong rim bend with chromatic edge split."
                                            TextWrapping="Wrap" />
                                        <controls:DaisyButton Content="Preview" Size="Small"
                                            HorizontalAlignment="Right" Margin="0,8,0,0" />
                                    </StackPanel>
                                </controls:DaisyGlass>
                            </Grid>

                            <Grid Margin="90,10,10,24">
                                <Grid Classes="glassStars" ColumnDefinitions="40,40,*,*,*,*">
                                    <TextBlock />
                                    <TextBlock Grid.Column="1" />
                                    <TextBlock Grid.Column="2" />
                                    <TextBlock Grid.Column="3" />
                                    <TextBlock Grid.Column="4" />
                                    <TextBlock Grid.Column="5" />
                                </Grid>
                                <controls:DaisyGlass Padding="22" CornerRadius="22"
                                    Width="260"
                                    EnableBackdropBlur="True" BlurMode="SkiaSharp"
                                    GlassBlur="20" GlassSaturation="0.85"
                                    GlassTint="#111827" GlassTintOpacity="0.38"
                                    GlassReflectDegree="135" GlassReflectOpacity="0.22"
                                    GlassDepth="0.55" GlassCurvature="0.45"
                                    GlassBend="0.35" GlassDispersion="0.12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Dark Lens" FontWeight="Bold"
                                            FontSize="18" Foreground="White" />
                                        <TextBlock Text="Lower curvature with a softer liquid rim."
                                            TextWrapping="Wrap" Foreground="White" Opacity="0.9" />
                                    </StackPanel>
                                </controls:DaisyGlass>
                            </Grid>
                        </WrapPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <controls:DaisyDivider />

            <!-- DaisyGlass Control - Bitmap Capture Mode -->
            <StackPanel Spacing="12">
                <local:SectionHeader SectionId="daisyglass-bitmap-capture"
                    Title="DaisyGlass (Bitmap Capture Mode)" />
                <TextBlock Text="BlurMode=BitmapCapture. Captures background once and blurs it." Opacity="0.7" controls:FlowerySizeManager.ResponsiveFont="Primary" />
                <TextBlock Text="✅ Good quality blur, works without SkiaSharp GPU shaders" FontSize="12" Foreground="Green" Opacity="0.8" Margin="0,-8,0,0"/>
                <TextBlock Text="❌ Static snapshot (doesn't update if content moves), slower initial render" FontSize="12" Foreground="Red" Opacity="0.8" Margin="0,-8,0,0"/>
                <Border CornerRadius="16" Height="280" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#667eea" Offset="0"/>
                            <GradientStop Color="#f093fb" Offset="0.5"/>
                            <GradientStop Color="#f5576c" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Margin="20">
                            <TextBlock Text="BACKGROUND TEXT" FontSize="32" FontWeight="Black" Foreground="White" Opacity="0.9"/>
                            <TextBlock Text="This text is blurred through the glass" FontSize="16" Foreground="White" Opacity="0.8" Margin="0,8,0,0"/>
                            <TextBlock Text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore."
                                       FontSize="14" Foreground="#404040" Opacity="0.9" Margin="0,56,0,0" TextWrapping="Wrap" Width="500"/>
                        </StackPanel>
                        <TextBlock Text="SHARP" FontSize="72" FontWeight="Black" Foreground="#40FFFFFF"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20"/>

                        <!-- Each left margin leaves room for the panel's free stars. -->
                        <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="32">
                            <Grid Margin="90,10,10,24">
                                <Grid Classes="glassStars" ColumnDefinitions="40,40,*,*,*,*">
                                    <TextBlock />
                                    <TextBlock Grid.Column="1" />
                                    <TextBlock Grid.Column="2" />
                                    <TextBlock Grid.Column="3" />
                                    <TextBlock Grid.Column="4" />
                                    <TextBlock Grid.Column="5" />
                                </Grid>
                                <controls:DaisyGlass Padding="24" CornerRadius="16" Width="220"
                                                     EnableBackdropBlur="True" BlurMode="BitmapCapture" GlassBlur="10">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="Bitmap Mode" FontWeight="Bold" FontSize="18"/>
                                        <TextBlock Text="GlassBlur=10" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </controls:DaisyGlass>
                            </Grid>

                            <Grid Margin="90,10,10,24">
                                <Grid Classes="glassStars" ColumnDefinitions="40,40,*,*,*,*">
                                    <TextBlock />
                                    <TextBlock Grid.Column="1" />
                                    <TextBlock Grid.Column="2" />
                                    <TextBlock Grid.Column="3" />
                                    <TextBlock Grid.Column="4" />
                                    <TextBlock Grid.Column="5" />
                                </Grid>
                                <controls:DaisyGlass Padding="24" CornerRadius="16" Width="220"
                                                     EnableBackdropBlur="True" BlurMode="BitmapCapture" GlassBlur="20" GlassTint="#FFFFFF" GlassTintOpacity="0.2">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="With Tint" FontWeight="Bold" FontSize="18"/>
                                        <TextBlock Text="GlassBlur=20" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </controls:DaisyGlass>
                            </Grid>
                        </WrapPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <controls:DaisyDivider />

            <!-- Full Width Example -->
            <StackPanel Spacing="12">
                <local:SectionHeader SectionId="daisyglass-full-width"
                    Title="DaisyGlass (Full Width Example)" />
                <TextBlock Text="Blur=30, Saturation=0.5 (Milky Effect)" Opacity="0.7" controls:FlowerySizeManager.ResponsiveFont="Primary" />
                <Border CornerRadius="16" Height="280" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                            <GradientStop Color="#11998e" Offset="0"/>
                            <GradientStop Color="#38ef7d" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <StackPanel Margin="20">
                            <TextBlock Text="FULL WIDTH TEST" FontSize="32" FontWeight="Black" Foreground="White" Opacity="0.9"/>
                            <TextBlock Text="Testing SkiaSharp GPU blur + Saturation" FontSize="16" Foreground="White" Opacity="0.8" Margin="0,8,0,0"/>
                            <TextBlock Text="Vestibulum ante ipsum primis in faucibus orci luctus et ultrices posuere cubilia curae."
                                       FontSize="14" Foreground="#2D4A3E" Opacity="0.9" Margin="0,56,0,0" TextWrapping="Wrap" Width="500"/>
                        </StackPanel>
                        <TextBlock Text="GPU" FontSize="72" FontWeight="Black" Foreground="#40FFFFFF"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="20"/>

                        <!-- The wide panel keeps its four covered stars at its left end, clear of the GPU text. -->
                        <Grid Margin="100,40" VerticalAlignment="Center">
                            <Grid Classes="glassStars gold" ColumnDefinitions="40,40,40,40,40,40" HorizontalAlignment="Left">
                                <TextBlock />
                                <TextBlock Grid.Column="1" />
                                <TextBlock Grid.Column="2" />
                                <TextBlock Grid.Column="3" />
                                <TextBlock Grid.Column="4" />
                                <TextBlock Grid.Column="5" />
                            </Grid>
                            <controls:DaisyGlass Height="120"
                                                 EnableBackdropBlur="True" BlurMode="SkiaSharp"
                                                 GlassBlur="30" GlassSaturation="0.5"
                                                 GlassTint="#FFFFFF" GlassTintOpacity="0.15"
                                                 GlassBorderOpacity="0.3">
                                <StackPanel Spacing="8" VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <TextBlock Text="Milky Glass Panel" FontWeight="Bold" FontSize="24" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Blur=30, Sat=0.5" HorizontalAlignment="Center" Opacity="0.8"/>
                                </StackPanel>
                            </controls:DaisyGlass>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>

            <controls:DaisyDivider />

            <!-- DaisyGlass Control - SkiaSharp Mode (Experimental) -->
            <StackPanel Spacing="12">
                <local:SectionHeader SectionId="daisyglass-skia-matrix"
                    Title="DaisyGlass (SkiaSharp Mode Matrix)" />
                <TextBlock Text="BlurMode=SkiaSharp. Real-time GPU-accelerated blur with Saturation control." Opacity="0.7" controls:FlowerySizeManager.ResponsiveFont="Primary" />
                <TextBlock Text="✅ Best quality, real-time updates, saturation support" FontSize="12" Foreground="Green" Opacity="0.8" Margin="0,-8,0,0"/>
                <TextBlock Text="⚠️ Experimental, higher GPU usage" FontSize="12" Foreground="Orange" Opacity="0.8" Margin="0,-8,0,0"/>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <Border CornerRadius="16" MinHeight="320" ClipToBounds="True">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                <GradientStop Color="#11998e" Offset="0"/>
                                <GradientStop Color="#38ef7d" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <Grid>
                            <!-- Background Pattern -->
                            <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <!-- Clean background, content is now inside tiles -->
                            </Canvas>

                            <!-- Matrix Container -->
                            <StackPanel x:Name="SkiaMatrixContainer"
                                        Orientation="Vertical"
                                        Spacing="8"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Margin="20"/>
                        </Grid>
                    </Border>
                </ScrollViewer>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
