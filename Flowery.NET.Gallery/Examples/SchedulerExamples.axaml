<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
             xmlns:loc="clr-namespace:Flowery.NET.Gallery.Localization"
             x:Class="Flowery.NET.Gallery.Examples.SchedulerExamples">
    <Grid x:Name="PageGrid" Margin="24,0,24,16" RowDefinitions="Auto,*,Auto" RowSpacing="12">
        <!-- On Android the category title bar folds this panel away; see ICollapsibleIntroExample. -->
        <StackPanel x:Name="IntroPanel" Spacing="12">
            <TextBlock Text="{loc:Localize Scheduler_Description}" TextWrapping="Wrap"
                       controls:FlowerySizeManager.ResponsiveFont="Primary"
                       Foreground="{DynamicResource DaisyBaseContentMutedBrush}" />
            <WrapPanel Orientation="Horizontal">
                <controls:DaisyCheckBox x:Name="ResourcesOption" Content="{loc:Localize Scheduler_Resources}" Margin="0,0,16,8" />
                <controls:DaisyCheckBox x:Name="TilesOption" Content="{loc:Localize Scheduler_Tiles}" IsChecked="True" Margin="0,0,16,8" />
                <controls:DaisyCheckBox x:Name="IconsOption" Content="{loc:Localize Scheduler_Icons}" IsChecked="True" Margin="0,0,16,8" />
                <controls:DaisyCheckBox x:Name="AdornmentsOption" Content="{loc:Localize Scheduler_Adornments}" IsChecked="True" Margin="0,0,16,8" />
                <controls:DaisyCheckBox x:Name="DetailsOption" Content="{loc:Localize Scheduler_Details}" IsChecked="True" Margin="0,0,16,8" />
                <controls:DaisyCheckBox x:Name="ReadOnlyOption" Content="{loc:Localize Scheduler_ReadOnly}" Margin="0,0,16,8" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,8" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Localize Scheduler_ShowFor}" VerticalAlignment="Center" controls:FlowerySizeManager.ResponsiveFont="Primary"
                               Foreground="{DynamicResource DaisyBaseContentBrush}" />
                    <controls:DaisySelect x:Name="ShowForOption" MinWidth="140" SelectionChanged="OnShowForChanged"
                                          AutomationProperties.Name="{loc:Localize Scheduler_ShowFor}" />
                </StackPanel>
                <controls:DaisyButton Content="{loc:Localize Scheduler_Reset}" Variant="Ghost" Click="OnReset" />
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <controls:DaisyScheduler x:Name="DemoScheduler" CurrentView="Month" StateKey="gallery" />
            <!-- The editor lies over the right side of the scheduler while an appointment is created or edited. -->
            <Border x:Name="EditorPanel" IsVisible="False" Width="280" HorizontalAlignment="Right"
                    Background="{DynamicResource DaisyBase200Brush}" BorderBrush="{DynamicResource DaisyBase300Brush}"
                    BorderThickness="1" CornerRadius="8" Padding="16" BoxShadow="0 4 16 0 #50000000">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- The right margin keeps the fields clear of the scrollbar, which lies over the content. -->
                    <StackPanel Spacing="12" Margin="0,0,16,0">
                        <TextBlock Text="{loc:Localize Scheduler_Editor}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                   controls:FlowerySizeManager.ResponsiveFont="SectionHeader" />
                        <controls:DaisyInput x:Name="SubjectInput" Label="{loc:Localize Scheduler_Subject}" />
                        <!-- Date and time share a row below their label. -->
                        <TextBlock Text="{loc:Localize Scheduler_Start}" Foreground="{DynamicResource DaisyBaseContentBrush}"
                                   controls:FlowerySizeManager.ResponsiveFont="Primary" Margin="0,0,0,-8" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <controls:DaisyCalendarDatePicker x:Name="StartInput" HorizontalAlignment="Stretch"
                                                              AutomationProperties.Name="{loc:Localize Scheduler_Start}" />
                            <controls:DaisySelect x:Name="StartTimeInput" Grid.Column="1"
                                                  AutomationProperties.Name="{loc:Localize Scheduler_StartTime}" />
                        </Grid>
                        <TextBlock Text="{loc:Localize Scheduler_End}" Foreground="{DynamicResource DaisyBaseContentBrush}"
                                   controls:FlowerySizeManager.ResponsiveFont="Primary" Margin="0,0,0,-8" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <controls:DaisyCalendarDatePicker x:Name="EndInput" HorizontalAlignment="Stretch"
                                                              AutomationProperties.Name="{loc:Localize Scheduler_End}" />
                            <controls:DaisySelect x:Name="EndTimeInput" Grid.Column="1"
                                                  AutomationProperties.Name="{loc:Localize Scheduler_EndTime}" />
                        </Grid>
                        <controls:DaisySelect x:Name="SpanModeInput" AutomationProperties.Name="{loc:Localize Scheduler_SpanMode}" />
                        <TextBlock Text="{loc:Localize Scheduler_SpanHelp}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource DaisyBaseContentMutedBrush}"
                                   controls:FlowerySizeManager.ResponsiveFont="Secondary" />
                        <TextBlock Text="{loc:Localize Scheduler_Note}" Foreground="{DynamicResource DaisyBaseContentBrush}"
                                   controls:FlowerySizeManager.ResponsiveFont="Primary" />
                        <controls:DaisyTextArea x:Name="DescriptionInput" MinHeight="80" />
                        <controls:DaisyCheckBox x:Name="AllDayInput" Content="{loc:Localize Scheduler_AllDay}" IsCheckedChanged="OnAllDayChanged" />
                        <controls:DaisySelect x:Name="ResourceInput" AutomationProperties.Name="{loc:Localize Scheduler_Resource}" />
                        <StackPanel x:Name="ColorPanel" Spacing="6">
                            <TextBlock Text="{loc:Localize Scheduler_Color}" Foreground="{DynamicResource DaisyBaseContentBrush}"
                                       controls:FlowerySizeManager.ResponsiveFont="Primary" />
                            <controls:DaisySelect x:Name="ColorInput" AutomationProperties.Name="{loc:Localize Scheduler_Color}" />
                        </StackPanel>
                        <TextBlock x:Name="EditorError" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource DaisyErrorForegroundBrush}"
                                   controls:FlowerySizeManager.ResponsiveFont="Secondary" />
                        <TextBlock x:Name="OverlapWarning" TextWrapping="Wrap" IsVisible="{Binding $self.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="{DynamicResource DaisyBaseContentBrush}"
                                   controls:FlowerySizeManager.ResponsiveFont="Primary" />
                        <controls:DaisyButton x:Name="SaveAnywayButton" IsVisible="False" Content="{loc:Localize Scheduler_SaveAnyway}"
                                              Variant="Warning" Click="OnSaveAnyway" />
                        <WrapPanel Orientation="Horizontal">
                            <controls:DaisyButton Content="{loc:Localize Scheduler_Save}" Variant="Primary" Click="OnSave" Margin="0,0,8,0" />
                            <controls:DaisyButton Content="{loc:Localize Scheduler_Cancel}" Variant="Ghost" Click="OnCancel" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="2" TextWrapping="Wrap"
                   Foreground="{DynamicResource DaisyBaseContentMutedBrush}"
                   controls:FlowerySizeManager.ResponsiveFont="Secondary" />
    </Grid>
</UserControl>
