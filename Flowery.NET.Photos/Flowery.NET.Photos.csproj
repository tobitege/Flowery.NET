<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Flowery.NET\Flowery.NET.csproj" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" WithCulture="false" />
    <AvaloniaResource Include="..\Flowery.NET.Gallery\Assets\Fonts\*" Link="Assets\Fonts\%(Filename)%(Extension)" />
    <Content Include="..\Flowery.NET.Gallery\Assets\wallpaper_*.jpg;..\Flowery.NET.Gallery\Assets\tile_*.jpg;..\Flowery.NET.Gallery\Assets\placeholder1.jpg">
      <Link>Assets\Samples\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
