<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Flowery.NET.Photos.Views"
        x:Class="Flowery.NET.Photos.MainWindow"
        AutomationProperties.AutomationId="Photos.MainWindow"
        Title="Flowery Photos" Width="1180" Height="850" MinWidth="650" MinHeight="550"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="42">
  <views:PhotosShell x:Name="Shell" Margin="0,42,0,0" />
</Window>
