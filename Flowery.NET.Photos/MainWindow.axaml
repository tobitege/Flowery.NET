<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:Flowery.NET.Photos.Views"
        xmlns:c="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
        x:Class="Flowery.NET.Photos.MainWindow"
        AutomationProperties.AutomationId="Photos.MainWindow"
        Icon="avares://Flowery.NET.Photos/app_icon.ico"
        Title="Flowery Photos" Width="1180" Height="850" MinWidth="650" MinHeight="550"
        ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="42">
  <Grid>
    <views:PhotosShell x:Name="Shell" Margin="0,42,0,0" />
    <c:DaisyButton x:Name="TitleViewButton" IsVisible="False" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,3,148,0" Classes="toolbar-icon" IconSymbol="Setting" AutomationProperties.AutomationId="Photos.TitleView" />
  </Grid>
</Window>
