<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:flowery="clr-namespace:Flowery;assembly=Flowery.NET"
             xmlns:controls="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
             x:Class="Flowery.NET.Photos.App">
  <Application.Resources>
    <FontFamily x:Key="PhotosFont">fonts:Flowery.NET.Photos#Noto Sans, fonts:Flowery.NET.Photos#Noto Sans CJK SC, fonts:Flowery.NET.Photos#Noto Sans CJK JP, fonts:Flowery.NET.Photos#Noto Sans CJK KR, fonts:Flowery.NET.Photos#Noto Sans Arabic</FontFamily>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <flowery:DaisyUITheme />
    <Style Selector="Window">
      <Setter Property="FontFamily" Value="{StaticResource PhotosFont}" />
      <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
      <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="controls:FlowerySizeManager.ResponsiveFont" Value="Primary" />
    </Style>
    <Style Selector="TextBlock.heading">
      <Setter Property="controls:FlowerySizeManager.ResponsiveFont" Value="Header" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.section-heading">
      <Setter Property="controls:FlowerySizeManager.ResponsiveFont" Value="SectionHeader" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="controls|DaisyCard.photo-card">
      <Setter Property="Background" Value="{DynamicResource DaisyBase200Brush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource DaisyBase300Brush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="BodyPadding" Value="16" />
      <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <Style Selector="controls|DaisyCard.photo-card:pointerover, controls|DaisyCard.photo-card:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource PhotosAccentBrush}" />
    </Style>
    <Style Selector="controls|DaisyButton">
      <Setter Property="Variant" Value="Primary" />
    </Style>
    <Style Selector="controls|DaisyButton.rail">
      <Setter Property="Variant" Value="Ghost" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="8" />
      <Setter Property="Shape" Value="Square" />
    </Style>
    <Style Selector="controls|DaisyButton.toolbar-icon">
      <Setter Property="Variant" Value="Ghost" />
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Padding" Value="6" />
      <Setter Property="Shape" Value="Square" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ListBoxItem">
      <Setter Property="Padding" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Focusable" Value="False" />
    </Style>
  </Application.Styles>
</Application>
