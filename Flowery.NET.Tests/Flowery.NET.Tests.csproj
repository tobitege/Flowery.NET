<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="ProTest.Avalonia.Headless.XUnit.v4" Version="12.1.4" />
    <PackageReference Include="Avalonia.Markup.Xaml.Loader" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="coverlet.collector" Version="10.1.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Flowery.NET\Flowery.NET.csproj" />
    <ProjectReference Include="..\Flowery.NET.Kanban\Flowery.NET.Kanban.csproj" />
    <ProjectReference Include="..\Flowery.NET.Skia\Flowery.NET.Skia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="LocalizationProbe.en.json"
                      LogicalName="$(AssemblyName).Localization.en.json"
                      WithCulture="false" />
    <EmbeddedResource Include="LocalizationProbe.de.json"
                      LogicalName="$(AssemblyName).Localization.de.json"
                      WithCulture="false" />
  </ItemGroup>

</Project>
