<?xml version="1.0" encoding="UTF-8" ?>
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:CompileBindings="False"
        xmlns:controls="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
        xmlns:kanban="clr-namespace:Flowery.NET.Kanban.Controls"
        xmlns:kanbanConverters="clr-namespace:Flowery.NET.Kanban.Converters"
        xmlns:services="clr-namespace:Flowery.Services;assembly=Flowery.NET">
    <!-- Kanban -->
    <Styles.Resources>
        <kanbanConverters:KanbanTasksHostMarginConverter x:Key="KanbanTasksHostMarginConverter" />
        <kanbanConverters:KanbanTasksListBoxPaddingConverter x:Key="KanbanTasksListBoxPaddingConverter" />

        <DataTemplate x:Key="KanbanUserAvatarContentTemplate">
            <Grid>
                <Image Source="{Binding AvatarSource}"
                       Stretch="UniformToFill"
                       IsVisible="{Binding IsAvatarPlaceholder, Converter={x:Static BoolConverters.Not}}" />
                <TextBlock Text="{Binding Initials}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           IsVisible="{Binding IsAvatarPlaceholder}" />
            </Grid>
        </DataTemplate>

    <ControlTheme x:Key="KanbanTasksListBoxItemContainerTheme" TargetType="ListBoxItem">
        <!-- Remove the default item padding so cards can align with the task viewport. -->
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
    </ControlTheme>

    <ControlTheme x:Key="{x:Type kanban:FlowTaskCard}" TargetType="kanban:FlowTaskCard">
        <Setter Property="Background"
                Value="{DynamicResource DaisyBase200Brush}" />
        <Setter Property="Foreground"
                Value="{DynamicResource DaisyBaseContentBrush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource DaisyBase300Brush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="12" />
        <Setter Property="Margin"
                Value="0" />
        <Setter Property="CornerRadius"
                Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="PART_Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="PART_HeaderStrip"
                                    Grid.Row="0"
                                    Background="{DynamicResource DaisyInfoBrush}"
                                    CornerRadius="6"
                                    Padding="8,4">
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel x:Name="PART_WorkItemStack"
                                                Orientation="Horizontal"
                                                Spacing="6"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasWorkItemNumber, RelativeSource={RelativeSource TemplatedParent}}">
                                        <TextBlock Text="{TemplateBinding WorkItemNumberText}"
                                                   Foreground="{DynamicResource DaisyInfoContentBrush}"
                                                   FontSize="12" />
                                        <Border Width="1"
                                                Height="12"
                                                Background="{DynamicResource DaisyInfoContentBrush}"
                                                Opacity="0.4" />
                                    </StackPanel>
                                    <TextBlock x:Name="PART_TitleText"
                                               Grid.Column="1"
                                               Text="{TemplateBinding Title}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DaisyInfoContentBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <controls:DaisyBadge x:Name="PART_ActionPill"
                                                 Grid.Row="0"
                                                 Variant="Accent"
                                                 Size="ExtraSmall"
                                                 Padding="6,0"
                                                 CornerRadius="6"
                                                 HorizontalAlignment="{TemplateBinding ActionPillHorizontalAlignment}"
                                                 VerticalAlignment="Top"
                                                 Opacity="{TemplateBinding ActionPillOpacity}"
                                                 IsHitTestVisible="{Binding IsActionPillVisible, RelativeSource={RelativeSource TemplatedParent}}"

                                                 IsVisible="True">
                                <controls:DaisyBadge.RenderTransform>
                                    <TranslateTransform X="{Binding ActionPillOffsetX, RelativeSource={RelativeSource TemplatedParent}}"
                                                        Y="-6" />
                                </controls:DaisyBadge.RenderTransform>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="2"
                                            VerticalAlignment="Center">
                                    <controls:DaisyIconText IconData="{StaticResource DaisyIconCheck}"
                                                            IconSize="10"
                                                            Foreground="{DynamicResource DaisyAccentContentBrush}"
                                                            Focusable="False"
                                                            IsVisible="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <controls:DaisyButton
                                                          x:Name="PART_CloseBtn"
                                                          Command="{TemplateBinding CloseCommand}"
                                                          CommandParameter="{TemplateBinding CloseCommandParameter}"
                                                          Variant="Ghost"
                                                          Shape="Square"
                                                          Size="ExtraSmall"

                                                          Background="Transparent"
                                                          BorderBrush="Transparent"
                                                          Foreground="{DynamicResource DaisyAccentContentBrush}"
                                                          Opacity="0"
                                                          IsHitTestVisible="False"

                                                          Padding="0"
                                                          MinWidth="0"
                                                          MinHeight="0"
                                                          Width="16"
                                                          Height="16"
                                                          Focusable="True">
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconClose}"
                                                                IconSize="10"
                                                                Foreground="{DynamicResource DaisyAccentContentBrush}"
                                                                Margin="0,-1,0,1"
                                                                Focusable="False" />
                                    </controls:DaisyButton>
                                </StackPanel>
                            </controls:DaisyBadge>
                            <Grid Grid.Row="1"
                                  Margin="0,4,0,0"
                                  ColumnSpacing="8"
                                  IsVisible="{Binding IsBlocked, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource DaisyWarningBrush}"
                                        CornerRadius="10"
                                        Padding="4,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding BlockedBadgeText}"
                                               Foreground="{DynamicResource DaisyWarningContentBrush}"
                                               FontSize="12" />
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{TemplateBinding BlockedDetailText}"
                                           FontSize="12"
                                           Foreground="{TemplateBinding Foreground}"
                                           TextWrapping="Wrap" />
                            </Grid>
                            <ContentPresenter Grid.Row="2"
                                              Content="{TemplateBinding Content}"
                                              Margin="0,4,0,0" />
                            <kanban:FlowKanbanWrapPanel Grid.Row="3"
                                                Orientation="Horizontal"
                                                Spacing="12"
                                                Margin="0,6,0,0">
                                <controls:DaisyBadge Variant="Ghost"
                                                     Size="Small"
                                                     Padding="4,0"
                                                     Opacity="0.85"
                                                     HorizontalContentAlignment="Left"
                                                     HorizontalAlignment="Left"
                                                     IsVisible="{Binding HasPriority, RelativeSource={RelativeSource TemplatedParent}}">
                                    <controls:DaisyBadge.RenderTransform>
                                        <TranslateTransform X="-4" />
                                    </controls:DaisyBadge.RenderTransform>
                                    <controls:DaisyIconText Text="{TemplateBinding PriorityText}"
                                                            Variant="Ghost"
                                                            Focusable="False" />
                                </controls:DaisyBadge>
                                <controls:DaisyBadge Variant="Ghost"
                                                     Size="Small"
                                                     Padding="4,0"
                                                     Opacity="0.85"
                                                     HorizontalContentAlignment="Left"
                                                     HorizontalAlignment="Left"
                                                     IsVisible="{Binding HasSubtaskSummary, RelativeSource={RelativeSource TemplatedParent}}">
                                    <controls:DaisyBadge.RenderTransform>
                                        <TranslateTransform X="-4" />
                                    </controls:DaisyBadge.RenderTransform>
                                    <controls:DaisyIconText IconData="{StaticResource DaisyIconDataDisplay}"
                                                            IconSize="12"
                                                            Text="{TemplateBinding SubtaskSummaryText}"
                                                            Variant="Ghost"
                                                            Focusable="False" />
                                </controls:DaisyBadge>
                            </kanban:FlowKanbanWrapPanel>
                            <Grid Grid.Row="4"
                                  Margin="0,8,0,0"
                                  ColumnSpacing="10"
                                  RowSpacing="2"
                                  IsVisible="{Binding HasFooter, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:DaisyAvatar Grid.Row="0"
                                                      Grid.RowSpan="2"
                                                      Grid.Column="0"
                                                      Size="ExtraSmall"
                                                      IsPlaceholder="True"
                                                      VerticalAlignment="Center"
                                                      IsVisible="{Binding HasAssignee, RelativeSource={RelativeSource TemplatedParent}}">
                                    <TextBlock Text="{TemplateBinding AssigneeInitials}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </controls:DaisyAvatar>
                                <StackPanel Grid.Row="0"
                                            Grid.Column="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            VerticalAlignment="Center">
                                    <controls:DaisyIconText IconData="{StaticResource DaisyIconDateDisplay}"
                                                            IconSize="12"
                                                            Text="{TemplateBinding StartDateText}"
                                                            Foreground="{TemplateBinding Foreground}"
                                                            Variant="Ghost"
                                                            Focusable="False"
                                                            IsVisible="{Binding HasStartDate, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToolTip.Tip>
                                            <ToolTip Content="{Binding ProgressText, RelativeSource={RelativeSource TemplatedParent}}" />
                                        </ToolTip.Tip>
                                    </controls:DaisyIconText>
                                    <Border Width="1"
                                            Height="12"
                                            Background="{TemplateBinding Foreground}"
                                            Opacity="0.35"
                                            IsVisible="{Binding HasDateRange, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <controls:DaisyIconText IconData="{StaticResource DaisyIconDateDisplay}"
                                                            IconSize="12"
                                                            Text="{TemplateBinding EndDateText}"
                                                            Foreground="{TemplateBinding Foreground}"
                                                            Variant="Ghost"
                                                            Focusable="False"
                                                            IsVisible="{Binding HasEndDate, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToolTip.Tip>
                                            <ToolTip Content="{Binding ProgressText, RelativeSource={RelativeSource TemplatedParent}}" />
                                        </ToolTip.Tip>
                                    </controls:DaisyIconText>
                                </StackPanel>
                                <Grid Grid.Row="1"
                                      Grid.Column="1"
                                      ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{TemplateBinding AssigneeText}"
                                               Foreground="{TemplateBinding Foreground}"
                                               FontSize="12"
                                               IsVisible="{Binding HasAssignee, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <controls:DaisyBadge Grid.Column="1"
                                                         Variant="Neutral"
                                                         Size="Small"
                                                         Padding="6,0"
                                                         Background="{DynamicResource DaisyNeutralBrush}"
                                                         Foreground="{DynamicResource DaisyNeutralContentBrush}"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Center"
                                                         IsVisible="{Binding HasProgress, RelativeSource={RelativeSource TemplatedParent}}">
                                        <TextBlock Text="{TemplateBinding ProgressText}"
                                                   Foreground="{DynamicResource DaisyNeutralContentBrush}"
                                                   FontSize="12" />
                                    </controls:DaisyBadge>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^.keyboard-focus /template/ Border#PART_Root">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisyAccentBrush}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type kanban:FlowKanbanAddCard}" TargetType="kanban:FlowKanbanAddCard">
        <Setter Property="HorizontalAlignment"
                Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid>
                        <!-- Add Button (visible when not editing) -->
                        <controls:DaisyButton
                                              x:Name="PART_AddButton"
                                              Variant="Ghost"
                                              HorizontalAlignment="Stretch">
                            <controls:DaisyIconText IconData="{StaticResource DaisyIconPlus}"
                                                    IconSize="12"
                                                    Text="{TemplateBinding AddCardText}" />
                        </controls:DaisyButton>
                        <!-- Input Panel (visible when editing) -->
                        <Grid x:Name="PART_InputPanel"
                              IsVisible="False">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <controls:DaisyInput
                                                 x:Name="PART_TitleInput"
                                                 PlaceholderText="{TemplateBinding AddCardPlaceholderText}"
                                                 Variant="Bordered"
                                                 Size="Small"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap" />
                            <StackPanel Grid.Row="1"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        Margin="0,8,0,0">
                                <controls:DaisyButton
                                                      x:Name="PART_ConfirmButton"
                                                      Content="{TemplateBinding AddCardConfirmText}"
                                                      Variant="Primary"
                                                      Size="Small" />
                                <controls:DaisyButton
                                                      x:Name="PART_CancelButton"
                                                      Content="{TemplateBinding AddCardCancelText}"
                                                      Variant="Ghost"
                                                      Size="Small" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type kanban:FlowKanbanColumn}" TargetType="kanban:FlowKanbanColumn">
        <Setter Property="Background"
                Value="{DynamicResource DaisyBase200Brush}" />
        <Setter Property="BorderBrush"
                Value="{DynamicResource DaisyBase300Brush}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="Padding"
                Value="12" />
        <Setter Property="CornerRadius"
                Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border x:Name="PART_ColumnBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid DataContext="{TemplateBinding ColumnData}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Lane WIP Badge -->
                            <StackPanel x:Name="PART_LaneWipIndicator"
                                        Grid.Row="0"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        Spacing="6"
                                        IsVisible="{Binding Tag.HasLaneWipLimit, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}, FallbackValue=False}">
                                <Border Background="{DynamicResource DaisySecondaryBrush}"
                                        CornerRadius="10"
                                        Padding="6,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Tag.LaneWipDisplay, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource DaisySecondaryContentBrush}" />
                                </Border>
                                <controls:DaisyIconText IconData="{StaticResource DaisyIconWarning}"
                                                        IconSize="12"
                                                        Foreground="{DynamicResource DaisyWarningBrush}"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding Tag.IsLaneWipExceeded, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}, FallbackValue=False}">
                                    <ToolTip.Tip>
                                        <ToolTip Content="{Binding ParentKanban.Localization[Kanban_LaneWipLimitExceeded], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                 IsEnabled="{Binding ParentKanban.IsColumnTooltipsEnabled, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}" />
                                    </ToolTip.Tip>
                                </controls:DaisyIconText>
                            </StackPanel>
                            <!-- Column Header -->
                            <Grid Grid.Row="0"
                                  IsVisible="{Binding ShowColumnHeader, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}">
                                <Grid x:Name="PART_ColumnHeaderGrid"
                                      Margin="0,0,0,8"
                                      Background="Transparent"
                                      IsVisible="{Binding IsCollapsed, Converter={x:Static BoolConverters.Not}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="PART_ColumnGrip"
                                            Grid.Row="0"
                                            Background="Transparent"
                                            Padding="4"
                                            CornerRadius="4"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{Binding ParentKanban.Localization[Kanban_Column_Reorder], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}">
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconNestedSquares}"
                                                                IconSize="12"
                                                                Foreground="{Binding ElementName=PART_ColumnTitle, Path=Foreground}" />
                                    </Border>
                                    <TextBlock x:Name="PART_ColumnTitle"
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               Text="{Binding DisplayTitle}"
                                               FontSize="18"
                                               Foreground="{DynamicResource DaisyBaseContentBrush}"
                                               FontWeight="Bold"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               VerticalAlignment="Center" />
                                    <StackPanel x:Name="PART_ColumnHeaderIcons"
                                                Grid.Row="0"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="8"
                                                HorizontalAlignment="Right">
                                        <controls:DaisyBadge Variant="Neutral"
                                                             Size="Small"
                                                             Content="{Binding ParentKanban.Localization[Kanban_ArchiveColumn], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                             IsVisible="{Binding IsArchiveColumn}"
                                                             AutomationProperties.Name="{Binding ParentKanban.Localization[Kanban_ArchiveColumn], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}">
                                            <ToolTip.Tip>
                                                <ToolTip Content="{Binding ParentKanban.Localization[Kanban_ArchiveColumn], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                         IsEnabled="{Binding ParentKanban.IsColumnTooltipsEnabled, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}" />
                                            </ToolTip.Tip>
                                        </controls:DaisyBadge>
                                        <!-- Task Count Badge -->
                                        <Border x:Name="PART_TaskCountBadge"
                                                Background="{DynamicResource DaisySecondaryBrush}"
                                                CornerRadius="10"
                                                Padding="6,2"
                                                VerticalAlignment="Center">
                                            <TextBlock x:Name="PART_TaskCountText"
                                                       Text="{Binding WipDisplay}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DaisySecondaryContentBrush}" />
                                        </Border>
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconWarning}"
                                                                IconSize="12"
                                                                Foreground="{DynamicResource DaisyWarningBrush}"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding IsWipExceeded}">
                                            <ToolTip.Tip>
                                                <ToolTip Content="{Binding ParentKanban.Localization[Kanban_WipLimitExceeded], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                         IsEnabled="{Binding ParentKanban.IsColumnTooltipsEnabled, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}" />
                                            </ToolTip.Tip>
                                        </controls:DaisyIconText>
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconInfo}"
                                                                IconSize="12"
                                                                Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding HasPolicy}"
                                                                AutomationProperties.Name="{Binding ParentKanban.Localization[Kanban_Policy_Info], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}">
                                            <ToolTip.Tip>
                                                <ToolTip Content="{Binding PolicyText}"
                                                         IsEnabled="{Binding ParentKanban.IsColumnTooltipsEnabled, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}" />
                                            </ToolTip.Tip>
                                        </controls:DaisyIconText>
                                        <!-- Edit Title Button (shown on hover) -->
                                        <controls:DaisyButton
                                                              x:Name="PART_RenameBtn"
                                                              Command="{Binding ParentKanban.EditColumnCommand, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                              CommandParameter="{Binding}"
                                                              Variant="Ghost"
                                                              Shape="Square"
                                                              Size="ExtraSmall"
                                                              Opacity="0"
                                                              IsHitTestVisible="False"

                                                              VerticalAlignment="Center"
                                                              AutomationProperties.Name="{Binding ParentKanban.Localization[Kanban_RenameSection], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}">
                                            <ToolTip.Tip>
                                                <ToolTip Content="{Binding ParentKanban.Localization[Kanban_RenameSection], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                         IsEnabled="{Binding ParentKanban.IsColumnTooltipsEnabled, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}" />
                                            </ToolTip.Tip>
                                            <controls:DaisyIconText IconData="{StaticResource DaisyIconEdit}"
                                                                    IconSize="12" />
                                        </controls:DaisyButton>
                                    </StackPanel>
                                    <controls:DaisyButton
                                                          x:Name="PART_CollapseBtn"
                                                          Grid.Row="0"
                                                          Grid.Column="2"
                                                          IsVisible="{Binding ParentKanban.IsCompactLayoutEnabled, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}, Converter={x:Static BoolConverters.Not}}"
                                                          Command="{Binding ParentKanban.ToggleColumnCollapseCommand, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                          CommandParameter="{Binding}"
                                                          Variant="Ghost"
                                                          Shape="Square"
                                                          Size="ExtraSmall"
                                                          VerticalAlignment="Center"
                                                          AutomationProperties.Name="{Binding ParentKanban.Localization[Kanban_Column_ToggleCollapse], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}">
                                        <ToolTip.Tip>
                                            <ToolTip Content="{Binding ParentKanban.Localization[Kanban_Column_ToggleCollapse], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                     IsEnabled="{Binding ParentKanban.IsColumnTooltipsEnabled, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}" />
                                        </ToolTip.Tip>
                                        <controls:DaisyIconText x:Name="PART_CollapseIcon"
                                                                IconData="{StaticResource DaisyIconChevronLeft}"
                                                                IconSize="12" />
                                    </controls:DaisyButton>
                                </Grid>

                                <!-- Collapsed Header -->
                                <StackPanel x:Name="PART_CollapsedHeader"
                                            IsVisible="{Binding IsCollapsed}"
                                            Margin="0,0,0,8"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Top"
                                            Spacing="4">
                                    <controls:DaisyButton
                                                          x:Name="PART_CollapsedExpandBtn"
                                                          Variant="Ghost"
                                                          Shape="Square"
                                                          Size="ExtraSmall"
                                                          IsVisible="{Binding ParentKanban.IsCompactLayoutEnabled, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}, Converter={x:Static BoolConverters.Not}}"
                                                          Command="{Binding ParentKanban.ToggleColumnCollapseCommand, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                          CommandParameter="{Binding}"
                                                          AutomationProperties.Name="{Binding ParentKanban.Localization[Kanban_Column_ToggleCollapse], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}">
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconChevronRight}"
                                                                IconSize="12" />
                                    </controls:DaisyButton>
                                    <TextBlock x:Name="PART_CollapsedTitle"
                                               Text="{Binding DisplayTitle}"
                                               FontSize="18"
                                               Foreground="{DynamicResource DaisyBaseContentBrush}"
                                               FontWeight="Bold"
                                               TextWrapping="Wrap"
                                               TextTrimming="None"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <!-- Add Card (top) -->
                            <kanban:FlowKanbanAddCard x:Name="PART_AddCardTop"
                                                      Grid.Row="1"
                                                      ColumnData="{Binding}"
                                                      LaneId="{Binding LaneFilterId, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                      InsertAtTop="True"
                                                      AddCardText="{Binding ParentKanban.Localization[Kanban_AddCard], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                      AddCardPlaceholderText="{Binding ParentKanban.Localization[Kanban_AddCardPlaceholder], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                      AddCardConfirmText="{Binding ParentKanban.Localization[Common_Add], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                      AddCardCancelText="{Binding ParentKanban.Localization[Common_Cancel], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                      Margin="0,0,0,8"
                                                      IsVisible="{Binding ShowAddCardTop, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}" />
                            <!-- Tasks (scrollable) -->
                            <Grid Grid.Row="2"
                                  Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}, Converter={StaticResource KanbanTasksHostMarginConverter}}"
                                  IsVisible="{Binding ShowTasks, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}">
                                <ListBox x:Name="PART_TasksItemsControl"
                                          ItemsSource="{Binding TaskViews, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                          MaxHeight="{Binding TaskListMaxHeight, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"


                                          Padding="{Binding ColumnSize, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}, Converter={StaticResource KanbanTasksListBoxPaddingConverter}}"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto"

                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                          ItemContainerTheme="{StaticResource KanbanTasksListBoxItemContainerTheme}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="4"
                                                        HorizontalAlignment="Stretch">
                                                <TextBlock Text="{Binding Lane.Title}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                           IsVisible="{Binding ShowLaneHeader}" />
                                                <kanban:FlowTaskCard Title="{Binding Task.Title}"
                                                                     Task="{Binding Task}"
                                                                     Palette="{Binding Task.Palette}"
                                                                     CloseCommand="{Binding ParentKanban.RemoveCardCommand, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                                     CloseCommandParameter="{Binding Task}"
                                                                     EditCommand="{Binding ParentKanban.EditCardCommand, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                                     IsVisible="{Binding Task.IsSearchMatch}"
                                                                     HorizontalAlignment="Stretch">
                                                    <TextBlock Text="{Binding Task.Description}"
                                                               TextWrapping="Wrap"
                                                               FontSize="12" />
                                                </kanban:FlowTaskCard>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Canvas x:Name="PART_TaskDropIndicatorHost"
                                        IsHitTestVisible="False" />
                            </Grid>
                            <!-- Add Card (bottom) -->
                            <kanban:FlowKanbanAddCard x:Name="PART_AddCardBottom"
                                                      Grid.Row="3"
                                                      ColumnData="{Binding}"
                                                      LaneId="{Binding LaneFilterId, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                      AddCardText="{Binding ParentKanban.Localization[Kanban_AddCard], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                      AddCardPlaceholderText="{Binding ParentKanban.Localization[Kanban_AddCardPlaceholder], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                      AddCardConfirmText="{Binding ParentKanban.Localization[Common_Add], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                      AddCardCancelText="{Binding ParentKanban.Localization[Common_Cancel], RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}"
                                                      Margin="0,8,0,0"
                                                      IsVisible="{Binding ShowAddCardBottom, RelativeSource={RelativeSource AncestorType={x:Type kanban:FlowKanbanColumn}}}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style Selector="^.keyboard-focus /template/ Border#PART_ColumnBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisyAccentBrush}" />
        </Style>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type kanban:FlowKanbanHome}" TargetType="kanban:FlowKanbanHome">
        <Setter Property="Background"
                Value="{DynamicResource DaisyBase100Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid x:Name="PART_HomeRoot"
                          Background="{TemplateBinding Background}"
                          DataContext="{Binding Localization, RelativeSource={RelativeSource TemplatedParent}}"
                          Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <Border Padding="16">
                                <StackPanel Orientation="Vertical"
                                            Spacing="20">
                                    <StackPanel Orientation="Vertical"
                                                Spacing="4"
                                                IsVisible="{Binding IsWelcomeMessageVisible, RelativeSource={RelativeSource TemplatedParent}}">
                                        <TextBlock
                                                   FontSize="24" FontWeight="Bold"
                                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                   Text="{Binding WelcomeTitleDisplay, RelativeSource={RelativeSource TemplatedParent}}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock
                                                   FontSize="14"
                                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                   Text="{Binding WelcomeSubtitleDisplay, RelativeSource={RelativeSource TemplatedParent}}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <kanban:FlowKanbanWrapPanel Orientation="Horizontal"
                                                        HorizontalSpacing="12"
                                                        VerticalSpacing="12"
                                                        IsVisible="{Binding HasAnyBoards, RelativeSource={RelativeSource TemplatedParent}}">
                                        <controls:DaisySelect
                                                              x:Name="PART_SortSelect"

                                                              Width="200"
                                                              Variant="Bordered"
                                                              Size="Small"

                                                              SelectedIndex="{Binding SortModeIndex, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                              AutomationProperties.Name="{Binding [Kanban_Home_SortBy]}">
                                            <ToolTip.Tip>
                                                <ToolTip Content="{Binding [Kanban_Home_SortBy]}" />
                                            </ToolTip.Tip>
                                            <ComboBoxItem Content="{Binding [Kanban_Home_Sort_Recent]}" />
                                            <ComboBoxItem Content="{Binding [Kanban_Home_Sort_RecentAsc]}" />
                                            <ComboBoxItem Content="{Binding [Kanban_Home_Sort_NameAsc]}" />
                                            <ComboBoxItem Content="{Binding [Kanban_Home_Sort_NameDesc]}" />
                                        </controls:DaisySelect>
                                        <controls:DaisyInput
                                                             x:Name="PART_SearchInput"

                                                             Variant="Bordered"
                                                             Size="Small"
                                                             StartIcon="{StaticResource DaisyIconSearch}"
                                                             MinWidth="200"
                                                             Width="260"
                                                             PlaceholderText="{Binding [Kanban_Home_SearchPlaceholder]}"
                                                             AutomationProperties.Name="{Binding [Kanban_Home_SearchPlaceholder]}"
                                                             Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <controls:DaisyButton
                                                              Command="{Binding CreateBoardCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                              AutomationProperties.Name="{Binding [Kanban_Home_CreateBoard]}"
                                                              Variant="Default"
                                                              Size="Small">
                                            <controls:DaisyIconText IconData="{StaticResource DaisyIconPlus}"
                                                                    IconSize="14"
                                                                    Text="{Binding [Kanban_Home_CreateBoard]}" />
                                        </controls:DaisyButton>
                                    </kanban:FlowKanbanWrapPanel>
                                    <Border
                                            Background="{DynamicResource DaisyBase200Brush}"
                                            BorderBrush="{DynamicResource DaisyBase300Brush}"
                                            BorderThickness="1"
                                            CornerRadius="16"
                                            Padding="20"
                                            IsVisible="{Binding IsEmptyStateVisible, RelativeSource={RelativeSource TemplatedParent}}">
                                        <StackPanel Orientation="Vertical"
                                                    Spacing="12">
                                            <Border Width="40"
                                                    Height="40"
                                                    CornerRadius="999"
                                                    Background="{DynamicResource DaisyBase100Brush}"
                                                    HorizontalAlignment="Left">
                                                <controls:DaisyIconText IconData="{StaticResource DaisyIconHome}"
                                                                        IconSize="20" />
                                            </Border>
                                            <TextBlock
                                                       FontSize="18" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                       Text="{Binding [Kanban_Home_EmptyTitle]}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock
                                                       FontSize="14"
                                                       Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                       Text="{Binding [Kanban_Home_EmptyMessage]}"
                                                       TextWrapping="Wrap" />
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="12">
                                                <controls:DaisyButton

                                                                      Command="{Binding CreateBoardCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                      Content="{Binding [Kanban_Home_CreateBoard]}"
                                                                      Variant="Primary"
                                                                      Size="Small"
                                                                      AutomationProperties.Name="{Binding [Kanban_Home_CreateBoard]}" />
                                                <controls:DaisyButton

                                                                      Command="{Binding CreateDemoBoardCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                                      Content="{Binding [Kanban_Home_CreateDemo]}"
                                                                      Variant="Neutral"
                                                                      Size="Small"
                                                                      AutomationProperties.Name="{Binding [Kanban_Home_CreateDemo]}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                    <ItemsControl x:Name="PART_BoardGrid"
                                                  IsVisible="{Binding HasBoards, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ItemsSource="{Binding FilteredBoards, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <kanban:FlowKanbanWrapPanel HorizontalSpacing="16"
                                                                             VerticalSpacing="16" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <controls:DaisyCard Variant="Compact"
                                                                    BodyPadding="0"
                                                                    MinWidth="220"
                                                                    BorderBrush="{DynamicResource DaisyBase300Brush}"
                                                                    BorderThickness="1"
                                                                    HorizontalAlignment="Stretch"
                                                                    VerticalAlignment="Stretch">
                                                    <Border x:Name="PART_BoardOpenSurface"
                                                            Background="Transparent"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Stretch"
                                                            Padding="16"
                                                            MinHeight="180"
                                                            AutomationProperties.Name="{Binding Title}">
                                                        <Grid ColumnSpacing="8"
                                                              RowSpacing="12">
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Row="0"
                                                                    Grid.Column="0"
                                                                    Grid.ColumnSpan="2"
                                                                    Height="72"
                                                                    CornerRadius="12"
                                                                    Background="{DynamicResource DaisyBase200Brush}"
                                                                    HorizontalAlignment="Stretch">
                                                                <controls:DaisyIconText IconData="{StaticResource DaisyIconLayout}"
                                                                                        IconSize="20"
                                                                                        HorizontalAlignment="Center"
                                                                                        VerticalAlignment="Center" />
                                                            </Border>
                                                            <TextBlock Grid.Row="1"
                                                                       Grid.Column="0"
                                                                       Text="{Binding Title}"
                                                                       FontSize="14"
                                                                       VerticalAlignment="Center"
                                                                       TextWrapping="Wrap" />
                                                            <controls:DaisyButton

                                                                                  x:Name="PART_BoardMenuButton"
                                                                                  Grid.Row="1"
                                                                                  Grid.Column="1"
                                                                                  Variant="Ghost"
                                                                                  Shape="Square"
                                                                                  Size="ExtraSmall"
                                                                                  VerticalAlignment="Center"
                                                                                  AutomationProperties.Name="{Binding DataContext[Kanban_Home_BoardMenu], ElementName=PART_HomeRoot}"
                                                                                  >
                                                                <ToolTip.Tip>
                                                                    <ToolTip Content="{Binding DataContext[Kanban_Home_BoardMenu], ElementName=PART_HomeRoot}" />
                                                                </ToolTip.Tip>
                                                                <controls:DaisyIconText IconData="{StaticResource DaisyIconHamburger}"
                                                                                        IconSize="12" />
                                                                <controls:DaisyButton.Flyout>
                                                                    <MenuFlyout>
                                                                        <MenuItem Tag="Kanban_Home_Open" />
                                                                        <MenuItem Tag="Kanban_Home_Rename" />
                                                                        <MenuItem Tag="Kanban_Home_Duplicate" />
                                                                        <MenuItem Tag="Kanban_Home_Export" />
                                                                        <MenuItem Tag="Kanban_Home_Delete" />
                                                                    </MenuFlyout>
                                                                </controls:DaisyButton.Flyout>
                                                            </controls:DaisyButton>
                                                            <TextBlock Grid.Row="2"
                                                                       Grid.Column="0"
                                                                       Grid.ColumnSpan="2"
                                                                       Text="{Binding LastModifiedDisplay}"
                                                                       FontSize="12"
                                                                       TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </controls:DaisyCard>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type kanban:FlowKanbanUserManagement}" TargetType="kanban:FlowKanbanUserManagement">
        <Setter Property="Background"
                Value="{DynamicResource DaisyBase100Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid x:Name="PART_UsersRoot"
                          Background="{TemplateBinding Background}"
                          DataContext="{Binding Localization, RelativeSource={RelativeSource TemplatedParent}}"
                          Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                          services:FloweryResponsive.IsEnabled="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <Border Padding="16">
                                <Grid RowSpacing="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel Grid.Row="0"
                                                Orientation="Vertical"
                                                Spacing="6">
                                        <kanban:FlowKanbanWrapPanel Orientation="Horizontal"
                                                            HorizontalSpacing="14"
                                                            VerticalSpacing="0"
                                                            HorizontalAlignment="Left">
                                            <Border VerticalAlignment="Top">
                                                <TextBlock
                                                           FontSize="24" FontWeight="Bold"
                                                           Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                           Text="{Binding [Kanban_Users_Title]}"
                                                           TextAlignment="Left"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Top" />
                                            </Border>
                                            <Border VerticalAlignment="Top"
                                                    MaxWidth="{Binding (services:FloweryResponsive.ResponsiveMaxWidth), ElementName=PART_UsersRoot}">
                                                <TextBlock
                                                           FontSize="14"
                                                           Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                           Text="{Binding [Kanban_Users_Subtitle]}"
                                                           TextAlignment="Left"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Top" />
                                            </Border>
                                            <Border VerticalAlignment="Top"
                                                    MaxWidth="{Binding (services:FloweryResponsive.ResponsiveMaxWidth), ElementName=PART_UsersRoot}">
                                                <TextBlock
                                                           FontSize="14"
                                                           Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                           Text="{Binding [Kanban_Users_SingleUserNotice]}"
                                                           TextAlignment="Left"
                                                           TextWrapping="Wrap"
                                                           VerticalAlignment="Top" />
                                            </Border>
                                        </kanban:FlowKanbanWrapPanel>
                                        <StackPanel Orientation="Vertical"
                                                    Spacing="12">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                           FontSize="18" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                           Text="{Binding [Kanban_Users_Providers_Title]}" />
                                                <TextBlock Grid.Column="1"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                           HorizontalAlignment="Right">
                                                    <Run Text="{Binding Tag.ProviderCount, ElementName=PART_UsersRoot}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding [Kanban_Users_Providers_Count]}" />
                                                </TextBlock>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Tag.Providers, ElementName=PART_UsersRoot}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <kanban:FlowKanbanWrapPanel HorizontalSpacing="12"
                                                                                     VerticalSpacing="12" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <controls:DaisyCard x:Name="ProviderCard"
                                                                            Variant="Compact"
                                                                            MinWidth="240"
                                                                            BodyPadding="12"
                                                                            BorderBrush="{DynamicResource DaisyBase300Brush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="12">
                                                            <StackPanel Orientation="Vertical"
                                                                        Spacing="8">
                                                                <TextBlock FontSize="18" FontWeight="SemiBold"
                                                                           Foreground="{Binding ElementName=ProviderCard, Path=Foreground}"
                                                                           Text="{Binding DisplayName}"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock FontSize="12"
                                                                           Foreground="{Binding ElementName=ProviderCard, Path=Foreground}"
                                                                           TextWrapping="Wrap">
                                                                    <Run Text="{Binding DataContext[Kanban_Users_Provider_Key], ElementName=PART_UsersRoot}" />
                                                                    <Run Text=": " />
                                                                    <Run Text="{Binding ProviderKey}" />
                                                                </TextBlock>
                                                                <controls:DaisyButton
                                                                                      Variant="Primary"
                                                                                      Size="Small"
                                                                                      HorizontalAlignment="Left"
                                                                                      IsVisible="{Binding ShouldShowConnect}"
                                                                                      Command="{Binding Tag.ConnectGitHubCommand, ElementName=PART_UsersRoot}"
                                                                                      CommandParameter="{Binding ProviderKey}"
                                                                                      Content="{Binding DataContext[Common_Connect], ElementName=PART_UsersRoot}"
                                                                                      AutomationProperties.Name="{Binding DataContext[Common_Connect], ElementName=PART_UsersRoot}" />
                                                                <StackPanel Orientation="Horizontal"
                                                                            Spacing="8"
                                                                            HorizontalAlignment="Left"
                                                                            IsVisible="{Binding ShouldShowReconnect}">
                                                                    <controls:DaisyButton
                                                                                          Variant="Neutral"
                                                                                          Size="Small"
                                                                                          Command="{Binding Tag.ConnectGitHubCommand, ElementName=PART_UsersRoot}"
                                                                                          CommandParameter="{Binding ProviderKey}"
                                                                                          Content="{Binding DataContext[Kanban_Users_Reconnect_Button], ElementName=PART_UsersRoot}"
                                                                                          AutomationProperties.Name="{Binding DataContext[Kanban_Users_Reconnect_Button], ElementName=PART_UsersRoot}" />
                                                                    <controls:DaisyButton
                                                                                          Variant="Ghost"
                                                                                          Size="Small"
                                                                                          IsVisible="{Binding ShouldShowDisconnect}"
                                                                                          Command="{Binding Tag.DisconnectProviderCommand, ElementName=PART_UsersRoot}"
                                                                                          CommandParameter="{Binding ProviderKey}"
                                                                                          Content="{Binding DataContext[Common_Disconnect], ElementName=PART_UsersRoot}"
                                                                                          AutomationProperties.Name="{Binding DataContext[Common_Disconnect], ElementName=PART_UsersRoot}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </controls:DaisyCard>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                        <StackPanel Orientation="Vertical"
                                                    Spacing="12">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                           FontSize="18" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                           Text="{Binding [Kanban_Users_Users_Title]}" />
                                                <TextBlock Grid.Column="1"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                           HorizontalAlignment="Right">
                                                    <Run Text="{Binding Tag.UserCount, ElementName=PART_UsersRoot}" />
                                                    <Run Text=" " />
                                                    <Run Text="{Binding [Kanban_Users_Users_Count]}" />
                                                </TextBlock>
                                            </Grid>
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <controls:DaisyInput

                                                                     Grid.Column="0"
                                                                     Variant="Bordered"
                                                                     Size="Small"
                                                                     StartIcon="{StaticResource DaisyIconSearch}"
                                                                     PlaceholderText="{Binding [Kanban_Users_SearchPlaceholder]}"
                                                                     AutomationProperties.Name="{Binding [Kanban_Users_SearchPlaceholder]}"
                                                                     Text="{Binding Tag.SearchText, ElementName=PART_UsersRoot, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                <controls:DaisyButton
                                                                      Grid.Column="1"
                                                                      Command="{Binding Tag.RefreshCommand, ElementName=PART_UsersRoot}"
                                                                      AutomationProperties.Name="{Binding [Kanban_Users_Refresh]}"
                                                                      Variant="Neutral"
                                                                      Shape="Square"
                                                                      Size="Small">
                                                    <ToolTip.Tip>
                                                        <ToolTip Content="{Binding [Kanban_Users_Refresh]}" />
                                                    </ToolTip.Tip>
                                                    <controls:DaisyIconText IconData="{StaticResource DaisyIconRefresh}"
                                                                            IconSize="14" />
                                                </controls:DaisyButton>
                                            </Grid>
                                            <Border Background="{DynamicResource DaisyBase200Brush}"
                                                    BorderBrush="{DynamicResource DaisyBase300Brush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="12"
                                                    IsVisible="{Binding Tag.IsLocalProvider, ElementName=PART_UsersRoot}">
                                                <StackPanel Orientation="Vertical"
                                                            Spacing="12">
                                                    <TextBlock
                                                               FontSize="18" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                               Text="{Binding [Kanban_Users_AddLocal_Title]}" />
                                                    <Grid ColumnSpacing="8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <controls:DaisyInput

                                                                             Grid.Column="0"
                                                                             Variant="Bordered"
                                                                             Size="Small"
                                                                             PlaceholderText="{Binding [Kanban_Users_AddLocal_Name]}"
                                                                             AutomationProperties.Name="{Binding [Kanban_Users_AddLocal_Name]}"
                                                                             Text="{Binding Tag.NewUserName, ElementName=PART_UsersRoot, Mode=TwoWay}" />
                                                        <controls:DaisyInput

                                                                             Grid.Column="1"
                                                                             Variant="Bordered"
                                                                             Size="Small"
                                                                             PlaceholderText="{Binding [Kanban_Users_AddLocal_Email]}"
                                                                             AutomationProperties.Name="{Binding [Kanban_Users_AddLocal_Email]}"
                                                                             Text="{Binding Tag.NewUserEmail, ElementName=PART_UsersRoot, Mode=TwoWay}" />
                                                        <controls:DaisyButton

                                                                              Grid.Column="2"
                                                                              Command="{Binding Tag.AddUserCommand, ElementName=PART_UsersRoot}"
                                                                              Content="{Binding [Kanban_Users_AddLocal_Button]}"
                                                                              Variant="Primary"
                                                                              Size="Small"
                                                                              AutomationProperties.Name="{Binding [Kanban_Users_AddLocal_Button]}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <Grid x:Name="PART_UserLayout"
                                          Grid.Row="1"
                                          RowSpacing="16">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border x:Name="PART_UserDetailsPanel"
                                                Grid.Row="0"
                                                Background="{DynamicResource DaisyBase200Brush}"
                                                BorderBrush="{DynamicResource DaisyBase300Brush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12">
                                            <StackPanel Orientation="Vertical"
                                                        Spacing="12">
                                                <TextBlock
                                                           FontSize="18" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                           Text="{Binding [Kanban_Users_Details_Title]}" />
                                                <Border x:Name="PART_UserDetailsCard"
                                                        Background="{DynamicResource DaisyBase100Brush}"
                                                        BorderBrush="{DynamicResource DaisyBase300Brush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Padding="12"
                                                        IsVisible="{Binding Tag.HasSelection, ElementName=PART_UsersRoot}"
                                                        DataContext="{Binding Tag.SelectedUser, ElementName=PART_UsersRoot}">
                                                    <kanban:FlowKanbanWrapPanel Orientation="Horizontal"
                                                                        Spacing="16"
                                                                        VerticalSpacing="8">
                                                        <controls:DaisyAvatar Size="Large"
                                                                              IsPlaceholder="{Binding IsAvatarPlaceholder}"
                                                                              Status="{Binding AvatarStatus}"
                                                                              Content="{Binding}"
                                                                              ContentTemplate="{StaticResource KanbanUserAvatarContentTemplate}" />
                                                        <TextBlock FontSize="18" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                   Text="{Binding DisplayName}"
                                                                   TextWrapping="Wrap"
                                                                   VerticalAlignment="Top" />
                                                        <StackPanel Orientation="Vertical"
                                                                    Spacing="8"
                                                                    IsVisible="{Binding Tag.CanLinkSelectedUser, ElementName=PART_UsersRoot}">
                                                            <StackPanel Orientation="Vertical"
                                                                        Spacing="4"
                                                                        IsVisible="{Binding Tag.HasLinkedLocalUser, ElementName=PART_UsersRoot}">
                                                                <TextBlock FontSize="12"
                                                                           Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                           Text="{Binding DataContext[Kanban_Users_LinkLocal_Label], ElementName=PART_UsersRoot}"
                                                                           TextWrapping="Wrap" />
                                                               <TextBlock FontSize="14"
                                                                          Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                          Text="{Binding Tag.LinkedLocalUserName, ElementName=PART_UsersRoot}"
                                                                          TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                        <StackPanel Orientation="Vertical"
                                                                    Spacing="8"
                                                                    IsVisible="{Binding Tag.CanLinkSelectedUser, ElementName=PART_UsersRoot}">
                                                            <controls:DaisyButton
                                                                                  Command="{Binding Tag.LinkLocalUserCommand, ElementName=PART_UsersRoot}"
                                                                                  Content="{Binding DataContext[Kanban_Users_LinkLocal_Button], ElementName=PART_UsersRoot}"
                                                                                  Variant="Primary"
                                                                                  Size="Small"
                                                                                  HorizontalAlignment="Left"
                                                                                  AutomationProperties.Name="{Binding DataContext[Kanban_Users_LinkLocal_Button], ElementName=PART_UsersRoot}" />
                                                            <controls:DaisyButton
                                                                                  Command="{Binding Tag.UnlinkLocalUserCommand, ElementName=PART_UsersRoot}"
                                                                                  Content="{Binding DataContext[Kanban_Users_UnlinkLocal_Button], ElementName=PART_UsersRoot}"
                                                                                  Variant="Ghost"
                                                                                  Size="Small"
                                                                                  HorizontalAlignment="Left"
                                                                                  IsVisible="{Binding Tag.HasLinkedLocalUser, ElementName=PART_UsersRoot}"
                                                                                  AutomationProperties.Name="{Binding DataContext[Kanban_Users_UnlinkLocal_Button], ElementName=PART_UsersRoot}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Vertical"
                                                                    Spacing="8"
                                                                    IsVisible="{Binding Tag.IsLocalProvider, ElementName=PART_UsersRoot}">
                                                            <controls:DaisyButton

                                                                                  Command="{Binding Tag.RemoveUserCommand, ElementName=PART_UsersRoot}"
                                                                                  Content="{Binding DataContext[Kanban_Users_Remove_Button], ElementName=PART_UsersRoot}"
                                                                                  Variant="Error"
                                                                                  Size="Small"
                                                                                  HorizontalAlignment="Left"
                                                                                  AutomationProperties.Name="{Binding DataContext[Kanban_Users_Remove_Button], ElementName=PART_UsersRoot}" />
                                                        </StackPanel>
                                                    </kanban:FlowKanbanWrapPanel>
                                                </Border>
                                                <Border x:Name="PART_UserDetailsEmptyCard"

                                                        Background="{DynamicResource DaisyBase100Brush}"
                                                        BorderBrush="{DynamicResource DaisyBase300Brush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Padding="12"
                                                        IsVisible="{Binding Tag.IsSelectionPromptVisible, ElementName=PART_UsersRoot}">
                                                    <StackPanel Orientation="Vertical"
                                                                Spacing="8">
                                                        <TextBlock FontSize="18" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                   Text="{Binding [Kanban_Users_SelectPrompt_Title]}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock FontSize="14"
                                                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                   Text="{Binding [Kanban_Users_SelectPrompt_Message]}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="PART_UserListPanel"
                                                Grid.Row="1"
                                                Background="{DynamicResource DaisyBase200Brush}"
                                                BorderBrush="{DynamicResource DaisyBase300Brush}"
                                                BorderThickness="1"
                                                CornerRadius="12"
                                                Padding="12">
                                            <Grid RowSpacing="12">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                </Grid.RowDefinitions>
                                                <ProgressBar Grid.Row="0"
                                                             Height="4"
                                                             IsIndeterminate="True"
                                                             Foreground="{DynamicResource DaisyAccentBrush}"
                                                             IsVisible="{Binding Tag.IsLoading, ElementName=PART_UsersRoot}" />
                                                <ListBox Grid.Row="1"
                                                          ItemsSource="{Binding Tag.FilteredUsers, ElementName=PART_UsersRoot}"
                                                          SelectedItem="{Binding Tag.SelectedUser, ElementName=PART_UsersRoot, Mode=TwoWay}"
                                                          SelectionMode="Single"

                                                          MinHeight="360"
                                                          MaxHeight="720"
                                                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                    <ListBox.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <kanban:FlowKanbanWrapPanel Orientation="Horizontal"
                                                                                HorizontalSpacing="12"
                                                                                VerticalSpacing="12" />
                                                        </ItemsPanelTemplate>
                                                    </ListBox.ItemsPanel>
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <controls:DaisyCard x:Name="UserCard"
                                                                                Variant="Compact"
                                                                                BodyPadding="12"
                                                                                BorderBrush="{DynamicResource DaisyBase300Brush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="12"
                                                                                MinWidth="224"
                                                                                MaxWidth="320">
                                                                <Grid ColumnSpacing="12">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <controls:DaisyAvatar Size="Small"
                                                                                          IsPlaceholder="{Binding IsAvatarPlaceholder}"
                                                                                          Status="{Binding AvatarStatus}"
                                                                                          Content="{Binding}"
                                                                                          ContentTemplate="{StaticResource KanbanUserAvatarContentTemplate}" />
                                                                    <StackPanel Grid.Column="1"
                                                                                Orientation="Vertical"
                                                                                Spacing="4">
                                                                        <TextBlock FontSize="14"
                                                                                   Foreground="{Binding ElementName=UserCard, Path=Foreground}"
                                                                                   Text="{Binding DisplayName}"
                                                                                   TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                </Grid>
                                                            </controls:DaisyCard>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <Border
                                                        Grid.Row="1"
                                                        Background="{DynamicResource DaisyBase100Brush}"
                                                        BorderBrush="{DynamicResource DaisyBase300Brush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Padding="12"
                                                        IsVisible="{Binding Tag.IsEmptyStateVisible, ElementName=PART_UsersRoot}">
                                                    <StackPanel Orientation="Vertical"
                                                                Spacing="8">
                                                        <TextBlock FontSize="18" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                   Text="{Binding [Kanban_Users_EmptyTitle]}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock FontSize="14"
                                                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                   Text="{Binding [Kanban_Users_EmptyMessage]}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                                <Border
                                                        Grid.Row="1"
                                                        Background="{DynamicResource DaisyBase100Brush}"
                                                        BorderBrush="{DynamicResource DaisyBase300Brush}"
                                                        BorderThickness="1"
                                                        CornerRadius="12"
                                                        Padding="12"
                                                        IsVisible="{Binding Tag.IsSearchEmptyStateVisible, ElementName=PART_UsersRoot}">
                                                    <StackPanel Orientation="Vertical"
                                                                Spacing="8">
                                                        <TextBlock FontSize="18" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                   Text="{Binding [Kanban_Users_NoResultsTitle]}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock FontSize="14"
                                                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                   Text="{Binding [Kanban_Users_NoResultsMessage]}"
                                                                   TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type kanban:FlowKanban}" TargetType="kanban:FlowKanban">
        <Setter Property="Background"
                Value="{DynamicResource DaisyBase100Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid x:Name="PART_BoardRoot"
                          Background="{TemplateBinding Background}"
                          Tag="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                          DataContext="{Binding Localization, RelativeSource={RelativeSource TemplatedParent}}"
                          AutomationProperties.Name="{Binding Board.Title, RelativeSource={RelativeSource TemplatedParent}}"
                         AutomationProperties.AutomationId="Kanban_BoardRoot"
                         >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!-- Board Header -->
                        <Grid x:Name="PART_BoardHeader"
                              Grid.Row="0"
                              Margin="16,12,16,4"
                              Background="Transparent"
                              RowSpacing="4"
                              IsVisible="{Binding IsBoardViewActive, RelativeSource={RelativeSource TemplatedParent}}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PART_BoardTitle"
                                       Grid.Row="0"
                                       Grid.Column="1"
                                       Text="{Binding Board.Title, RelativeSource={RelativeSource TemplatedParent}}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource DaisyBaseContentBrush}"
                                       VerticalAlignment="Center" />
                            <!-- Board menu popover (always visible) -->
                            <controls:DaisyPopover x:Name="PART_BoardMenuPopover"
                                                   Grid.Row="0"
                                                   Grid.Column="0"
                                                   PlacementMode="Bottom"
                                                   VerticalOffset="0"
                                                   Opacity="1"
                                                   IsHitTestVisible="True"

                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   AutomationProperties.Name="{Binding [Kanban_Home_BoardMenu]}"
                                                   >
                                <ToolTip.Tip>
                                    <ToolTip Content="{Binding [Kanban_Home_BoardMenu]}" />
                                </ToolTip.Tip>
                                <controls:DaisyPopover.Resources>
                                    <ResourceDictionary>
                                        <!-- Let DaisyMenu draw the container (avoid double border). -->
                                        <SolidColorBrush x:Key="DaisyPopoverBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="DaisyPopoverBorderBrush" Color="Transparent" />
                                    </ResourceDictionary>
                                </controls:DaisyPopover.Resources>
                                <controls:DaisyPopover.TriggerContent>
                                    <controls:DaisyButton
                                                          x:Name="PART_EditBoardBtn"
                                                          Variant="Ghost"
                                                          Shape="Square"
                                                          Focusable="False"
                                                          AutomationProperties.Name="{Binding DataContext[Kanban_Home_BoardMenu], ElementName=PART_BoardRoot}"
                                                          AutomationProperties.AutomationId="Kanban_BoardMenu"
                                                         >
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconHamburger}" />
                                    </controls:DaisyButton>
                                </controls:DaisyPopover.TriggerContent>
                                <controls:DaisyPopover.PopoverContent>
                                    <controls:DaisyMenu Orientation="Vertical">
                                                <kanban:FlowKanbanActionMenuItem
                                                    Command="{Binding Tag.EditBoardCommand, ElementName=PART_BoardRoot}"
                                                    AutomationProperties.Name="{Binding DataContext[Kanban_Board_EditMenu], ElementName=PART_BoardRoot}">
                                                    <Grid ColumnDefinitions="12,*"
                                                          ColumnSpacing="6"
                                                          VerticalAlignment="Center">
                                                        <!-- icon gutter (reserved space, Windows-style) -->
                                                        <controls:DaisyIconText Grid.Column="0"
                                                                                IconData="{StaticResource DaisyIconCheck}"
                                                                                IconSize="12"
                                                                                Opacity="0"
                                                                                IsHitTestVisible="False"
                                                                                Focusable="False"
                                                                                VerticalAlignment="Center"
                                                                                HorizontalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DataContext[Kanban_Board_EditMenu], ElementName=PART_BoardRoot}"
                                                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </kanban:FlowKanbanActionMenuItem>
                                                <kanban:FlowKanbanActionMenuItem
                                                    x:Name="PART_BoardMenuResizeItem"
                                                    IsVisible="{Binding Tag.IsCompactLayoutEnabled, ElementName=PART_BoardRoot, Converter={x:Static BoolConverters.Not}}"
                                                    AutomationProperties.Name="{Binding DataContext[Kanban_Column_ResizeGrip], ElementName=PART_BoardRoot}">
                                                    <Grid ColumnDefinitions="12,*"
                                                          ColumnSpacing="6"
                                                          VerticalAlignment="Center">
                                                        <controls:DaisyIconText Grid.Column="0"
                                                                                IconData="{StaticResource DaisyIconCheck}"
                                                                                IconSize="12"
                                                                                Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                                Opacity="1"
                                                                                IsHitTestVisible="False"
                                                                                Focusable="False"
                                                                                VerticalAlignment="Center"
                                                                                HorizontalAlignment="Center"
                                                                                IsVisible="{Binding Tag.IsColumnResizeEnabled, ElementName=PART_BoardRoot}" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DataContext[Kanban_Column_ResizeGrip], ElementName=PART_BoardRoot}"
                                                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </kanban:FlowKanbanActionMenuItem>
                                                <kanban:FlowKanbanActionMenuItem
                                                    Command="{Binding Tag.SaveToFileCommand, ElementName=PART_BoardRoot}"
                                                    IsVisible="{Binding Tag.IsFilePickerAvailable, ElementName=PART_BoardRoot}"
                                                    AutomationProperties.Name="{Binding DataContext[Kanban_Board_SaveToFile], ElementName=PART_BoardRoot}">
                                                    <Grid ColumnDefinitions="12,*"
                                                          ColumnSpacing="6"
                                                          VerticalAlignment="Center">
                                                        <controls:DaisyIconText Grid.Column="0"
                                                                                IconData="{StaticResource DaisyIconCheck}"
                                                                                IconSize="12"
                                                                                Opacity="0"
                                                                                IsHitTestVisible="False"
                                                                                Focusable="False"
                                                                                VerticalAlignment="Center"
                                                                                HorizontalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DataContext[Kanban_Board_SaveToFile], ElementName=PART_BoardRoot}"
                                                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </kanban:FlowKanbanActionMenuItem>
                                                <kanban:FlowKanbanActionMenuItem
                                                    Command="{Binding Tag.LoadFromFileCommand, ElementName=PART_BoardRoot}"
                                                    IsVisible="{Binding Tag.IsFilePickerAvailable, ElementName=PART_BoardRoot}"
                                                    AutomationProperties.Name="{Binding DataContext[Kanban_Board_LoadFromFile], ElementName=PART_BoardRoot}">
                                                    <Grid ColumnDefinitions="12,*"
                                                          ColumnSpacing="6"
                                                          VerticalAlignment="Center">
                                                        <controls:DaisyIconText Grid.Column="0"
                                                                                IconData="{StaticResource DaisyIconCheck}"
                                                                                IconSize="12"
                                                                                Opacity="0"
                                                                                IsHitTestVisible="False"
                                                                                Focusable="False"
                                                                                VerticalAlignment="Center"
                                                                                HorizontalAlignment="Center" />
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding DataContext[Kanban_Board_LoadFromFile], ElementName=PART_BoardRoot}"
                                                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </kanban:FlowKanbanActionMenuItem>
                                    </controls:DaisyMenu>
                                </controls:DaisyPopover.PopoverContent>
                            </controls:DaisyPopover>
                            <controls:DaisyInput
                                                 x:Name="PART_SearchInput"
                                                 Grid.Row="1"
                                                 Grid.Column="0"
                                                 Grid.ColumnSpan="4"
                                                 Margin="0,8,0,0"
                                                 MinWidth="200"
                                                 Variant="Bordered"
                                                 Size="Small"
                                                 StartIcon="{StaticResource DaisyIconSearch}"
                                                 VerticalAlignment="Center"
                                                 PlaceholderText="{Binding [Kanban_Filter_SearchPlaceholder]}"
                                                 AutomationProperties.Name="{Binding [Kanban_Filter_SearchPlaceholder]}"
                                                 Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <!-- Filter Toggle Button -->
                            <Grid x:Name="PART_FilterToggleHost"
                                  Grid.Row="1"
                                  Grid.Column="4"
                                  VerticalAlignment="Center"
                                  Margin="4,8,0,0">
                                <controls:DaisyButton
                                                      x:Name="PART_FilterToggleBtn"
                                                      Command="{Binding Tag.ToggleFilterExpandedCommand, ElementName=PART_BoardRoot}"
                                                      Variant="Ghost"
                                                      Shape="Square"
                                                      Size="Small"
                                                      AutomationProperties.Name="{Binding [Kanban_Filter_ExpandFilters]}">
                                    <ToolTip.Tip>
                                        <ToolTip Content="{Binding [Kanban_Filter_ExpandFilters]}" />
                                    </ToolTip.Tip>
                                    <controls:DaisyIconText IconData="{StaticResource DaisyIconFilter}"
                                                            IconSize="14" />
                                </controls:DaisyButton>
                                <!-- Active filter count badge -->
                                <Border x:Name="PART_FilterCountBadge"
                                        Background="{DynamicResource DaisyPrimaryBrush}"
                                        CornerRadius="8"
                                        Padding="4,1"
                                        MinWidth="16"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-4,-4,0"
                                        IsHitTestVisible="False"
                                        IsVisible="{Binding Tag.IsFilterActive, ElementName=PART_BoardRoot}">
                                    <TextBlock Text="{Binding Tag.ActiveFilterCount, ElementName=PART_BoardRoot}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DaisyPrimaryContentBrush}"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Grid>
                        <!-- Expandable Filter Bar Panel -->
                        <Border x:Name="PART_FilterBarPanel"
                                Grid.Row="1"
                                Grid.Column="0"
                                Margin="16,0,16,8"
                                Padding="12"
                                Background="{DynamicResource DaisyBase200Brush}"
                                BorderBrush="{DynamicResource DaisyBase300Brush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                IsVisible="{Binding Tag.IsFilterExpanded, ElementName=PART_BoardRoot}">
                            <Grid RowSpacing="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- Filter Row 1: Priority and Status Filters -->
                                <kanban:FlowKanbanWrapPanel Grid.Row="0"
                                                    Orientation="Horizontal"
                                                    HorizontalSpacing="16"
                                                    VerticalSpacing="8">
                                    <!-- Priority Filter -->
                                    <StackPanel Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="{Binding [Kanban_Filter_Priority]}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource DaisyBaseContentBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <controls:DaisyCheckBox x:Name="PART_FilterPriorityLow"
                                                                    Content="Low"
                                                                    Size="Small"
                                                                    Variant="Info"
                                                                    IsChecked="{Binding Tag.FilterPriorityLow, ElementName=PART_BoardRoot, Mode=TwoWay}" />
                                            <controls:DaisyCheckBox x:Name="PART_FilterPriorityNormal"
                                                                    Content="Normal"
                                                                    Size="Small"
                                                                    Variant="Info"
                                                                    IsChecked="{Binding Tag.FilterPriorityNormal, ElementName=PART_BoardRoot, Mode=TwoWay}" />
                                            <controls:DaisyCheckBox x:Name="PART_FilterPriorityHigh"
                                                                    Content="High"
                                                                    Size="Small"
                                                                    Variant="Info"
                                                                    IsChecked="{Binding Tag.FilterPriorityHigh, ElementName=PART_BoardRoot, Mode=TwoWay}" />
                                            <controls:DaisyCheckBox x:Name="PART_FilterPriorityUrgent"
                                                                    Content="Urgent"
                                                                    Size="Small"
                                                                    Variant="Info"
                                                                    IsChecked="{Binding Tag.FilterPriorityUrgent, ElementName=PART_BoardRoot, Mode=TwoWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Status + Assignee Filters -->
                                    <kanban:FlowKanbanWrapPanel Orientation="Horizontal"
                                                               HorizontalSpacing="16"
                                                               VerticalSpacing="8">
                                        <!-- Status Filters -->
                                        <StackPanel Orientation="Vertical" Spacing="4">
                                            <TextBlock Text="Status"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource DaisyBaseContentBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:DaisyCheckBox x:Name="PART_FilterOverdue"
                                                                        Content="{Binding [Kanban_Filter_Overdue]}"
                                                                        Size="Small"
                                                                        Variant="Warning"
                                                                        IsChecked="{Binding Tag.FilterShowOverdue, ElementName=PART_BoardRoot, Mode=TwoWay}" />
                                                <controls:DaisyCheckBox x:Name="PART_FilterBlocked"
                                                                        Content="{Binding [Kanban_Filter_Blocked]}"
                                                                        Size="Small"
                                                                        Variant="Error"
                                                                        IsChecked="{Binding Tag.FilterShowBlocked, ElementName=PART_BoardRoot, Mode=TwoWay}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <!-- Assignee Filter -->
                                        <StackPanel Orientation="Vertical" Spacing="4">
                                            <TextBlock Text="{Binding [Kanban_Filter_Assignee]}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource DaisyBaseContentBrush}" />
                                            <controls:DaisySelect Width="180"
                                                                  ItemsSource="{Binding Tag.AssigneeFilterOptions, ElementName=PART_BoardRoot}"
                                                                  SelectedItem="{Binding Tag.SelectedAssigneeFilter, ElementName=PART_BoardRoot, Mode=TwoWay}"
                                                                  Size="Small"
                                                                  IsEnabled="{Binding Tag.HasAssigneeOptions, ElementName=PART_BoardRoot}"
                                                                  AutomationProperties.Name="{Binding [Kanban_Filter_Assignee]}">
                                                <controls:DaisySelect.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding DisplayName}" />
                                                    </DataTemplate>
                                                </controls:DaisySelect.ItemTemplate>
                                            </controls:DaisySelect>
                                        </StackPanel>
                                    </kanban:FlowKanbanWrapPanel>
                                    <!-- Due Date Filter -->
                                    <StackPanel Orientation="Vertical" Spacing="4">
                                        <TextBlock Text="{Binding [Kanban_Filter_DueDate]}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource DaisyBaseContentBrush}" />
                                        <kanban:FlowKanbanWrapPanel Orientation="Horizontal"
                                                                   Spacing="8">
                                            <!-- Quick Filters -->
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <controls:DaisyCheckBox x:Name="PART_FilterDueToday"
                                                                        Content="{Binding [Kanban_Filter_QuickToday]}"
                                                                        Size="Small"
                                                                        Variant="Info"
                                                                        IsChecked="{Binding Tag.FilterDueToday, ElementName=PART_BoardRoot, Mode=TwoWay}" />
                                                <controls:DaisyCheckBox x:Name="PART_FilterDueWeek"
                                                                        Content="{Binding [Kanban_Filter_QuickThisWeek]}"
                                                                        Size="Small"
                                                                        Variant="Info"
                                                                        IsChecked="{Binding Tag.FilterDueThisWeek, ElementName=PART_BoardRoot, Mode=TwoWay}" />
                                            </StackPanel>
                                            <!-- Date Range Pickers -->
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <DatePicker x:Name="PART_FilterDateFrom"
                                                            Width="120"
                                                            AutomationProperties.Name="{Binding [Kanban_Filter_DateFrom]}" />
                                                <TextBlock Text="–"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource DaisyBaseContentBrush}" />
                                                <DatePicker x:Name="PART_FilterDateTo"
                                                            Width="120"
                                                            AutomationProperties.Name="{Binding [Kanban_Filter_DateTo]}" />
                                            </StackPanel>
                                        </kanban:FlowKanbanWrapPanel>
                                    </StackPanel>
                                </kanban:FlowKanbanWrapPanel>
                                <!-- Filter Row 2: Actions -->
                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            Spacing="8"
                                            HorizontalAlignment="Left">
                                    <!-- Clear All -->
                                    <controls:DaisyButton
                                                          x:Name="PART_ClearFiltersBtn"
                                                          Command="{Binding Tag.ClearFilterCommand, ElementName=PART_BoardRoot}"
                                                          Content="{Binding [Kanban_Filter_ClearAll]}"
                                                          Size="ExtraSmall"
                                                          Variant="Secondary"
                                                          IsVisible="{Binding Tag.IsFilterActive, ElementName=PART_BoardRoot}" />
                                    <!-- Filter Presets Dropdown -->
                                    <controls:DaisyPopover x:Name="PART_FilterPresetsPopover"
                                                           PlacementMode="Bottom"

                                                           IsVisible="{Binding Tag.HasFilterPresets, ElementName=PART_BoardRoot}">
                                        <controls:DaisyPopover.Resources>
                                            <ResourceDictionary>
                                                <StaticResource x:Key="DaisyPopoverBackground" ResourceKey="DaisyBase100Brush" />
                                                <StaticResource x:Key="DaisyPopoverBorderBrush" ResourceKey="DaisyBase300Brush" />
                                            </ResourceDictionary>
                                        </controls:DaisyPopover.Resources>
                                        <controls:DaisyPopover.TriggerContent>
                                            <controls:DaisyButton
                                                                  Content="{Binding [Kanban_Filter_Presets]}"
                                                                  Size="ExtraSmall"
                                                                  IconData="{StaticResource DaisyIconChevronDown}"
                                                                  IconPlacement="Right" />
                                        </controls:DaisyPopover.TriggerContent>
                                        <controls:DaisyPopover.PopoverContent>
                                            <StackPanel MinWidth="160" MaxHeight="200">
                                                <ItemsControl ItemsSource="{Binding Tag.FilterPresets, ElementName=PART_BoardRoot}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <controls:DaisyButton
                                                                                  Content="{Binding Name}"
                                                                                  Command="{Binding Tag.LoadFilterPresetCommand, ElementName=PART_BoardRoot}"
                                                                                  CommandParameter="{Binding}"
                                                                                  Size="Small"
                                                                                  HorizontalContentAlignment="Left"
                                                                                  HorizontalAlignment="Stretch" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </controls:DaisyPopover.PopoverContent>
                                    </controls:DaisyPopover>
                                    <!-- Save Preset -->
                                    <controls:DaisyButton
                                                          x:Name="PART_SavePresetBtn"
                                                          Command="{Binding Tag.SaveFilterPresetCommand, ElementName=PART_BoardRoot}"
                                                          Content="{Binding [Kanban_Filter_SavePreset]}"
                                                          Size="ExtraSmall"
                                                          Variant="Secondary"
                                                          IsVisible="{Binding Tag.IsFilterActive, ElementName=PART_BoardRoot}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <kanban:FlowKanbanHome x:Name="PART_HomeView"
                                               Grid.Row="0"
                                               Grid.RowSpan="4"
                                               Grid.Column="0"
                                               IsVisible="{Binding IsHomeViewActive, RelativeSource={RelativeSource TemplatedParent}}"
                                               Boards="{Binding Boards, RelativeSource={RelativeSource TemplatedParent}}"
                                               OpenBoardCommand="{TemplateBinding OpenBoardCommand}"
                                               CreateBoardCommand="{TemplateBinding CreateBoardCommand}"
                                               CreateDemoBoardCommand="{TemplateBinding CreateDemoBoardCommand}"
                                               RenameBoardHomeCommand="{TemplateBinding RenameBoardHomeCommand}"
                                               DeleteBoardCommand="{TemplateBinding DeleteBoardCommand}"
                                               DuplicateBoardCommand="{TemplateBinding DuplicateBoardCommand}"
                                               ExportBoardCommand="{TemplateBinding ExportBoardCommand}"
                                               Localization="{Binding Localization, RelativeSource={RelativeSource TemplatedParent}}"
                                               ShowWelcomeMessage="{Binding ShowWelcomeMessage, RelativeSource={RelativeSource TemplatedParent}}"
                                               WelcomeMessageTitle="{Binding WelcomeMessageTitle, RelativeSource={RelativeSource TemplatedParent}}"
                                               WelcomeMessageSubtitle="{Binding WelcomeMessageSubtitle, RelativeSource={RelativeSource TemplatedParent}}" />
                        <kanban:FlowKanbanUserManagement x:Name="PART_UserManagementView"
                                                         Grid.Row="0"
                                                         Grid.RowSpan="4"
                                                         Grid.Column="0"
                                                         IsVisible="{Binding IsUserManagementViewActive, RelativeSource={RelativeSource TemplatedParent}}"
                                                         IsActive="{Binding IsUserManagementViewActive, RelativeSource={RelativeSource TemplatedParent}}"
                                                         UserProvider="{Binding UserProvider, RelativeSource={RelativeSource TemplatedParent}}"
                                                         Localization="{Binding Localization, RelativeSource={RelativeSource TemplatedParent}}" />
                        <Grid x:Name="PART_BoardContentHost"
                              Grid.Row="2"
                              Grid.Column="0"
                              IsVisible="{Binding IsBoardViewActive, RelativeSource={RelativeSource TemplatedParent}}">
                            <!-- Main Board -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          IsVisible="{Binding IsStandardLayoutVisible, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid>
                                    <kanban:FlowKanbanColumnsHost x:Name="PART_ColumnsItemsControl"
                                                                        ItemsSource="{Binding StandardColumnsSource, RelativeSource={RelativeSource TemplatedParent}}"
                                                                        Padding="16"
                                                                        ColumnSpacing="8"
                                                                        ColumnWidth="{Binding Tag.ColumnWidth, ElementName=PART_BoardRoot, Mode=TwoWay}"
                                                                        MinColumnWidth="{Binding Tag.MinColumnWidth, ElementName=PART_BoardRoot}"
                                                                        MaxColumnWidth="{Binding Tag.MaxColumnWidth, ElementName=PART_BoardRoot}"
                                                                        IsGripEnabled="{Binding Tag.IsColumnResizeEnabled, ElementName=PART_BoardRoot}"
                                                                        AccessibleText="{Binding DataContext[Kanban_Column_ResizeGrip], ElementName=PART_BoardRoot}"
                                                                        AccessibleHelpText="{Binding DataContext[Kanban_Column_ResizeHelp], ElementName=PART_BoardRoot}">
                                        <ItemsControl.ItemContainerTheme>
                                            <ControlTheme TargetType="ContentPresenter">
                                                <Setter Property="IsVisible"
                                                        Value="{Binding IsArchiveColumnVisible}" />
                                            </ControlTheme>
                                        </ItemsControl.ItemContainerTheme>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <kanban:FlowKanbanColumn x:Name="PART_KanbanColumn"
                                                                         ColumnData="{Binding}"
                                                                         IsCollapsed="{Binding IsCollapsed, Mode=TwoWay}"
                                                                         ParentKanban="{Binding Tag, ElementName=PART_BoardRoot}"
                                                                         AddCardPlacement="{Binding Tag.AddCardPlacement, ElementName=PART_BoardRoot}"
                                                                         Background="{DynamicResource DaisyBase200Brush}"
                                                                         CornerRadius="12"
                                                                         Padding="2"
                                                                         Margin="2"
                                                                         BorderBrush="{DynamicResource DaisyBase300Brush}"
                                                                         BorderThickness="1"
                                                                         MaxHeight="{Binding Tag.CompactColumnMaxHeight, ElementName=PART_BoardRoot}"
                                                                         IsVisible="{Binding IsArchiveColumnVisible}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </kanban:FlowKanbanColumnsHost>
                                    <Canvas x:Name="PART_ColumnDropLayer"
                                            IsHitTestVisible="False" />
                                </Grid>
                            </ScrollViewer>
                            <!-- Compact Board -->
                            <Border x:Name="PART_CompactColumnsHost"
                                    Padding="16,16,20,20"
                                    IsVisible="{Binding IsCompactLayoutVisible, RelativeSource={RelativeSource TemplatedParent}}">
                                <Grid RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <controls:DaisySelect x:Name="PART_CompactColumnSelect"
                                                          ItemsSource="{Binding CompactColumnsSource, RelativeSource={RelativeSource TemplatedParent}}"
                                                          SelectedItem="{Binding CompactSelectedColumn, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                          Variant="Bordered"
                                                          Size="Small"
                                                          HorizontalAlignment="Stretch"
                                                          AutomationProperties.Name="{Binding DataContext[Kanban_Sections], ElementName=PART_BoardRoot}"
                                                          AutomationProperties.AutomationId="Kanban_CompactColumnSelect"
                                                          Margin="0">
                                        <controls:DaisySelect.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding CompactTitle}" />
                                            </DataTemplate>
                                        </controls:DaisySelect.ItemTemplate>
                                    </controls:DaisySelect>
                                    <ContentPresenter x:Name="PART_CompactColumnPresenter"
                                                      Grid.Row="1"
                                                      Content="{Binding CompactSelectedColumn, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ContentPresenter.ContentTemplate>
                                            <DataTemplate>
                                                <kanban:FlowKanbanColumn x:Name="PART_KanbanColumn"
                                                                         ColumnData="{Binding}"
                                                                         IsCollapsed="{Binding IsCollapsed, Mode=TwoWay}"
                                                                         ParentKanban="{Binding Tag, ElementName=PART_BoardRoot}"
                                                                         AddCardPlacement="{Binding Tag.AddCardPlacement, ElementName=PART_BoardRoot}"
                                                                         Background="{DynamicResource DaisyBase200Brush}"
                                                                         CornerRadius="12"
                                                                         Padding="2"
                                                                         Margin="2"
                                                                         BorderBrush="{DynamicResource DaisyBase300Brush}"
                                                                         BorderThickness="1"
                                                                         MaxHeight="{Binding Tag.CompactColumnMaxHeight, ElementName=PART_BoardRoot}" />
                                        </DataTemplate>
                                    </ContentPresenter.ContentTemplate>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                            <!-- Swimlane Board -->
                            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Auto"
                                          IsVisible="{Binding IsSwimlaneLayoutVisible, RelativeSource={RelativeSource TemplatedParent}}">
                                <StackPanel Margin="16"
                                            Spacing="12">
                                    <!-- Column Headers -->
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Background="Transparent" />
                                        <Grid Grid.Column="1">
                                            <kanban:FlowKanbanColumnsHost x:Name="PART_SwimlaneColumnsItemsControl"
                                                                                ItemsSource="{Binding SwimlaneColumnsSource, RelativeSource={RelativeSource TemplatedParent}}"
                                                                                ColumnSpacing="8"
                                                                                ColumnWidth="{Binding Tag.ColumnWidth, ElementName=PART_BoardRoot, Mode=TwoWay}"
                                                                                MinColumnWidth="{Binding Tag.MinColumnWidth, ElementName=PART_BoardRoot}"
                                                                                MaxColumnWidth="{Binding Tag.MaxColumnWidth, ElementName=PART_BoardRoot}"
                                                                                IsGripEnabled="{Binding Tag.IsColumnResizeEnabled, ElementName=PART_BoardRoot}"
                                                                                AccessibleText="{Binding DataContext[Kanban_Column_ResizeGrip], ElementName=PART_BoardRoot}"
                                                                                AccessibleHelpText="{Binding DataContext[Kanban_Column_ResizeHelp], ElementName=PART_BoardRoot}">
                                                <ItemsControl.ItemContainerTheme>
                                                    <ControlTheme TargetType="ContentPresenter">
                                                        <Setter Property="IsVisible"
                                                                Value="{Binding IsArchiveColumnVisible}" />
                                                    </ControlTheme>
                                                </ItemsControl.ItemContainerTheme>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <kanban:FlowKanbanColumn x:Name="PART_KanbanColumn"
                                                                                 ColumnData="{Binding}"
                                                                                 IsCollapsed="{Binding IsCollapsed, Mode=TwoWay}"
                                                                                 ParentKanban="{Binding Tag, ElementName=PART_BoardRoot}"
                                                                                 AddCardPlacement="{Binding Tag.AddCardPlacement, ElementName=PART_BoardRoot}"
                                                                                 Background="{DynamicResource DaisyBase200Brush}"
                                                                                 CornerRadius="12"
                                                                                 Padding="2"
                                                                                 Margin="2"
                                                                                 BorderBrush="{DynamicResource DaisyBase300Brush}"
                                                                                 BorderThickness="1"
                                                                                 ShowColumnHeader="True"
                                                                                 ShowTasks="False"
                                                                                 ShowAddCard="False"
                                                                                 IsDropEnabled="False"
                                                                                 IsVisible="{Binding IsArchiveColumnVisible}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </kanban:FlowKanbanColumnsHost>
                                            <Canvas x:Name="PART_SwimlaneColumnDropLayer"
                                                    IsHitTestVisible="False" />
                                        </Grid>
                                    </Grid>
                                    <!-- Lane Rows -->
                                    <ItemsControl x:Name="PART_LaneRowsHost"
                                                  ItemsSource="{Binding LaneRows, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Vertical"
                                                            Spacing="12" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid x:Name="PART_LaneRow"
                                                      ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="140" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border x:Name="PART_LaneHeaderBorder"
                                                            Grid.Column="0"
                                                            Background="{DynamicResource DaisyBase200Brush}"
                                                            BorderBrush="{DynamicResource DaisyBase300Brush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="12"
                                                            Margin="4">
                                                        <TextBlock x:Name="PART_LaneHeaderText"
                                                                   Text="{Binding Lane.Title}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                                   Opacity="0.85"
                                                                   TextWrapping="Wrap" />
                                                    </Border>
                                                    <ItemsControl Grid.Column="1"
                                                                  ItemsSource="{Binding Cells}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal"
                                                                            Spacing="8" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemContainerTheme>
                                                            <ControlTheme TargetType="ContentPresenter">
                                                                <Setter Property="IsVisible"
                                                                        Value="{Binding Column.IsArchiveColumnVisible}" />
                                                            </ControlTheme>
                                                        </ItemsControl.ItemContainerTheme>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <kanban:FlowKanbanColumn x:Name="PART_KanbanColumn"
                                                                                         ColumnData="{Binding Column}"
                                                                                         IsCollapsed="{Binding Column.IsCollapsed, Mode=TwoWay}"
                                                                                         ParentKanban="{Binding Tag, ElementName=PART_BoardRoot}"
                                                                                         AddCardPlacement="{Binding Tag.AddCardPlacement, ElementName=PART_BoardRoot}"
                                                                                         LaneFilterId="{Binding LaneId}"
                                                                                         Tag="{Binding}"
                                                                                         ShowColumnHeader="False"
                                                                                         ShowTasks="True"
                                                                                         ShowAddCard="True"
                                                                                         IsDropEnabled="True"
                                                                                         Background="{DynamicResource DaisyBase200Brush}"
                                                                                         CornerRadius="12"
                                                                                         Padding="2"
                                                                                         Margin="2"
                                                                                         BorderBrush="{DynamicResource DaisyBase300Brush}"
                                                                                         BorderThickness="1"
                                                                                         IsVisible="{Binding Column.IsArchiveColumnVisible}"
                                                                                         TaskListMaxHeight="{Binding Tag.SwimlaneCellMaxHeight, ElementName=PART_BoardRoot}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                        <!-- Sidebar -->
                        <Border x:Name="PART_SidebarBorder"
                                Grid.Row="0"
                                Grid.RowSpan="3"
                                Grid.Column="1"
                                Background="{DynamicResource DaisyBase100Brush}"
                                BorderBrush="{DynamicResource DaisyBase300Brush}"
                                BorderThickness="1,0,0,0"
                                Padding="12"
                                Width="56">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <!-- Action Buttons -->
                                <StackPanel Spacing="12"
                                            HorizontalAlignment="Center">
                                    <controls:DaisyButton
                                                          Command="{TemplateBinding ShowHomeCommand}"
                                                          AutomationProperties.Name="{Binding [Kanban_Home]}"
                                                          AutomationProperties.AutomationId="Kanban_Home"
                                                          Variant="Neutral"
                                                          Shape="Square"
                                                          Size="Small">
                                        <ToolTip.Tip>
                                            <ToolTip Content="{Binding [Kanban_Home]}" />
                                        </ToolTip.Tip>
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconHome}"
                                                                IconSize="14" />
                                    </controls:DaisyButton>
                                    <controls:DaisyButton
                                                          Command="{TemplateBinding ShowUserManagementCommand}"
                                                          AutomationProperties.Name="{Binding [Kanban_Users_Title]}"
                                                          AutomationProperties.AutomationId="Kanban_Users"
                                                          Variant="Neutral"
                                                          Shape="Square"
                                                          Size="Small"
                                                          IsVisible="{Binding IsUserManagementButtonVisible, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ToolTip.Tip>
                                            <ToolTip Content="{Binding [Kanban_Users_Title]}" />
                                        </ToolTip.Tip>
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconUser}"
                                                                IconSize="14" />
                                    </controls:DaisyButton>
                                    <controls:DaisyButton
                                                          Command="{TemplateBinding SettingsCommand}"
                                                          AutomationProperties.Name="{Binding [Kanban_Settings_Title]}"
                                                          AutomationProperties.AutomationId="Kanban_Settings"
                                                          Variant="Neutral"
                                                          Shape="Square"
                                                          Size="Small">
                                        <ToolTip.Tip>
                                            <ToolTip Content="{Binding [Kanban_Settings_Title]}" />
                                        </ToolTip.Tip>
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconSettings}"
                                                                IconSize="14" />
                                    </controls:DaisyButton>
                                    <StackPanel Spacing="12"
                                                IsVisible="{Binding IsBoardViewActive, RelativeSource={RelativeSource TemplatedParent}}">
                                        <controls:DaisyButton
                                                              Command="{TemplateBinding UndoCommand}"
                                                              IsEnabled="{Binding CommandHistory.CanUndo, RelativeSource={RelativeSource TemplatedParent}}"
                                                              AutomationProperties.Name="{Binding [Kanban_Undo]}"
                                                              AutomationProperties.AutomationId="Kanban_Undo"
                                                              Variant="Neutral"
                                                              Shape="Square"
                                                              Size="Small"
                                                              IsVisible="{Binding EnableUndoRedo, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ToolTip.Tip>
                                                <ToolTip Content="{Binding [Kanban_Undo]}" />
                                            </ToolTip.Tip>
                                            <controls:DaisyIconText IconData="{StaticResource DaisyIconArrowLeft}"
                                                                    IconSize="14" />
                                        </controls:DaisyButton>
                                        <controls:DaisyButton
                                                              Command="{TemplateBinding RedoCommand}"
                                                              IsEnabled="{Binding CommandHistory.CanRedo, RelativeSource={RelativeSource TemplatedParent}}"
                                                              AutomationProperties.Name="{Binding [Kanban_Redo]}"
                                                              AutomationProperties.AutomationId="Kanban_Redo"
                                                              Variant="Neutral"
                                                              Shape="Square"
                                                              Size="Small"
                                                              IsVisible="{Binding EnableUndoRedo, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ToolTip.Tip>
                                                <ToolTip Content="{Binding [Kanban_Redo]}" />
                                            </ToolTip.Tip>
                                            <controls:DaisyIconText IconData="{StaticResource DaisyIconArrowRight}"
                                                                    IconSize="14" />
                                        </controls:DaisyButton>
                                        <controls:DaisyDivider />
                                        <controls:DaisyButton
                                                              Command="{TemplateBinding ZoomInCommand}"
                                                              AutomationProperties.Name="{Binding [Kanban_ZoomIn]}"
                                                              AutomationProperties.AutomationId="Kanban_ZoomIn"
                                                              Variant="Neutral"
                                                              Shape="Square"
                                                              Size="Small">
                                            <ToolTip.Tip>
                                                <ToolTip Content="{Binding [Kanban_ZoomIn]}" />
                                            </ToolTip.Tip>
                                            <controls:DaisyIconText IconData="{StaticResource DaisyIconZoomIn}"
                                                                    IconSize="14" />
                                        </controls:DaisyButton>
                                        <controls:DaisyButton
                                                              Command="{TemplateBinding ZoomOutCommand}"
                                                              AutomationProperties.Name="{Binding [Kanban_ZoomOut]}"
                                                              AutomationProperties.AutomationId="Kanban_ZoomOut"
                                                              Variant="Neutral"
                                                              Shape="Square"
                                                              Size="Small">
                                            <ToolTip.Tip>
                                                <ToolTip Content="{Binding [Kanban_ZoomOut]}" />
                                            </ToolTip.Tip>
                                            <controls:DaisyIconText IconData="{StaticResource DaisyIconZoomOut}"
                                                                    IconSize="14" />
                                        </controls:DaisyButton>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Statistics Icon with Tooltip (at bottom of sidebar) -->
                                <StackPanel Grid.Row="1"
                                            HorizontalAlignment="Center"
                                            Spacing="8"
                                            IsVisible="{Binding IsBoardViewActive, RelativeSource={RelativeSource TemplatedParent}}">
                                    <controls:DaisyDivider />
                                    <controls:DaisyButton
                                                          Command="{TemplateBinding ShowKeyboardHelpCommand}"
                                                          AutomationProperties.Name="{Binding [Kanban_KeyboardHelp_Title]}"
                                                          AutomationProperties.AutomationId="Kanban_KeyboardHelp"
                                                          Variant="Neutral"
                                                          Shape="Square"
                                                          Size="Small"
                                                          IsVisible="{Binding Tag.IsKeyboardHelpVisible, ElementName=PART_BoardRoot}">
                                        <ToolTip.Tip>
                                            <ToolTip Content="{Binding [Kanban_KeyboardHelp_Title]}" />
                                        </ToolTip.Tip>
                                        <controls:DaisyIconText IconSymbol="Help"
                                                                IconSize="14" />
                                    </controls:DaisyButton>
                                    <controls:DaisyButton
                                                          x:Name="PART_StatsButton"
                                                          Command="{TemplateBinding ShowMetricsCommand}"
                                                          Variant="Neutral"
                                                          Shape="Square"
                                                          Size="Small"
                                                          AutomationProperties.AutomationId="Kanban_Statistics"
                                                          AutomationProperties.Name="{Binding DataContext[Kanban_BoardStatistics], ElementName=PART_BoardRoot}">
                                        <ToolTip.Tip>
                                            <ToolTip Content="{Binding DataContext[Kanban_BoardStatistics], ElementName=PART_BoardRoot}" />
                                        </ToolTip.Tip>
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconChart}"
                                                                IconSize="14" />
                                    </controls:DaisyButton>
                                    <!-- Status Bar Toggle -->
                                    <controls:DaisyButton
                                                          Command="{TemplateBinding ToggleStatusBarCommand}"
                                                          AutomationProperties.Name="{Binding [Kanban_ToggleStatusBar]}"
                                                          AutomationProperties.AutomationId="Kanban_ToggleStatusBar"
                                                          Variant="Neutral"
                                                          Shape="Square"
                                                          Size="Small">
                                        <ToolTip.Tip>
                                            <ToolTip Content="{Binding [Kanban_ToggleStatusBar]}" />
                                        </ToolTip.Tip>
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconPanelBottom}"
                                                                IconSize="14" />
                                    </controls:DaisyButton>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <!-- Status Bar -->
                                <Border x:Name="PART_StatusBarBorder"
                                Grid.Row="3"
                                Grid.Column="0"
                                Background="{DynamicResource DaisyBase100Brush}"
                                BorderBrush="{DynamicResource DaisyBase300Brush}"
                                BorderThickness="0,1,0,0"
                                Padding="12,8"
                                IsVisible="{Binding IsBoardStatusBarVisible, RelativeSource={RelativeSource TemplatedParent}}">
                            <StackPanel Orientation="Vertical"
                                        Spacing="8">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="24">
                                    <!-- Column Count -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconChart}"
                                                                IconSize="14"
                                                                Foreground="{DynamicResource DaisyBaseContentBrush}" />
                                        <TextBlock Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                   VerticalAlignment="Center">
                                            <Run Text="{Binding Board.Columns.Count, RelativeSource={RelativeSource TemplatedParent}}"
                                                 FontWeight="SemiBold" />
                                            <Run Text=" " />
                                            <Run Text="{Binding [Kanban_Sections]}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- Separator -->
                                    <Border Width="1"
                                            Background="{DynamicResource DaisyBase300Brush}" />
                                    <!-- Zoom Level -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconZoomIn}"
                                                                IconSize="14"
                                                                Foreground="{DynamicResource DaisyBaseContentBrush}" />
                                        <TextBlock Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                   VerticalAlignment="Center">
                                            <Run Text="{Binding [Kanban_Zoom]}" />
                                            <Run Text=": " />
                                            <Run Text="{Binding BoardSizeLabel, RelativeSource={RelativeSource TemplatedParent}}"
                                                 FontWeight="SemiBold" />
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- Separator -->
                                    <Border Width="1"
                                            Background="{DynamicResource DaisyBase300Brush}"
                                            IsVisible="{Binding HasArchiveColumnToggle, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <!-- Archive Toggle -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6"
                                                IsVisible="{Binding HasArchiveColumnToggle, RelativeSource={RelativeSource TemplatedParent}}">
                                        <controls:DaisyButton
                                                              Command="{TemplateBinding ToggleArchiveColumnVisibilityCommand}"
                                                              Variant="Ghost"
                                                              Size="Small"
                                                              IsVisible="{Binding CanShowArchiveColumn, RelativeSource={RelativeSource TemplatedParent}}"
                                                              AutomationProperties.Name="{Binding [Kanban_Archive_ToggleShow]}"
                                                              >
                                            <ToolTip.Tip>
                                                <ToolTip Content="{Binding [Kanban_Archive_ToggleShow]}" />
                                            </ToolTip.Tip>
                                            <controls:DaisyIconText IconData="{StaticResource DaisyIconFolder}"
                                                                    IconSize="12"
                                                                    Text="{Binding [Kanban_Archive_ToggleShow]}" />
                                        </controls:DaisyButton>
                                        <controls:DaisyButton
                                                              Command="{TemplateBinding ToggleArchiveColumnVisibilityCommand}"
                                                              Variant="Ghost"
                                                              Size="Small"
                                                              IsVisible="{Binding CanHideArchiveColumn, RelativeSource={RelativeSource TemplatedParent}}"
                                                              AutomationProperties.Name="{Binding [Kanban_Archive_ToggleHide]}"
                                                              >
                                            <ToolTip.Tip>
                                                <ToolTip Content="{Binding [Kanban_Archive_ToggleHide]}" />
                                            </ToolTip.Tip>
                                            <controls:DaisyIconText IconData="{StaticResource DaisyIconFolder}"
                                                                    IconSize="12"
                                                                    Text="{Binding [Kanban_Archive_ToggleHide]}" />
                                        </controls:DaisyButton>
                                    </StackPanel>
                                    <!-- Separator -->
                                    <Border Width="1"
                                            Background="{DynamicResource DaisyBase300Brush}"
                                            IsVisible="{Binding HasStatusMessage, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <!-- Status Message -->
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6"
                                                IsVisible="{Binding HasStatusMessage, RelativeSource={RelativeSource TemplatedParent}}">
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconWarning}"
                                                                IconSize="14"
                                                                Foreground="{DynamicResource DaisyWarningBrush}" />
                                        <TextBlock Text="{Binding StatusMessage, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </StackPanel>
                                <!-- Bulk Actions -->
                                <kanban:FlowKanbanWrapPanel Orientation="Horizontal"
                                                    HorizontalSpacing="8"
                                                    VerticalSpacing="8"
                                                    IsVisible="{Binding Tag.HasSelection, ElementName=PART_BoardRoot}">
                                    <TextBlock Foreground="{DynamicResource DaisyBaseContentBrush}"
                                               VerticalAlignment="Center">
                                        <Run Text="{Binding Tag.SelectedCount, ElementName=PART_BoardRoot}"
                                             FontWeight="SemiBold" />
                                        <Run Text=" " />
                                        <Run Text="{Binding DataContext[Kanban_Selection_Selected], ElementName=PART_BoardRoot}" />
                                    </TextBlock>
                                    <Border Width="1"
                                            Background="{DynamicResource DaisyBase300Brush}" />
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="6">
                                        <controls:DaisySelect Width="180"
                                                              ItemsSource="{Binding Tag.BulkMoveColumns, ElementName=PART_BoardRoot}"
                                                              SelectedItem="{Binding Tag.SelectedBulkMoveColumn, ElementName=PART_BoardRoot, Mode=TwoWay}"
                                                              Size="Small"
                                                              AutomationProperties.Name="{Binding DataContext[Kanban_Bulk_MoveTo], ElementName=PART_BoardRoot}">
                                            <controls:DaisySelect.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Title}" />
                                                </DataTemplate>
                                            </controls:DaisySelect.ItemTemplate>
                                        </controls:DaisySelect>
                                        <controls:DaisyButton
                                                              Command="{Binding Tag.BulkMoveCommand, ElementName=PART_BoardRoot}"
                                                              CommandParameter="{Binding Tag.SelectedBulkMoveColumn, ElementName=PART_BoardRoot}"
                                                              Variant="Primary"
                                                              Size="Small"
                                                              AutomationProperties.Name="{Binding DataContext[Kanban_Bulk_Move], ElementName=PART_BoardRoot}">
                                            <controls:DaisyIconText IconData="{StaticResource DaisyIconArrowRight}"
                                                                    IconSize="12"
                                                                    Text="{Binding DataContext[Kanban_Bulk_Move], ElementName=PART_BoardRoot}" />
                                        </controls:DaisyButton>
                                    </StackPanel>
                                    <controls:DaisyButton
                                                          Variant="Ghost"
                                                          Size="Small"
                                                          AutomationProperties.Name="{Binding DataContext[Kanban_Bulk_Priority], ElementName=PART_BoardRoot}">
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconStar}"
                                                                IconSize="12"
                                                                Text="{Binding DataContext[Kanban_Bulk_Priority], ElementName=PART_BoardRoot}" />
                                        <controls:DaisyButton.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="{Binding DataContext[Kanban_Priority_Low], ElementName=PART_BoardRoot}"
                                                          Command="{Binding Tag.BulkSetPriorityCommand, ElementName=PART_BoardRoot}"
                                                          CommandParameter="Low" />
                                                <MenuItem Header="{Binding DataContext[Kanban_Priority_Normal], ElementName=PART_BoardRoot}"
                                                          Command="{Binding Tag.BulkSetPriorityCommand, ElementName=PART_BoardRoot}"
                                                          CommandParameter="Normal" />
                                                <MenuItem Header="{Binding DataContext[Kanban_Priority_High], ElementName=PART_BoardRoot}"
                                                          Command="{Binding Tag.BulkSetPriorityCommand, ElementName=PART_BoardRoot}"
                                                          CommandParameter="High" />
                                                <MenuItem Header="{Binding DataContext[Kanban_Priority_Urgent], ElementName=PART_BoardRoot}"
                                                          Command="{Binding Tag.BulkSetPriorityCommand, ElementName=PART_BoardRoot}"
                                                          CommandParameter="Urgent" />
                                            </MenuFlyout>
                                        </controls:DaisyButton.Flyout>
                                    </controls:DaisyButton>
                                    <controls:DaisyButton
                                                          Variant="Ghost"
                                                          Size="Small"
                                                          AutomationProperties.Name="{Binding DataContext[Kanban_Bulk_Tags], ElementName=PART_BoardRoot}">
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconBookmark}"
                                                                IconSize="12"
                                                                Text="{Binding DataContext[Kanban_Bulk_Tags], ElementName=PART_BoardRoot}" />
                                        <controls:DaisyButton.Flyout>
                                            <Flyout Placement="Top">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{Binding DataContext[Kanban_Bulk_Tags], ElementName=PART_BoardRoot}"
                                                               Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                               TextWrapping="Wrap" />
                                                    <controls:DaisyInput x:Name="PART_BulkTagsInput"
                                                                         PlaceholderText="{Binding DataContext[Kanban_Bulk_TagsPlaceholder], ElementName=PART_BoardRoot}"
                                                                         AutomationProperties.Name="{Binding DataContext[Kanban_Bulk_Tags], ElementName=PART_BoardRoot}"
                                                                         AutomationProperties.AutomationId="Kanban_BulkTags"
                                                                         Variant="Bordered"
                                                                         Size="Small" />
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="8">
                                                        <controls:DaisyButton
                                                                              Content="{Binding DataContext[Common_Apply], ElementName=PART_BoardRoot}"
                                                                              Command="{Binding Tag.BulkSetTagsCommand, ElementName=PART_BoardRoot}"
                                                                              CommandParameter="{Binding Text, ElementName=PART_BulkTagsInput}"
                                                                              Variant="Primary"
                                                                              Size="Small" />
                                                        <controls:DaisyButton
                                                                              Content="{Binding DataContext[Common_Clear], ElementName=PART_BoardRoot}"
                                                                              Command="{Binding Tag.BulkSetTagsCommand, ElementName=PART_BoardRoot}"
                                                                              CommandParameter="{x:Null}"
                                                                              Variant="Ghost"
                                                                              Size="Small" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </controls:DaisyButton.Flyout>
                                    </controls:DaisyButton>
                                    <controls:DaisyButton
                                                          Variant="Ghost"
                                                          Size="Small"
                                                          AutomationProperties.Name="{Binding DataContext[Kanban_Bulk_DueDate], ElementName=PART_BoardRoot}">
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconDateDisplay}"
                                                                IconSize="12"
                                                                Text="{Binding DataContext[Kanban_Bulk_DueDate], ElementName=PART_BoardRoot}" />
                                        <controls:DaisyButton.Flyout>
                                            <Flyout Placement="Top">
                                                <StackPanel Spacing="8">
                                                    <TextBlock Text="{Binding DataContext[Kanban_Bulk_DueDate], ElementName=PART_BoardRoot}"
                                                               Foreground="{DynamicResource DaisyBaseContentBrush}"
                                                               TextWrapping="Wrap" />
                                                    <DatePicker x:Name="PART_BulkDueDatePicker"
                                                                AutomationProperties.Name="{Binding DataContext[Kanban_Bulk_DueDate], ElementName=PART_BoardRoot}"
                                                                AutomationProperties.AutomationId="Kanban_BulkDueDate"
                                                                HorizontalAlignment="Stretch" />
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="8">
                                                        <controls:DaisyButton
                                                                              Content="{Binding DataContext[Common_Apply], ElementName=PART_BoardRoot}"
                                                                              Command="{Binding Tag.BulkSetDueDateCommand, ElementName=PART_BoardRoot}"
                                                                              CommandParameter="{Binding Date, ElementName=PART_BulkDueDatePicker}"
                                                                              Variant="Primary"
                                                                              Size="Small" />
                                                        <controls:DaisyButton
                                                                              Content="{Binding DataContext[Common_Clear], ElementName=PART_BoardRoot}"
                                                                              Command="{Binding Tag.BulkSetDueDateCommand, ElementName=PART_BoardRoot}"
                                                                              CommandParameter="{x:Null}"
                                                                              Variant="Ghost"
                                                                              Size="Small" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Flyout>
                                        </controls:DaisyButton.Flyout>
                                    </controls:DaisyButton>
                                    <controls:DaisyButton
                                                          Command="{Binding Tag.BulkArchiveCommand, ElementName=PART_BoardRoot}"
                                                          Variant="Ghost"
                                                          Size="Small"
                                                          IsVisible="{Binding Tag.CanHideArchiveColumn, ElementName=PART_BoardRoot}"
                                                          AutomationProperties.Name="{Binding DataContext[Kanban_Bulk_Archive], ElementName=PART_BoardRoot}">
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconFolder}"
                                                                IconSize="12"
                                                                Text="{Binding DataContext[Kanban_Bulk_Archive], ElementName=PART_BoardRoot}" />
                                    </controls:DaisyButton>
                                    <controls:DaisyButton
                                                          Command="{Binding Tag.BulkDeleteCommand, ElementName=PART_BoardRoot}"
                                                          Variant="Ghost"
                                                          Size="Small"
                                                          AutomationProperties.Name="{Binding DataContext[Kanban_Bulk_Delete], ElementName=PART_BoardRoot}">
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconDelete}"
                                                                IconSize="12"
                                                                Text="{Binding DataContext[Kanban_Bulk_Delete], ElementName=PART_BoardRoot}" />
                                    </controls:DaisyButton>
                                    <controls:DaisyButton
                                                          Command="{Binding Tag.ClearSelectionCommand, ElementName=PART_BoardRoot}"
                                                          Variant="Ghost"
                                                          Size="Small"
                                                          AutomationProperties.Name="{Binding DataContext[Kanban_Bulk_ClearSelection], ElementName=PART_BoardRoot}">
                                        <controls:DaisyIconText IconData="{StaticResource DaisyIconClose}"
                                                                IconSize="12"
                                                                Text="{Binding DataContext[Kanban_Bulk_ClearSelection], ElementName=PART_BoardRoot}" />
                                    </controls:DaisyButton>
                                </kanban:FlowKanbanWrapPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </ControlTheme>
    </Styles.Resources>
</Styles>
