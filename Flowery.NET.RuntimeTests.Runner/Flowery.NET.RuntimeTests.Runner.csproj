<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The target framework of the runtime test host, which this runner starts. -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows'))">net10.0-windows</TargetFramework>
    <TargetFramework Condition="!$([MSBuild]::IsOSPlatform('Windows'))">net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Builds the runtime test host first; the runner starts it as a separate process. -->
    <ProjectReference Include="..\Flowery.NET.RuntimeTests\Flowery.NET.RuntimeTests.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>
</Project>
