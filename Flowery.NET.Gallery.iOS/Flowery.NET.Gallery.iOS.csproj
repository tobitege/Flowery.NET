<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <!-- The iOS SDK version of the target framework; each iOS pack accepts only its own Xcode. 26.0 needs Xcode 26.0.
             The iOS simulator workflow builds 26.5 with Xcode 26.6 (-p:FloweryIosSdkVersion=26.5). -->
        <FloweryIosSdkVersion Condition="'$(FloweryIosSdkVersion)' == ''">26.0</FloweryIosSdkVersion>
        <TargetFramework>net10.0-ios$(FloweryIosSdkVersion)</TargetFramework>
        <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
        <Nullable>enable</Nullable>
        <AppIcon>AppIcon</AppIcon>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
      <CodesignKey>iPhone Developer</CodesignKey>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\Flowery.NET.Gallery\Flowery.NET.Gallery.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Avalonia.iOS" Version="12.1.4" />
    </ItemGroup>
</Project>
