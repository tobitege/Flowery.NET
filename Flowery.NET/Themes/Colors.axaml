<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Standalone text/icon colors can differ from the variant's filled background. -->
    <SolidColorBrush x:Key="DaisyPrimaryForegroundBrush" Color="{DynamicResource DaisyPrimaryColor}" />
    <SolidColorBrush x:Key="DaisySecondaryForegroundBrush" Color="{DynamicResource DaisySecondaryColor}" />
    <SolidColorBrush x:Key="DaisyAccentForegroundBrush" Color="{DynamicResource DaisyAccentColor}" />

    <!-- Button defaults follow the active palette; individual palettes can override them. -->
    <SolidColorBrush x:Key="DaisyButtonPrimaryForegroundBrush" Color="{DynamicResource DaisyPrimaryColor}" />
    <SolidColorBrush x:Key="DaisyButtonPrimarySoftBrush" Color="{DynamicResource DaisyPrimaryColor}" Opacity="0.15" />
    <SolidColorBrush x:Key="DaisyButtonPrimaryDisabledBrush" Color="{DynamicResource DaisyPrimaryColor}" />
    <x:Double x:Key="DaisyButtonPrimaryDisabledOpacity">0.5</x:Double>

    <!-- Soft button style: tinted surface, stronger tint on hover and a translucent border in the variant color. -->
    <SolidColorBrush x:Key="DaisyButtonPrimarySoftHoverBrush" Color="{DynamicResource DaisyPrimaryColor}" Opacity="0.3" />
    <SolidColorBrush x:Key="DaisyButtonPrimarySoftBorderBrush" Color="{DynamicResource DaisyPrimaryColor}" Opacity="0.45" />
    <SolidColorBrush x:Key="DaisyButtonSecondarySoftBrush" Color="{DynamicResource DaisySecondaryColor}" Opacity="0.15" />
    <SolidColorBrush x:Key="DaisyButtonSecondarySoftHoverBrush" Color="{DynamicResource DaisySecondaryColor}" Opacity="0.3" />
    <SolidColorBrush x:Key="DaisyButtonSecondarySoftBorderBrush" Color="{DynamicResource DaisySecondaryColor}" Opacity="0.45" />
    <SolidColorBrush x:Key="DaisyButtonAccentSoftBrush" Color="{DynamicResource DaisyAccentColor}" Opacity="0.15" />
    <SolidColorBrush x:Key="DaisyButtonAccentSoftHoverBrush" Color="{DynamicResource DaisyAccentColor}" Opacity="0.3" />
    <SolidColorBrush x:Key="DaisyButtonAccentSoftBorderBrush" Color="{DynamicResource DaisyAccentColor}" Opacity="0.45" />
    <SolidColorBrush x:Key="DaisyButtonInfoSoftBrush" Color="{DynamicResource DaisyInfoColor}" Opacity="0.15" />
    <SolidColorBrush x:Key="DaisyButtonInfoSoftHoverBrush" Color="{DynamicResource DaisyInfoColor}" Opacity="0.3" />
    <SolidColorBrush x:Key="DaisyButtonInfoSoftBorderBrush" Color="{DynamicResource DaisyInfoColor}" Opacity="0.45" />
    <SolidColorBrush x:Key="DaisyButtonSuccessSoftBrush" Color="{DynamicResource DaisySuccessColor}" Opacity="0.15" />
    <SolidColorBrush x:Key="DaisyButtonSuccessSoftHoverBrush" Color="{DynamicResource DaisySuccessColor}" Opacity="0.3" />
    <SolidColorBrush x:Key="DaisyButtonSuccessSoftBorderBrush" Color="{DynamicResource DaisySuccessColor}" Opacity="0.45" />
    <SolidColorBrush x:Key="DaisyButtonWarningSoftBrush" Color="{DynamicResource DaisyWarningColor}" Opacity="0.15" />
    <SolidColorBrush x:Key="DaisyButtonWarningSoftHoverBrush" Color="{DynamicResource DaisyWarningColor}" Opacity="0.3" />
    <SolidColorBrush x:Key="DaisyButtonWarningSoftBorderBrush" Color="{DynamicResource DaisyWarningColor}" Opacity="0.45" />
    <SolidColorBrush x:Key="DaisyButtonErrorSoftBrush" Color="{DynamicResource DaisyErrorColor}" Opacity="0.15" />
    <SolidColorBrush x:Key="DaisyButtonErrorSoftHoverBrush" Color="{DynamicResource DaisyErrorColor}" Opacity="0.3" />
    <SolidColorBrush x:Key="DaisyButtonErrorSoftBorderBrush" Color="{DynamicResource DaisyErrorColor}" Opacity="0.45" />

    <!-- Match Fluent's normal tree foreground outside palettes with a selection override. -->
    <SolidColorBrush x:Key="DaisyTreeSelectedForegroundBrush" Color="{DynamicResource SystemBaseHighColor}" />

    <!-- Theme Dictionaries for Light/Dark mode switching -->
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Palettes/DaisyLight.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Themes/Palettes/DaisyDark.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
