<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Flowery.Controls;assembly=Flowery.NET">

    <Design.PreviewWith>
        <Border Padding="20" Width="420">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#FF1E3A8A" />
                    <GradientStop Offset="1" Color="#FF4F46E5" />
                </LinearGradientBrush>
            </Border.Background>
            <controls:DaisyGlassSegmented Foreground="White">
                <ListBoxItem Content="Day" />
                <ListBoxItem Content="Week" />
                <ListBoxItem Content="Month" />
            </controls:DaisyGlassSegmented>
        </Border>
    </Design.PreviewWith>

    <Styles.Resources>
        <ControlTheme x:Key="DaisyGlassSegmentedItemTheme" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <!-- Transparent, not null, so the whole segment takes the pointer. -->
                    <Border Name="PART_LayoutRoot"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Name="PART_ContentPresenter"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Opacity="0.65">
                            <ContentPresenter.Transitions>
                                <Transitions>
                                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                                </Transitions>
                            </ContentPresenter.Transitions>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter>

            <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Opacity" Value="0.85" />
            </Style>
            <Style Selector="^:selected /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Opacity" Value="1" />
            </Style>
            <Style Selector="^:disabled /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Opacity" Value="0.35" />
            </Style>
        </ControlTheme>

        <ControlTheme x:Key="{x:Type controls:DaisyGlassSegmented}" TargetType="controls:DaisyGlassSegmented">
            <Setter Property="EnableBackdropBlur" Value="True" />
            <Setter Property="BlurMode" Value="SkiaSharp" />
            <Setter Property="GlassBlur" Value="24" />
            <Setter Property="GlassTint" Value="{DynamicResource DaisyGlassTintColor}" />
            <Setter Property="GlassTintOpacity" Value="0.12" />
            <Setter Property="GlassReflectOpacity" Value="0.15" />
            <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9999" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="IndicatorBrush" Value="#38FFFFFF" />
            <Setter Property="IndicatorBorderBrush" Value="#26FFFFFF" />
            <Setter Property="ItemContainerTheme" Value="{StaticResource DaisyGlassSegmentedItemTheme}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel>
                        <!-- The glass comes first, so its backdrop holds only what lies behind the track.
                             The control binds its glass properties to it when the template is applied. -->
                        <controls:DaisyGlass x:Name="PART_Glass"
                                             Padding="0"
                                             IsHitTestVisible="False"
                                             CornerRadius="{TemplateBinding CornerRadius}" />
                        <Border x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}">
                            <Panel>
                                <!-- The control moves the pill over the selected item. -->
                                <Canvas x:Name="PART_IndicatorLayer" IsHitTestVisible="False">
                                    <Border x:Name="PART_Indicator"
                                            IsVisible="False"
                                            Background="{TemplateBinding IndicatorBrush}"
                                            BorderBrush="{TemplateBinding IndicatorBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="{TemplateBinding CornerRadius}"
                                            BoxShadow="0 2 10 0 #26000000">
                                        <Border.Transitions>
                                            <Transitions>
                                                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.5">
                                                    <TransformOperationsTransition.Easing>
                                                        <SpringEasing Mass="1" Stiffness="150" Damping="15" />
                                                    </TransformOperationsTransition.Easing>
                                                </TransformOperationsTransition>
                                            </Transitions>
                                        </Border.Transitions>
                                    </Border>
                                </Canvas>
                                <ItemsPresenter x:Name="PART_ItemsPresenter"
                                                ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </Panel>
                        </Border>
                    </Panel>
                </ControlTemplate>
            </Setter>
        </ControlTheme>
    </Styles.Resources>

    <!-- Item sizes; outside the ControlTheme, which cannot select descendants. -->
    <Style Selector="controls|DaisyGlassSegmented ListBoxItem">
        <Setter Property="CornerRadius" Value="9999" />
        <Setter Property="Padding" Value="18,7" />
        <Setter Property="FontSize" Value="{DynamicResource DaisySizeMediumFontSize}" />
    </Style>
    <Style Selector="controls|DaisyGlassSegmented[Size=ExtraSmall] ListBoxItem">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="FontSize" Value="{DynamicResource DaisySizeExtraSmallFontSize}" />
    </Style>
    <Style Selector="controls|DaisyGlassSegmented[Size=Small] ListBoxItem">
        <Setter Property="Padding" Value="14,5" />
        <Setter Property="FontSize" Value="{DynamicResource DaisySizeSmallFontSize}" />
    </Style>
    <Style Selector="controls|DaisyGlassSegmented[Size=Large] ListBoxItem">
        <Setter Property="Padding" Value="22,9" />
        <Setter Property="FontSize" Value="{DynamicResource DaisySizeLargeFontSize}" />
    </Style>
    <Style Selector="controls|DaisyGlassSegmented[Size=ExtraLarge] ListBoxItem">
        <Setter Property="Padding" Value="26,11" />
        <Setter Property="FontSize" Value="{DynamicResource DaisySizeExtraLargeFontSize}" />
    </Style>
</Styles>
