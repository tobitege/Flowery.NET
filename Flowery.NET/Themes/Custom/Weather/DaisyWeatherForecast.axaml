<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:weather="clr-namespace:Flowery.Controls.Custom.Weather;assembly=Flowery.NET"
                    xmlns:models="clr-namespace:Flowery.Controls.Custom.Weather.Models;assembly=Flowery.NET">

    <Design.PreviewWith>
        <Border Padding="20" Background="{DynamicResource DaisyBase200Brush}">
            <weather:DaisyWeatherForecast>
                <models:ForecastDay Date="2025-07-16" Condition="PartlyCloudy" HighTemperature="16" LowTemperature="8" />
                <models:ForecastDay Date="2025-07-17" Condition="Rain" HighTemperature="15" LowTemperature="9" />
                <models:ForecastDay Date="2025-07-18" Condition="Sunny" HighTemperature="15" LowTemperature="5" />
                <models:ForecastDay Date="2025-07-19" Condition="Sunny" HighTemperature="15" LowTemperature="6" />
                <models:ForecastDay Date="2025-07-20" Condition="PartlyCloudy" HighTemperature="15" LowTemperature="7" />
                <models:ForecastDay Date="2025-07-21" Condition="Cloudy" HighTemperature="15" LowTemperature="6" />
            </weather:DaisyWeatherForecast>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type weather:DaisyWeatherForecast}" TargetType="weather:DaisyWeatherForecast">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="8" />
            </ItemsPanelTemplate>
        </Setter>
        <Setter Property="ItemTemplate">
            <DataTemplate x:DataType="models:ForecastDay">
                <weather:DaisyWeatherForecastItem>
                    <StackPanel HorizontalAlignment="Center" Spacing="4">
                        <!-- Day Name -->
                        <TextBlock Text="{Binding DayName}"
                            FontSize="{DynamicResource DaisySizeMediumSecondaryFontSize}"
                            FontWeight="SemiBold"
                            HorizontalAlignment="Center"
                            Foreground="{DynamicResource DaisyBaseContentBrush}" />

                        <!-- Animated Weather Icon -->
                        <weather:DaisyWeatherIcon IconSize="28"
                                                  HorizontalAlignment="Center"
                                                  Foreground="{DynamicResource DaisyPrimaryBrush}"
                                                  Condition="{Binding Condition}" />

                        <!-- High/Low Temperature -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Name="HighTemperatureText"
                                FontSize="{DynamicResource DaisySizeMediumTertiaryFontSize}"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource DaisyBaseContentBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:0}°{1}">
                                        <Binding Path="HighTemperature" />
                                        <Binding Path="TemperatureUnit" RelativeSource="{RelativeSource AncestorType=weather:DaisyWeatherForecast}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <TextBlock Text="|"
                                FontSize="{DynamicResource DaisySizeMediumTertiaryFontSize}"
                                Opacity="0.4"
                                Foreground="{DynamicResource DaisyBaseContentBrush}" />
                            <TextBlock Name="LowTemperatureText"
                                FontSize="{DynamicResource DaisySizeMediumTertiaryFontSize}"
                                Opacity="0.6"
                                Foreground="{DynamicResource DaisyBaseContentBrush}">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="{}{0:0}°{1}">
                                        <Binding Path="LowTemperature" />
                                        <Binding Path="TemperatureUnit" RelativeSource="{RelativeSource AncestorType=weather:DaisyWeatherForecast}" />
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock Name="PrecipitationText"
                                   Text="{Binding ChanceOfPrecipitation, StringFormat={}{0:0}%}"
                                   IsVisible="{Binding $parent[weather:DaisyWeatherForecast].ShowPrecipitation}"
                                   FontSize="{DynamicResource DaisySizeMediumTertiaryFontSize}"
                                   Foreground="{DynamicResource DaisyBaseContentBrush}"
                                   HorizontalAlignment="Center" />
                    </StackPanel>
                </weather:DaisyWeatherForecastItem>
            </DataTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                    <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- One forecast day tile -->
    <ControlTheme x:Key="{x:Type weather:DaisyWeatherForecastItem}" TargetType="weather:DaisyWeatherForecastItem">
        <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinWidth" Value="60" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Surface" Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

</ResourceDictionary>
