<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Flowery.Controls;assembly=Flowery.NET">

    <Design.PreviewWith>
        <Border Padding="20" Height="360">
            <StackPanel Spacing="10" Width="220">
                <controls:DaisyCalendarDatePicker PlaceholderText="Select date" />
                <controls:DaisyCalendarDatePicker Variant="Primary" PlaceholderText="Primary" />
                <controls:DaisyCalendarDatePicker Variant="Ghost" PlaceholderText="Ghost" />
                <controls:DaisyCalendarDatePicker Variant="Filled" PlaceholderText="Filled" />
                <controls:DaisyCalendarDatePicker Size="Small" PlaceholderText="Small" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <!--
        DaisyCalendarDatePicker keeps the Fluent CalendarDatePicker template (the control theme below is
        based on it) and restyles it with the styles that follow. Styles take precedence over control
        themes, so the state styles replace the Fluent hover, pressed and focus colors.
    -->
    <Styles.Resources>
        <ControlTheme x:Key="{x:Type controls:DaisyCalendarDatePicker}"
                      TargetType="controls:DaisyCalendarDatePicker"
                      BasedOn="{StaticResource {x:Type CalendarDatePicker}}" />
    </Styles.Resources>

    <Style Selector="controls|DaisyCalendarDatePicker">
        <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentBrush}" />
        <Setter Property="PlaceholderForeground" Value="{DynamicResource DaisyBaseContentMutedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyNeutralBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource DaisySizeMediumCornerRadius}" />
        <Setter Property="FontSize" Value="{DynamicResource DaisySizeMediumFontSize}" />
        <Setter Property="MinHeight" Value="{DynamicResource DaisySizeMediumHeight}" />
        <Setter Property="Padding" Value="{DynamicResource DaisyInputMediumPadding}" />
    </Style>

    <!-- Calendar button: the Daisy calendar icon instead of the Fluent glyph -->
    <Style Selector="controls|DaisyCalendarDatePicker /template/ Button#PART_Button">
        <Setter Property="TextElement.Foreground" Value="{Binding $parent[controls:DaisyCalendarDatePicker].Foreground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent">
                    <PathIcon Name="PART_CalendarIcon"
                              Data="{StaticResource DaisyIconDateDisplay}"
                              Width="16"
                              Height="16"
                              Foreground="{TemplateBinding Foreground}"
                              Opacity="0.7"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker /template/ Button#PART_Button:pointerover /template/ PathIcon#PART_CalendarIcon">
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- The inner TextBox draws no hover or focus surface of its own; the outer border shows the state. -->
    <Style Selector="controls|DaisyCalendarDatePicker /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement, controls|DaisyCalendarDatePicker /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker /template/ TextBox#PART_TextBox:pointerover, controls|DaisyCalendarDatePicker /template/ TextBox#PART_TextBox:focus">
        <Setter Property="Foreground" Value="{Binding $parent[controls:DaisyCalendarDatePicker].Foreground}" />
    </Style>

    <!-- Hover and pressed keep the variant colors -->
    <Style Selector="controls|DaisyCalendarDatePicker:pointerover /template/ Border#Background, controls|DaisyCalendarDatePicker:pressed /template/ Border#Background">
        <Setter Property="Background" Value="{Binding $parent[controls:DaisyCalendarDatePicker].Background}" />
        <Setter Property="BorderBrush" Value="{Binding $parent[controls:DaisyCalendarDatePicker].BorderBrush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Bordered]:pointerover /template/ Border#Background, controls|DaisyCalendarDatePicker[Variant=Filled]:pointerover /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Filled]:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource DaisyBase300Brush}" />
    </Style>

    <!-- Disabled -->
    <Style Selector="controls|DaisyCalendarDatePicker:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker:disabled /template/ Border#Background">
        <Setter Property="Background" Value="{Binding $parent[controls:DaisyCalendarDatePicker].Background}" />
        <Setter Property="BorderBrush" Value="{Binding $parent[controls:DaisyCalendarDatePicker].BorderBrush}" />
    </Style>

    <!-- Focus: the border takes the variant's focus color, or BorderRingBrush when set -->
    <Style Selector="controls|DaisyCalendarDatePicker:focus-within /template/ Border#Background">
        <Setter Property="Background" Value="{Binding $parent[controls:DaisyCalendarDatePicker].Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="{Binding $parent[controls:DaisyCalendarDatePicker].BorderThickness}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Ghost]:focus-within /template/ Border#Background">
        <Setter Property="Background" Value="{DynamicResource DaisyBase200Brush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Primary]:focus-within /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyPrimaryFocusBrush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Secondary]:focus-within /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisySecondaryFocusBrush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Accent]:focus-within /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyAccentBrush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Info]:focus-within /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyInfoBrush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Success]:focus-within /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisySuccessBrush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Warning]:focus-within /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyWarningBrush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Error]:focus-within /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyErrorBrush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker:ring:focus-within /template/ Border#Background">
        <Setter Property="BorderBrush" Value="{Binding $parent[controls:DaisyCalendarDatePicker].BorderRingBrush}" />
    </Style>

    <!-- Variants -->
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Ghost]">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Filled]">
        <Setter Property="Background" Value="{DynamicResource DaisyBase200Brush}" />
        <Setter Property="BorderThickness" Value="0,0,0,2" />
        <Setter Property="CornerRadius" Value="8,8,0,0" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Primary]">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyPrimaryBrush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Secondary]">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisySecondaryBrush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Accent]">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyAccentBrush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Info]">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyInfoBrush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Success]">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisySuccessBrush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Warning]">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyWarningBrush}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Variant=Error]">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyErrorBrush}" />
    </Style>

    <!-- Sizes (Medium is the default above) -->
    <Style Selector="controls|DaisyCalendarDatePicker[Size=ExtraSmall]">
        <Setter Property="MinHeight" Value="{DynamicResource DaisySizeExtraSmallHeight}" />
        <Setter Property="Padding" Value="{DynamicResource DaisyInputExtraSmallPadding}" />
        <Setter Property="FontSize" Value="{DynamicResource DaisySizeExtraSmallFontSize}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Size=Small]">
        <Setter Property="MinHeight" Value="{DynamicResource DaisySizeSmallHeight}" />
        <Setter Property="Padding" Value="{DynamicResource DaisyInputSmallPadding}" />
        <Setter Property="FontSize" Value="{DynamicResource DaisySizeSmallFontSize}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Size=Large]">
        <Setter Property="MinHeight" Value="{DynamicResource DaisySizeLargeHeight}" />
        <Setter Property="Padding" Value="{DynamicResource DaisyInputLargePadding}" />
        <Setter Property="FontSize" Value="{DynamicResource DaisySizeLargeFontSize}" />
    </Style>
    <Style Selector="controls|DaisyCalendarDatePicker[Size=ExtraLarge]">
        <Setter Property="MinHeight" Value="{DynamicResource DaisySizeExtraLargeHeight}" />
        <Setter Property="Padding" Value="{DynamicResource DaisyInputExtraLargePadding}" />
        <Setter Property="FontSize" Value="{DynamicResource DaisySizeExtraLargeFontSize}" />
    </Style>

</Styles>
