<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Flowery.Controls;assembly=Flowery.NET">

    <Design.PreviewWith>
        <Border Padding="20" Width="420">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Offset="0" Color="#FF6B8DD6" />
                    <GradientStop Offset="1" Color="#FF8E37D7" />
                </LinearGradientBrush>
            </Border.Background>
            <WrapPanel>
                <controls:DaisyGlassBadge Content="Glass" Margin="4" />
                <controls:DaisyGlassBadge Variant="Primary" Content="Primary" Margin="4" />
                <controls:DaisyGlassBadge Variant="Accent" Content="Accent" Margin="4" />
            </WrapPanel>
        </Border>
    </Design.PreviewWith>

    <!-- Inherits variants, outline and sizes from DaisyBadge; only the surface differs. -->
    <ControlTheme x:Key="{x:Type controls:DaisyGlassBadge}" TargetType="controls:DaisyGlassBadge"
                  BasedOn="{StaticResource {x:Type controls:DaisyBadge}}">
        <Setter Property="EnableBackdropBlur" Value="True" />
        <Setter Property="BlurMode" Value="SkiaSharp" />
        <Setter Property="GlassBlur" Value="20" />
        <Setter Property="GlassTint" Value="White" />
        <Setter Property="GlassTintOpacity" Value="0.15" />
        <Setter Property="GlassReflectOpacity" Value="0.1" />

        <Setter Property="Template">
            <ControlTemplate>
                <Panel Height="{TemplateBinding Height}">
                    <!-- The glass comes first, so its backdrop holds only what lies behind the badge. -->
                    <controls:DaisyGlass x:Name="PART_Glass"
                                         Padding="0"
                                         IsHitTestVisible="False"
                                         CornerRadius="{TemplateBinding CornerRadius}" />
                    <Border x:Name="PART_Surface"
                            IsHitTestVisible="False"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="{TemplateBinding GlassColorOpacity}" />
                    <Border x:Name="PART_Border"
                            Background="Transparent"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <!-- EffectiveForeground is Foreground with enough contrast over the glass. -->
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          TextElement.Foreground="{TemplateBinding EffectiveForeground}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <ContentPresenter.Effect>
                                <DropShadowEffect OffsetX="0" OffsetY="1" BlurRadius="2" Color="Black"
                                                  Opacity="{Binding GlassTextShadowOpacity, RelativeSource={RelativeSource TemplatedParent}}" />
                            </ContentPresenter.Effect>
                        </ContentPresenter>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>

        <!-- The default variant is clear glass. -->
        <Style Selector="^[Variant=Default]">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </ControlTheme>
</ResourceDictionary>
