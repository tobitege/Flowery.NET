<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Flowery.Controls;assembly=Flowery.NET">

    <ControlTheme x:Key="{x:Type controls:DaisyPatternedCard}" TargetType="controls:DaisyPatternedCard"
                  BasedOn="{StaticResource {x:Type controls:DaisyCard}}">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <!-- Standard solid background -->
                    <Border x:Name="PART_SolidBackground"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            ClipToBounds="True"
                            TextElement.FontSize="{TemplateBinding BodyFontSize}">
                        <Panel>
                            <!-- Pattern Layer -->
                            <Canvas x:Name="PART_PatternLayer" IsHitTestVisible="False" ClipToBounds="True" />

                            <!-- Ornament Layer -->
                            <Canvas x:Name="PART_OrnamentLayer" IsHitTestVisible="False" ClipToBounds="True" />

                            <ContentPresenter x:Name="PART_SolidContent"
                                              Padding="{TemplateBinding BodyPadding}"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Panel>
                    </Border>

                    <!-- Glass effect background -->
                    <controls:DaisyGlass x:Name="PART_GlassPanel"
                                         IsVisible="{TemplateBinding IsGlass}" EnableBackdropBlur="{TemplateBinding IsGlass}"
                                         Padding="0" CornerRadius="{TemplateBinding CornerRadius}"
                                         Foreground="{TemplateBinding Foreground}"
                                         GlassBlur="{TemplateBinding GlassBlur}" GlassOpacity="{TemplateBinding GlassOpacity}"
                                         GlassTint="{TemplateBinding GlassTint}" GlassTintOpacity="{TemplateBinding GlassTintOpacity}"
                                         GlassBorderOpacity="{TemplateBinding GlassBorderOpacity}">
                        <!-- Content -->
                        <Border Padding="{TemplateBinding BodyPadding}"
                                TextElement.FontSize="{TemplateBinding BodyFontSize}">
                            <ContentPresenter x:Name="PART_GlassContent"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </controls:DaisyGlass>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>
</ResourceDictionary>
