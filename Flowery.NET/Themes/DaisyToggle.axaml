<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:Flowery.Controls;assembly=Flowery.NET"
                    xmlns:services="clr-namespace:Flowery.Services;assembly=Flowery.NET">

    <Design.PreviewWith>
        <Border Padding="20">
            <StackPanel Spacing="10">
                <controls:DaisyToggle Content="Toggle" />
                <controls:DaisyToggle Content="Primary" Variant="Primary" IsChecked="True" />
                <controls:DaisyToggle Content="Secondary" Variant="Secondary" IsChecked="True" />
            </StackPanel>
        </Border>
    </Design.PreviewWith>

    <ControlTheme x:Key="{x:Type controls:DaisyToggle}" TargetType="controls:DaisyToggle">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="controls:SelectionControlScale.BaseFontSize" Value="{DynamicResource DaisyToggleMediumFontSize}" />
        <Setter Property="FontSize">
            <MultiBinding Converter="{x:Static controls:SelectionControlScale.Instance}">
                <Binding Path="(controls:SelectionControlScale.BaseFontSize)" RelativeSource="{RelativeSource Self}" />
                <Binding Path="(services:FloweryScaleManager.ScaleFactor)" RelativeSource="{RelativeSource Self}" />
            </MultiBinding>
        </Setter>
        <Setter Property="MinHeight" Value="{DynamicResource DaisySizeMediumHeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="TogglePadding" Value="1" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBase300Brush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <Grid ColumnDefinitions="Auto, *">
                        <LayoutTransformControl Grid.Column="0" VerticalAlignment="Center"
                            LayoutTransform="{Binding (services:FloweryScaleManager.ScaleFactor), RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static controls:SelectionControlScale.Indicator}}">
                            <Border x:Name="SwitchArea"
                                    Width="{DynamicResource DaisyToggleMediumWidth}" Height="{DynamicResource DaisyToggleMediumHeight}"
                                    CornerRadius="12"
                                    Background="{DynamicResource DaisyBase300Brush}"
                                    BorderBrush="{DynamicResource DaisyBase300Brush}"
                                    BorderThickness="1">
                                <!-- Avalonia ToggleSwitch expects PART_MovingKnobs -->
                                <Canvas x:Name="PART_MovingKnobs">
                                    <!-- Follows the knob; carries its neumorphic shadow (an Ellipse has no BoxShadow). -->
                                    <Border x:Name="PART_KnobShadow"
                                            Width="{Binding #Knob.Width}"
                                            Height="{Binding #Knob.Height}"
                                            CornerRadius="9999"
                                            Canvas.Left="{Binding #Knob.(Canvas.Left)}"
                                            Canvas.Top="{Binding #Knob.(Canvas.Top)}" />
                                    <Ellipse x:Name="Knob"
                                        Width="{DynamicResource DaisyToggleKnobMediumSize}"
                                        Height="{DynamicResource DaisyToggleKnobMediumSize}"
                                        Fill="White"
                                        Canvas.Top="{TemplateBinding TogglePadding}">
                                        <Canvas.Left>
                                            <MultiBinding Converter="{x:Static controls:ToggleKnobOffsetConverter.Instance}">
                                                <Binding Path="IsChecked" RelativeSource="{RelativeSource TemplatedParent}" />
                                                <Binding Path="Bounds.Width" ElementName="PART_MovingKnobs" />
                                                <Binding Path="Width" RelativeSource="{RelativeSource Self}" />
                                                <Binding Path="TogglePadding" RelativeSource="{RelativeSource TemplatedParent}" />
                                            </MultiBinding>
                                        </Canvas.Left>
                                        <Ellipse.Transitions>
                                            <Transitions>
                                                <DoubleTransition Property="Canvas.Left" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                                            </Transitions>
                                        </Ellipse.Transitions>
                                    </Ellipse>
                                    <!-- Thin outline that keeps the knob visible on any track; a separate ellipse,
                                         because a stroke cannot take its own opacity. -->
                                    <Ellipse x:Name="PART_KnobOutline"
                                             IsHitTestVisible="False"
                                             Width="{Binding #Knob.Width}"
                                             Height="{Binding #Knob.Height}"
                                             Stroke="{DynamicResource DaisyBaseContentBrush}"
                                             StrokeThickness="1"
                                             Opacity="0.25"
                                             Canvas.Left="{Binding #Knob.(Canvas.Left)}"
                                             Canvas.Top="{Binding #Knob.(Canvas.Top)}" />
                                </Canvas>
                            </Border>
                        </LayoutTransformControl>
                        <ContentPresenter Grid.Column="1"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Margin="8,0,0,0"
                                          VerticalAlignment="Center"
                                          TextElement.FontSize="{TemplateBinding FontSize}"
                                          TextElement.FontFamily="{TemplateBinding FontFamily}"
                                          TextElement.FontStyle="{TemplateBinding FontStyle}"
                                          TextElement.FontWeight="{TemplateBinding FontWeight}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
        <!-- Checked State (track stays gray, only knob changes) -->
        <Style Selector="^:checked /template/ Ellipse#Knob">
            <Setter Property="Fill" Value="{DynamicResource DaisyBaseContentBrush}" />
        </Style>

        <!-- Variants (only affect knob color when checked) -->
        <Style Selector="^[Variant=Primary]:checked /template/ Ellipse#Knob">
            <Setter Property="Fill" Value="{DynamicResource DaisyPrimaryBrush}" />
        </Style>
        <Style Selector="^[Variant=Secondary]:checked /template/ Ellipse#Knob">
            <Setter Property="Fill" Value="{DynamicResource DaisySecondaryBrush}" />
        </Style>
        <Style Selector="^[Variant=Accent]:checked /template/ Ellipse#Knob">
            <Setter Property="Fill" Value="{DynamicResource DaisyAccentBrush}" />
        </Style>
        <Style Selector="^[Variant=Success]:checked /template/ Ellipse#Knob">
            <Setter Property="Fill" Value="{DynamicResource DaisySuccessBrush}" />
        </Style>
        <Style Selector="^[Variant=Warning]:checked /template/ Ellipse#Knob">
            <Setter Property="Fill" Value="{DynamicResource DaisyWarningBrush}" />
        </Style>
        <Style Selector="^[Variant=Info]:checked /template/ Ellipse#Knob">
            <Setter Property="Fill" Value="{DynamicResource DaisyInfoBrush}" />
        </Style>
        <Style Selector="^[Variant=Error]:checked /template/ Ellipse#Knob">
            <Setter Property="Fill" Value="{DynamicResource DaisyErrorBrush}" />
        </Style>

        <!-- The checked track border takes the variant color, like DaisyUI -->
        <Style Selector="^[Variant=Primary]:checked /template/ Border#SwitchArea">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisyPrimaryBrush}" />
        </Style>
        <Style Selector="^[Variant=Secondary]:checked /template/ Border#SwitchArea">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisySecondaryBrush}" />
        </Style>
        <Style Selector="^[Variant=Accent]:checked /template/ Border#SwitchArea">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisyAccentBrush}" />
        </Style>
        <Style Selector="^[Variant=Success]:checked /template/ Border#SwitchArea">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisySuccessBrush}" />
        </Style>
        <Style Selector="^[Variant=Warning]:checked /template/ Border#SwitchArea">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisyWarningBrush}" />
        </Style>
        <Style Selector="^[Variant=Info]:checked /template/ Border#SwitchArea">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisyInfoBrush}" />
        </Style>
        <Style Selector="^[Variant=Error]:checked /template/ Border#SwitchArea">
            <Setter Property="BorderBrush" Value="{DynamicResource DaisyErrorBrush}" />
        </Style>

        <!-- Sizes -->
        <Style Selector="^[Size=ExtraSmall]">
            <Setter Property="controls:SelectionControlScale.BaseFontSize" Value="{DynamicResource DaisyToggleExtraSmallFontSize}" />
            <Setter Property="MinHeight" Value="{DynamicResource DaisySizeExtraSmallHeight}" />
        </Style>
        <Style Selector="^[Size=Small]">
            <Setter Property="controls:SelectionControlScale.BaseFontSize" Value="{DynamicResource DaisyToggleSmallFontSize}" />
            <Setter Property="MinHeight" Value="{DynamicResource DaisySizeSmallHeight}" />
        </Style>
        <Style Selector="^[Size=Large]">
            <Setter Property="controls:SelectionControlScale.BaseFontSize" Value="{DynamicResource DaisyToggleLargeFontSize}" />
            <Setter Property="MinHeight" Value="{DynamicResource DaisySizeLargeHeight}" />
        </Style>
        <Style Selector="^[Size=ExtraLarge]">
            <Setter Property="controls:SelectionControlScale.BaseFontSize" Value="{DynamicResource DaisyToggleExtraLargeFontSize}" />
            <Setter Property="MinHeight" Value="{DynamicResource DaisySizeExtraLargeHeight}" />
        </Style>
        <Style Selector="^[Size=ExtraLarge] /template/ Border#SwitchArea">
            <Setter Property="Width" Value="{DynamicResource DaisyToggleExtraLargeWidth}" />
            <Setter Property="Height" Value="{DynamicResource DaisyToggleExtraLargeHeight}" />
        </Style>
        <Style Selector="^[Size=ExtraLarge] /template/ Ellipse#Knob">
            <Setter Property="Width" Value="{DynamicResource DaisyToggleKnobExtraLargeSize}" />
            <Setter Property="Height" Value="{DynamicResource DaisyToggleKnobExtraLargeSize}" />
        </Style>
        <Style Selector="^[Size=Large] /template/ Border#SwitchArea">
            <Setter Property="Width" Value="{DynamicResource DaisyToggleLargeWidth}" />
            <Setter Property="Height" Value="{DynamicResource DaisyToggleLargeHeight}" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style Selector="^[Size=Large] /template/ Ellipse#Knob">
            <Setter Property="Width" Value="{DynamicResource DaisyToggleKnobLargeSize}" />
            <Setter Property="Height" Value="{DynamicResource DaisyToggleKnobLargeSize}" />
        </Style>

        <Style Selector="^[Size=Small] /template/ Border#SwitchArea">
            <Setter Property="Width" Value="{DynamicResource DaisyToggleSmallWidth}" />
            <Setter Property="Height" Value="{DynamicResource DaisyToggleSmallHeight}" />
            <Setter Property="CornerRadius" Value="10" />
        </Style>
        <Style Selector="^[Size=Small] /template/ Ellipse#Knob">
            <Setter Property="Width" Value="{DynamicResource DaisyToggleKnobSmallSize}" />
            <Setter Property="Height" Value="{DynamicResource DaisyToggleKnobSmallSize}" />
        </Style>

        <Style Selector="^[Size=ExtraSmall] /template/ Border#SwitchArea">
            <Setter Property="Width" Value="{DynamicResource DaisyToggleExtraSmallWidth}" />
            <Setter Property="Height" Value="{DynamicResource DaisyToggleExtraSmallHeight}" />
             <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="^[Size=ExtraSmall] /template/ Ellipse#Knob">
            <Setter Property="Width" Value="{DynamicResource DaisyToggleKnobExtraSmallSize}" />
            <Setter Property="Height" Value="{DynamicResource DaisyToggleKnobExtraSmallSize}" />
        </Style>

    </ControlTheme>
</ResourceDictionary>
