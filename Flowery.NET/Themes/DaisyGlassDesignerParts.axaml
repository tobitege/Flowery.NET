<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Flowery.Controls;assembly=Flowery.NET">

    <Design.PreviewWith>
        <controls:DaisyGlassDesigner Width="980" />
    </Design.PreviewWith>

    <!-- DaisyGlassDesigner builds its parts in code; these styles give them their look. Each designer adds them to its
         own Styles, so they match only the controls inside it: as app styles, the class selectors would be matched
         against every Border, TextBlock and button of an app. The two borders of ShowOverlayAsync, which lie in the
         overlay layer, have control themes in DaisyGlassDesigner.axaml. With high contrast, the parts that have colors
         of their own take the colors of the contrast palette. The GlassDesigner* sizes are resources that the designer sets
         for its Size and scale factor. -->
    <Style Selector="controls|DaisyGlassDesigner">
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>

    <Style Selector="Border.gbd-root">
        <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBase300Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="0,0,0,12" />
    </Style>

    <!-- Text: muted texts take the muted brush instead of an opacity, which the contrast palette makes opaque. -->
    <Style Selector="TextBlock.gbd-title">
        <Setter Property="FontSize" Value="{DynamicResource GlassDesignerTitleFontSize}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.gbd-subtitle">
        <Setter Property="FontSize" Value="{DynamicResource GlassDesignerTextFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.gbd-label">
        <Setter Property="FontSize" Value="{DynamicResource GlassDesignerLabelFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.8" />
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentMutedBrush}" />
    </Style>
    <Style Selector="TextBlock.gbd-hint">
        <Setter Property="FontSize" Value="{DynamicResource GlassDesignerLabelFontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentMutedBrush}" />
    </Style>
    <!-- An error is an alert on the error surface: the text color of that surface has 4.5:1 on it in every palette, also in
         the dark code drawer and with the contrast palette. -->
    <Style Selector="Border.gbd-error">
        <Setter Property="Background" Value="{DynamicResource DaisyErrorBrush}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource DaisyErrorContentBrush}" />
        <Setter Property="TextElement.FontSize" Value="{DynamicResource GlassDesignerSmallFontSize}" />
    </Style>
    <Style Selector="TextBlock.gbd-value">
        <Setter Property="FontSize" Value="{DynamicResource GlassDesignerSmallFontSize}" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    </Style>
    <Style Selector="Border.gbd-pill">
        <Setter Property="Background" Value="{DynamicResource DaisyBase200Brush}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Field cards -->
    <Style Selector="Border.gbd-field">
        <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBase300Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <!-- Stage -->
    <Style Selector="Border.gbd-stage">
        <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style Selector="TextBlock.gbd-stage-word">
        <Setter Property="FontSize" Value="{DynamicResource GlassDesignerStageWordFontSize}" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="LetterSpacing" Value="4" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="TextBlock.gbd-stage-line">
        <Setter Property="FontSize" Value="{DynamicResource GlassDesignerStageLineFontSize}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <!-- The light Paper backdrop gets dark text and symbols. -->
    <Style Selector="Border.gbd-stage.paper TextBlock.gbd-stage-word">
        <Setter Property="Foreground" Value="#1E293B" />
    </Style>
    <Style Selector="Border.gbd-stage.paper TextBlock.gbd-stage-line">
        <Setter Property="Foreground" Value="#334155" />
    </Style>
    <Style Selector="Border.gbd-stage-bar">
        <Setter Property="Background" Value="#59000000" />
        <Setter Property="BorderBrush" Value="#40FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,6,12,6" />
    </Style>
    <Style Selector="Border.gbd-stage-bar controls|DaisyToggle">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.gbd-stage-bar[(controls|DaisyAccessibility.HighContrastEnabled)=True]">
        <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>
    <Style Selector="Border.gbd-stage-bar[(controls|DaisyAccessibility.HighContrastEnabled)=True] controls|DaisyToggle">
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>
    <Style Selector="RadioButton.gbd-swatch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Swatch" Width="{DynamicResource GlassDesignerSwatchSize}" Height="{DynamicResource GlassDesignerSwatchSize}"
                        CornerRadius="{DynamicResource GlassDesignerSwatchCornerRadius}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="#80FFFFFF" BorderThickness="2" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.gbd-swatch:checked /template/ Border#PART_Swatch">
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>
    <Style Selector="RadioButton.gbd-swatch[(controls|DaisyAccessibility.HighContrastEnabled)=True] /template/ Border#PART_Swatch">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>
    <Style Selector="RadioButton.gbd-swatch[(controls|DaisyAccessibility.HighContrastEnabled)=True]:checked /template/ Border#PART_Swatch">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyPrimaryBrush}" />
    </Style>

    <!-- Tabs: a segmented pill. An unchecked tab has muted text. -->
    <Style Selector="Border.gbd-tabs">
        <Setter Property="Background" Value="{DynamicResource DaisyBase200Brush}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="RadioButton.gbd-tab">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource GlassDesignerTextFontSize}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentMutedBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Pill" CornerRadius="999" Padding="16,7" Background="Transparent">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.gbd-tab:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>
    <Style Selector="RadioButton.gbd-tab:checked">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>
    <Style Selector="RadioButton.gbd-tab:checked /template/ Border#PART_Pill">
        <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        <Setter Property="BoxShadow" Value="0 1 3 0 #26000000" />
    </Style>

    <!-- Chips -->
    <Style Selector="RadioButton.gbd-chip">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource GlassDesignerSmallFontSize}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Chip" CornerRadius="999" Padding="12,5"
                        Background="Transparent"
                        BorderBrush="{DynamicResource DaisyBase300Brush}" BorderThickness="1">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.gbd-chip:pointerover /template/ Border#PART_Chip">
        <Setter Property="Background" Value="{DynamicResource DaisyBase200Brush}" />
    </Style>
    <Style Selector="RadioButton.gbd-chip:checked">
        <Setter Property="Foreground" Value="{DynamicResource DaisyPrimaryContentBrush}" />
    </Style>
    <Style Selector="RadioButton.gbd-chip:checked /template/ Border#PART_Chip">
        <Setter Property="Background" Value="{DynamicResource DaisyPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyPrimaryBrush}" />
    </Style>
    <Style Selector="RadioButton.gbd-chip:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Preset, gradient and pattern tiles -->
    <Style Selector="Button.gbd-tile">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Tile" CornerRadius="18" Padding="3" BorderThickness="2" BorderBrush="Transparent">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.gbd-tile:pointerover /template/ Border#PART_Tile">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyPrimaryBrush}" />
    </Style>
    <Style Selector="Border.gbd-tile-stage">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="TextBlock.gbd-tile-label">
        <Setter Property="FontSize" Value="{DynamicResource GlassDesignerLabelFontSize}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentMutedBrush}" />
    </Style>

    <!-- A gradient tile names its preset on a dark pill, which keeps white text readable on the light presets. -->
    <Style Selector="RadioButton.gbd-gradient">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Gradient" Width="{DynamicResource GlassDesignerGradientTileWidth}"
                        Height="{DynamicResource GlassDesignerGradientTileHeight}" CornerRadius="14"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent" BorderThickness="3">
                    <Border x:Name="PART_Name"
                            Margin="7,0,0,5" HorizontalAlignment="Left" VerticalAlignment="Bottom">
                        <TextBlock Text="{TemplateBinding Content}" FontSize="{DynamicResource GlassDesignerSmallFontSize}" FontWeight="SemiBold" />
                    </Border>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.gbd-gradient /template/ Border#PART_Name">
        <Setter Property="Background" Value="#99000000" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.gbd-gradient[(controls|DaisyAccessibility.HighContrastEnabled)=True] /template/ Border#PART_Name">
        <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>
    <Style Selector="RadioButton.gbd-gradient:pointerover /template/ Border#PART_Gradient">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBase300Brush}" />
    </Style>
    <Style Selector="RadioButton.gbd-gradient:checked /template/ Border#PART_Gradient">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>

    <Style Selector="RadioButton.gbd-pattern">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Pattern" CornerRadius="14" Padding="6"
                        Background="{DynamicResource DaisyBase200Brush}"
                        BorderBrush="Transparent" BorderThickness="2">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.gbd-pattern:pointerover /template/ Border#PART_Pattern">
        <Setter Property="Background" Value="{DynamicResource DaisyBase300Brush}" />
    </Style>
    <Style Selector="RadioButton.gbd-pattern:checked /template/ Border#PART_Pattern">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyPrimaryBrush}" />
    </Style>

    <!-- Color swatches and small round buttons -->
    <Style Selector="Button.gbd-color">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Color" Width="{DynamicResource GlassDesignerColorWidth}" Height="{DynamicResource GlassDesignerColorHeight}"
                        CornerRadius="10" Padding="3"
                        Background="{DynamicResource DaisyBase100Brush}"
                        BorderBrush="{DynamicResource DaisyBase300Brush}" BorderThickness="1">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.gbd-color:pointerover /template/ Border#PART_Color">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyPrimaryBrush}" />
    </Style>
    <Style Selector="Button.gbd-icon-button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource GlassDesignerIconFontSize}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Icon" Width="{DynamicResource GlassDesignerIconButtonSize}" Height="{DynamicResource GlassDesignerIconButtonSize}"
                        CornerRadius="{DynamicResource GlassDesignerIconButtonCornerRadius}"
                        Background="{DynamicResource DaisyBase200Brush}">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.gbd-icon-button:pointerover /template/ Border#PART_Icon">
        <Setter Property="Background" Value="{DynamicResource DaisyBase300Brush}" />
    </Style>

    <!-- Header and code toggles -->
    <Style Selector="ToggleButton.gbd-code-toggle">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource GlassDesignerSmallFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Toggle" CornerRadius="999" Padding="12,6"
                        Background="Transparent"
                        BorderBrush="{DynamicResource DaisyBase300Brush}" BorderThickness="1">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.gbd-code-toggle:pointerover /template/ Border#PART_Toggle">
        <Setter Property="Background" Value="{DynamicResource DaisyBase200Brush}" />
    </Style>
    <Style Selector="ToggleButton.gbd-code-toggle:checked">
        <Setter Property="Foreground" Value="{DynamicResource DaisyBase100Brush}" />
    </Style>
    <Style Selector="ToggleButton.gbd-code-toggle:checked /template/ Border#PART_Toggle">
        <Setter Property="Background" Value="{DynamicResource DaisyBaseContentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>

    <!-- Code drawer: a dark card in every theme. With high contrast it takes the base and the text of the contrast
         palette, and its controls look like those outside it. -->
    <Style Selector="Border.gbd-code">
        <Setter Property="Background" Value="#0B1020" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="SelectableTextBlock.gbd-code-text">
        <Setter Property="FontFamily" Value="Cascadia Code, Cascadia Mono, Consolas, Menlo, monospace" />
        <Setter Property="FontSize" Value="{DynamicResource GlassDesignerCodeFontSize}" />
        <Setter Property="LineHeight" Value="{DynamicResource GlassDesignerCodeLineHeight}" />
        <Setter Property="Foreground" Value="#E2E8F0" />
        <Setter Property="SelectionBrush" Value="#406366F1" />
    </Style>
    <Style Selector="Border.gbd-code ToggleButton.gbd-code-toggle">
        <Setter Property="Foreground" Value="#E2E8F0" />
    </Style>
    <Style Selector="Border.gbd-code ToggleButton.gbd-code-toggle /template/ Border#PART_Toggle">
        <Setter Property="BorderBrush" Value="#334155" />
    </Style>
    <Style Selector="Border.gbd-code ToggleButton.gbd-code-toggle:pointerover /template/ Border#PART_Toggle">
        <Setter Property="Background" Value="#1E293B" />
    </Style>
    <Style Selector="Border.gbd-code ToggleButton.gbd-code-toggle:checked">
        <Setter Property="Foreground" Value="#0B1020" />
    </Style>
    <Style Selector="Border.gbd-code ToggleButton.gbd-code-toggle:checked /template/ Border#PART_Toggle">
        <Setter Property="Background" Value="#E2E8F0" />
        <Setter Property="BorderBrush" Value="#E2E8F0" />
    </Style>
    <Style Selector="RadioButton.gbd-code-tab">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="{DynamicResource GlassDesignerSmallFontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_CodeTab" CornerRadius="999" Padding="12,5" Background="Transparent">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.gbd-code-tab:pointerover">
        <Setter Property="Foreground" Value="#E2E8F0" />
    </Style>
    <Style Selector="RadioButton.gbd-code-tab:checked">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="RadioButton.gbd-code-tab:checked /template/ Border#PART_CodeTab">
        <Setter Property="Background" Value="#1E293B" />
    </Style>

    <Style Selector="Border.gbd-code[(controls|DaisyAccessibility.HighContrastEnabled)=True]">
        <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBaseContentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.gbd-code[(controls|DaisyAccessibility.HighContrastEnabled)=True] SelectableTextBlock.gbd-code-text">
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>
    <Style Selector="Border.gbd-code[(controls|DaisyAccessibility.HighContrastEnabled)=True] ToggleButton.gbd-code-toggle">
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>
    <Style Selector="Border.gbd-code[(controls|DaisyAccessibility.HighContrastEnabled)=True] ToggleButton.gbd-code-toggle /template/ Border#PART_Toggle">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>
    <Style Selector="Border.gbd-code[(controls|DaisyAccessibility.HighContrastEnabled)=True] ToggleButton.gbd-code-toggle:checked">
        <Setter Property="Foreground" Value="{DynamicResource DaisyBase100Brush}" />
    </Style>
    <Style Selector="Border.gbd-code[(controls|DaisyAccessibility.HighContrastEnabled)=True] ToggleButton.gbd-code-toggle:checked /template/ Border#PART_Toggle">
        <Setter Property="Background" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>
    <Style Selector="Border.gbd-code[(controls|DaisyAccessibility.HighContrastEnabled)=True] RadioButton.gbd-code-tab">
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>
    <Style Selector="Border.gbd-code[(controls|DaisyAccessibility.HighContrastEnabled)=True] RadioButton.gbd-code-tab:checked">
        <Setter Property="Foreground" Value="{DynamicResource DaisyBase100Brush}" />
    </Style>
    <Style Selector="Border.gbd-code[(controls|DaisyAccessibility.HighContrastEnabled)=True] RadioButton.gbd-code-tab:checked /template/ Border#PART_CodeTab">
        <Setter Property="Background" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>

    <!-- In the overlay of ShowOverlayAsync, the card gives the designer its background. -->
    <Style Selector="Border.gbd-overlay-card controls|DaisyGlassDesigner Border.gbd-root">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
</Styles>
