<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Flowery.Controls;assembly=Flowery.NET">

    <Design.PreviewWith>
        <controls:DaisyGlassDesigner Width="980" />
    </Design.PreviewWith>

    <!-- DaisyGlassDesigner builds its parts in code; these styles give them their look.
         The selectors start at the designer, so nothing leaks into the app, except the two overlay classes
         (gbd-overlay, gbd-overlay-card) of ShowOverlayAsync, whose border lies in the overlay layer. -->
    <Style Selector="controls|DaisyGlassDesigner">
        <Setter Property="Foreground" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>

    <Style Selector="controls|DaisyGlassDesigner Border.gbd-root">
        <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBase300Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="0,0,0,12" />
    </Style>

    <!-- Text -->
    <Style Selector="controls|DaisyGlassDesigner TextBlock.gbd-title">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner TextBlock.gbd-subtitle">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Opacity" Value="0.65" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner TextBlock.gbd-label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="0.8" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner TextBlock.gbd-hint">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner TextBlock.gbd-error">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="#FCA5A5" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner TextBlock.gbd-value">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner Border.gbd-pill">
        <Setter Property="Background" Value="{DynamicResource DaisyBase200Brush}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,2" />
    </Style>

    <!-- Field cards -->
    <Style Selector="controls|DaisyGlassDesigner Border.gbd-field">
        <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBase300Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16,14" />
    </Style>

    <!-- Stage -->
    <Style Selector="controls|DaisyGlassDesigner Border.gbd-stage">
        <Setter Property="CornerRadius" Value="20" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner TextBlock.gbd-stage-word">
        <Setter Property="FontSize" Value="64" />
        <Setter Property="FontWeight" Value="Black" />
        <Setter Property="LetterSpacing" Value="4" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner TextBlock.gbd-stage-line">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Opacity" Value="0.8" />
    </Style>
    <!-- The light Paper backdrop gets dark text and symbols. -->
    <Style Selector="controls|DaisyGlassDesigner Border.gbd-stage.paper TextBlock.gbd-stage-word">
        <Setter Property="Foreground" Value="#1E293B" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner Border.gbd-stage.paper TextBlock.gbd-stage-line">
        <Setter Property="Foreground" Value="#334155" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner Border.gbd-stage-bar">
        <Setter Property="Background" Value="#59000000" />
        <Setter Property="BorderBrush" Value="#40FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="8,6,12,6" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner Border.gbd-stage-bar controls|DaisyToggle">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-swatch">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Swatch" Width="22" Height="22" CornerRadius="11"
                        Background="{TemplateBinding Background}"
                        BorderBrush="#80FFFFFF" BorderThickness="2" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-swatch:checked /template/ Border#PART_Swatch">
        <Setter Property="BorderBrush" Value="White" />
        <Setter Property="BorderThickness" Value="3" />
    </Style>

    <!-- Tabs: a segmented pill -->
    <Style Selector="controls|DaisyGlassDesigner Border.gbd-tabs">
        <Setter Property="Background" Value="{DynamicResource DaisyBase200Brush}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-tab">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Pill" CornerRadius="999" Padding="16,7" Background="Transparent" Opacity="0.7">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-tab:pointerover /template/ Border#PART_Pill">
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-tab:checked">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-tab:checked /template/ Border#PART_Pill">
        <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        <Setter Property="BoxShadow" Value="0 1 3 0 #26000000" />
        <Setter Property="Opacity" Value="1" />
    </Style>

    <!-- Chips -->
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-chip">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Chip" CornerRadius="999" Padding="12,5"
                        Background="Transparent"
                        BorderBrush="{DynamicResource DaisyBase300Brush}" BorderThickness="1">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-chip:pointerover /template/ Border#PART_Chip">
        <Setter Property="Background" Value="{DynamicResource DaisyBase200Brush}" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-chip:checked">
        <Setter Property="Foreground" Value="{DynamicResource DaisyPrimaryContentBrush}" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-chip:checked /template/ Border#PART_Chip">
        <Setter Property="Background" Value="{DynamicResource DaisyPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyPrimaryBrush}" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-chip:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Preset, gradient and pattern tiles -->
    <Style Selector="controls|DaisyGlassDesigner Button.gbd-tile">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Tile" CornerRadius="18" Padding="3" BorderThickness="2" BorderBrush="Transparent">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|DaisyGlassDesigner Button.gbd-tile:pointerover /template/ Border#PART_Tile">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyPrimaryBrush}" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner Border.gbd-tile-stage">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner TextBlock.gbd-tile-label">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-gradient">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Gradient" Width="120" Height="56" CornerRadius="14"
                        Background="{TemplateBinding Background}"
                        BorderBrush="Transparent" BorderThickness="3">
                    <TextBlock Text="{TemplateBinding Content}" Foreground="White" FontSize="12" FontWeight="SemiBold"
                               Margin="10,0,0,6" VerticalAlignment="Bottom" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-gradient:pointerover /template/ Border#PART_Gradient">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBase300Brush}" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-gradient:checked /template/ Border#PART_Gradient">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>

    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-pattern">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Pattern" CornerRadius="14" Padding="6"
                        Background="{DynamicResource DaisyBase200Brush}"
                        BorderBrush="Transparent" BorderThickness="2">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-pattern:pointerover /template/ Border#PART_Pattern">
        <Setter Property="Background" Value="{DynamicResource DaisyBase300Brush}" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-pattern:checked /template/ Border#PART_Pattern">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyPrimaryBrush}" />
    </Style>

    <!-- Color swatches and small round buttons -->
    <Style Selector="controls|DaisyGlassDesigner Button.gbd-color">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Color" Width="48" Height="30" CornerRadius="10" Padding="3"
                        Background="{DynamicResource DaisyBase100Brush}"
                        BorderBrush="{DynamicResource DaisyBase300Brush}" BorderThickness="1">
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|DaisyGlassDesigner Button.gbd-color:pointerover /template/ Border#PART_Color">
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyPrimaryBrush}" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner Button.gbd-icon-button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Icon" Width="28" Height="28" CornerRadius="14"
                        Background="{DynamicResource DaisyBase200Brush}">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|DaisyGlassDesigner Button.gbd-icon-button:pointerover /template/ Border#PART_Icon">
        <Setter Property="Background" Value="{DynamicResource DaisyBase300Brush}" />
    </Style>

    <!-- Header and code toggles -->
    <Style Selector="controls|DaisyGlassDesigner ToggleButton.gbd-code-toggle">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Toggle" CornerRadius="999" Padding="12,6"
                        Background="Transparent"
                        BorderBrush="{DynamicResource DaisyBase300Brush}" BorderThickness="1">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|DaisyGlassDesigner ToggleButton.gbd-code-toggle:pointerover /template/ Border#PART_Toggle">
        <Setter Property="Background" Value="{DynamicResource DaisyBase200Brush}" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner ToggleButton.gbd-code-toggle:checked">
        <Setter Property="Foreground" Value="{DynamicResource DaisyBase100Brush}" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner ToggleButton.gbd-code-toggle:checked /template/ Border#PART_Toggle">
        <Setter Property="Background" Value="{DynamicResource DaisyBaseContentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DaisyBaseContentBrush}" />
    </Style>

    <!-- Code drawer: a dark card in every theme -->
    <Style Selector="controls|DaisyGlassDesigner Border.gbd-code">
        <Setter Property="Background" Value="#0B1020" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner SelectableTextBlock.gbd-code-text">
        <Setter Property="FontFamily" Value="Cascadia Code, Cascadia Mono, Consolas, Menlo, monospace" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="#E2E8F0" />
        <Setter Property="SelectionBrush" Value="#406366F1" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner Border.gbd-code ToggleButton.gbd-code-toggle">
        <Setter Property="Foreground" Value="#E2E8F0" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner Border.gbd-code ToggleButton.gbd-code-toggle /template/ Border#PART_Toggle">
        <Setter Property="BorderBrush" Value="#334155" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner Border.gbd-code ToggleButton.gbd-code-toggle:pointerover /template/ Border#PART_Toggle">
        <Setter Property="Background" Value="#1E293B" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner Border.gbd-code ToggleButton.gbd-code-toggle:checked">
        <Setter Property="Foreground" Value="#0B1020" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner Border.gbd-code ToggleButton.gbd-code-toggle:checked /template/ Border#PART_Toggle">
        <Setter Property="Background" Value="#E2E8F0" />
        <Setter Property="BorderBrush" Value="#E2E8F0" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-code-tab">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="#94A3B8" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_CodeTab" CornerRadius="999" Padding="12,5" Background="Transparent">
                    <ContentPresenter Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-code-tab:pointerover">
        <Setter Property="Foreground" Value="#E2E8F0" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-code-tab:checked">
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="controls|DaisyGlassDesigner RadioButton.gbd-code-tab:checked /template/ Border#PART_CodeTab">
        <Setter Property="Background" Value="#1E293B" />
    </Style>

    <!-- Overlay opened by ShowOverlayAsync -->
    <Style Selector="Border.gbd-overlay">
        <Setter Property="Background" Value="#99000000" />
    </Style>
    <Style Selector="Border.gbd-overlay-card">
        <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="BoxShadow" Value="0 24 64 0 #66000000" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style Selector="Border.gbd-overlay-card controls|DaisyGlassDesigner Border.gbd-root">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
</Styles>
