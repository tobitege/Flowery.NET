<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Flowery.Controls;assembly=Flowery.NET">

    <!-- The parts of DaisyGlassDesigner take their look from DaisyGlassDesignerParts.axaml, which each designer adds to its
         own Styles. Only the two borders of ShowOverlayAsync lie outside the designer, in the overlay layer: themes of
         their own attach only to them, as app styles the class selectors would attach to every Border of the app.
         Styles for the classes in the app still override them. With high contrast the dimming becomes the solid base of
         the contrast palette and the card gets an outline. -->
    <Styles.Resources>
        <ControlTheme x:Key="DaisyGlassDesignerOverlayTheme" TargetType="Border">
            <Setter Property="Background" Value="#99000000" />
            <Style Selector="^[(controls|DaisyAccessibility.HighContrastEnabled)=True]">
                <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
            </Style>
        </ControlTheme>
        <ControlTheme x:Key="DaisyGlassDesignerOverlayCardTheme" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource DaisyBase100Brush}" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="BoxShadow" Value="0 24 64 0 #66000000" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Style Selector="^[(controls|DaisyAccessibility.HighContrastEnabled)=True]">
                <Setter Property="BorderBrush" Value="{DynamicResource DaisyBaseContentBrush}" />
                <Setter Property="BorderThickness" Value="2" />
            </Style>
        </ControlTheme>
    </Styles.Resources>
</Styles>
