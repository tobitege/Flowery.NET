<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>

    <!-- NuGet Package Properties -->
    <PackageId>Flowery.NET</PackageId>
    <Authors>tobitege</Authors>
    <Description>DaisyUI theme components for Avalonia UI</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tobitege/Flowery.NET</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tobitege/Flowery.NET</RepositoryUrl>
    <PackageTags>avalonia;daisyui;theme;ui;xaml</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Update="ThirdPartyNotices\Xtreme.Components.txt" Pack="true" PackagePath="licenses\" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed JSON localization files for WASM compatibility -->
    <EmbeddedResource Include="Localization\en.json" />
    <EmbeddedResource Include="Localization\de.json" />
    <EmbeddedResource Include="Localization\fr.json" />
    <EmbeddedResource Include="Localization\es.json" />
    <EmbeddedResource Include="Localization\it.json" />
    <EmbeddedResource Include="Localization\ja.json" />
    <EmbeddedResource Include="Localization\ko.json" />
    <EmbeddedResource Include="Localization\zh-CN.json" />
    <EmbeddedResource Include="Localization\ar.json" />
    <EmbeddedResource Include="Localization\tr.json" />
    <EmbeddedResource Include="Localization\uk.json" />
    <EmbeddedResource Include="Localization\he.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.5" />
  </ItemGroup>

  <!-- The SVG pattern assets of DaisyPatternedCard (PatternMode="SvgAsset", the default), drawn with Svg.Skia. A build
       with -p:FlowerySvgPatterns=false leaves out the package and the assets; the cards then draw generated tiles.
       Svg.Skia 5.2 needs SkiaSharp 4, Avalonia 12.1 ships SkiaSharp 3.119, so the package stays on 5.1. -->
  <PropertyGroup>
    <FlowerySvgPatterns Condition="'$(FlowerySvgPatterns)' == ''">true</FlowerySvgPatterns>
    <DefineConstants Condition="'$(FlowerySvgPatterns)' == 'true'">$(DefineConstants);FLOWERY_SVG_PATTERNS</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(FlowerySvgPatterns)' == 'true'">
    <PackageReference Include="Svg.Skia" Version="5.1.1" />
    <AvaloniaResource Include="Assets\Patterns\*.svg" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Flowery.NET.Tests" />
    <InternalsVisibleTo Include="Flowery.NET.RuntimeTests" />
  </ItemGroup>

</Project>
